new file mode 100644
index 0000000..3ce1125
--- /dev/null
+++ b/apps/texturecraft-cli/src/dobe_main.rs
@@ -0,0 +1,17 @@
+//! Private headless entry. The durable Dobe runtime owns customer MCP access.
+#![forbid(unsafe_code)]
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+#[path = "main.rs"]
+mod cli;
+
+fn main() {
+    // Refuse before argument parsing, token lookup or any connection attempt.
+    // The embedded engine never attaches to an editor or starts a TCP server.
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.first().is_some_and(|arg| arg == "serve") || args.iter().any(|arg| matches!(arg.split('=').next(), Some("--bridge" | "--port" | "--token"))) {
+        eprintln!("dobe-texture: editor connections and network serving are disabled");
+        std::process::exit(2);
+    }
+    cli::main();
+}
