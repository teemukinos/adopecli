+#[test]
+fn static_text_diagnostics_refuse_character_substitution_and_source_keys() {
+    let (mut s, layer) = session();
+    s.execute("layer.addTextAnimator", json!({"layer":layer,"property":"characterOffset"})).unwrap();
+    assert!(s.execute("text.diagnostics", json!({"layer":layer})).is_err());
+    let (mut s, layer) = session();
+    s.execute("prop.toggleAnimation", json!({"layer":layer,"path":"text/sourceText","value":true})).unwrap();
+    assert!(s.execute("text.diagnostics", json!({"layer":layer})).is_err());
+    let (mut s, layer) = session();
+    let cid = s.active_comp_id().unwrap();
+    let value = &mut std::sync::Arc::make_mut(&mut s.project).comp_mut(cid).unwrap().layers[0].props.prop_mut("text/sourceText").unwrap().value;
+    if let KV::Text(doc) = value {
+        doc.faux_bold = true;
+    }
+    assert!(s.execute("text.diagnostics", json!({"layer":layer})).is_err());
