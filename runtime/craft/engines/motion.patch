+/// Inspect the same static TextDoc layout consumed by the renderer. Transform
+/// animation does not change shaping; source-text keys and character animators do.
+fn text_diagnostics(s: &mut Session, p: &Value) -> Result<Value> {
+    const COMMAND: &str = "text.diagnostics";
+    let cid = comp_id(s, p)?;
+    let lid = target(s, p, COMMAND)?;
+    let layer = s.project.comp(cid).and_then(|c| c.layer(lid)).ok_or_else(|| bad(COMMAND, "missing text layer"))?;
+    let text = layer.props.sub("text").ok_or_else(|| bad(COMMAND, "missing text properties"))?;
+    let property = layer.props.prop("text/sourceText").ok_or_else(|| bad(COMMAND, "missing source text"))?;
+    if !property.keys.is_empty() || property.expr.is_some() || text.sub("animators").is_some_and(|group| !group.children.is_empty()) {
+        return Err(bad(COMMAND, "diagnostics require static source text without character animators"));
+    }
+    let KV::Text(doc) = &property.value else { return Err(bad(COMMAND, "source property is not text")) };
+    let characters = doc.text.chars().count();
+    if !(1..=4000).contains(&characters)
+        || !doc.size.is_finite()
+        || !(1.0..=512.0).contains(&doc.size)
+        || !doc.runs.is_empty()
+        || !doc.paragraphs.is_empty()
+        || doc.box_size.is_some()
+        || doc.vertical
+        || doc.faux_bold
+        || doc.faux_italic
+        || doc.all_caps
+        || doc.small_caps
+        || !doc.variations.is_empty()
+    {
+        return Err(bad(COMMAND, "diagnostics require bounded plain horizontal point text without synthetic styling"));
+    }
+    let resolved = effectcraft_text::fonts::resolve(&doc.font, &doc.style);
+    let layout = effectcraft_text::layout_doc(doc);
+    if layout.layout.glyphs.len() > 16000 {
+        return Err(bad(COMMAND, "shaped glyph count exceeds the diagnostic bound"));
+    }
+    let mut missing = 0usize;
+    let mut other_faces = 0usize;
+    let glyphs: Vec<Value> = layout
+        .layout
+        .glyphs
+        .iter()
+        .map(|glyph| {
+            let face = effectcraft_text::fonts::face(glyph.face);
+            let bundled = face.info.index == 0
+                && matches!(&face.info.data,
+            effectcraft_text::fonts::FaceData::Static(bytes) if *bytes == effectcraft_text::fonts::INTER_REGULAR);
+            if glyph.id == 0 {
+                missing += 1;
+            }
+            if !bundled {
+                other_faces += 1;
+            }
+            json!({"id":glyph.id, "cluster":glyph.cluster, "family":face.info.family,
+            "style":face.info.style, "bundled_inter_regular":bundled,
+            "synthetic_bold":glyph.synth_bold, "synthetic_italic":glyph.synth_italic,
+            "variable_instance":glyph.variations != 0})
+        })
+        .collect();
+    Ok(json!({"schema_version":1, "profile":"static-point-text", "layer":lid.0,
+        "text":doc.text, "requested_family":doc.font, "requested_style":doc.style,
+        "family_missing":resolved.missing, "synthetic_bold":resolved.synth_bold,
+        "synthetic_italic":resolved.synth_italic, "characters":characters,
+        "glyph_count":glyphs.len(), "missing_glyph_count":missing,
+        "non_bundled_glyph_count":other_faces, "glyphs":glyphs}))
 }
 
