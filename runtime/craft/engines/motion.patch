+#[test]
+fn static_text_diagnostics_use_render_layout_and_detect_missing_glyphs() {
+    let (mut s, layer) = session();
+    s.execute("layer.setText", json!({"layer":layer,"text":"Office Åä e\u{301}","font":"Inter","style":"Regular"})).unwrap();
+    let before = serde_json::to_value(&s.project).unwrap();
+    let report = s.execute("text.diagnostics", json!({"layer":layer})).unwrap();
+    assert_eq!(report["missing_glyph_count"], 0);
+    assert_eq!(report["non_bundled_glyph_count"], 0);
+    assert_eq!(report["family_missing"], false);
+    assert!(report["glyph_count"].as_u64().unwrap() > 0);
+    assert_eq!(serde_json::to_value(&s.project).unwrap(), before);
+    s.execute("layer.setText", json!({"layer":layer,"text":"A\u{10ffff}B"})).unwrap();
+    let missing = s.execute("text.diagnostics", json!({"layer":layer})).unwrap();
+    assert!(missing["missing_glyph_count"].as_u64().unwrap() > 0 || missing["non_bundled_glyph_count"].as_u64().unwrap() > 0);
 }
