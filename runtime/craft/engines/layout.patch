diff --git a/apps/designcraft-cli/tests/it/dobe.rs b/apps/designcraft-cli/tests/it/dobe.rs
new file mode 100644
index 0000000..4ec692b
--- /dev/null
+++ b/apps/designcraft-cli/tests/it/dobe.rs
@@ -0,0 +1,27 @@
+//! Product identity and editor isolation of the maintained headless binary.
+use std::process::Command;
+
+#[test]
+fn identity_and_headless_help() {
+    for args in [vec!["--version"], vec!["--help"], vec!["script", "--help"], vec!["mcp", "--help"]] {
+        let output = Command::new(env!("CARGO_BIN_EXE_dobe-layout")).args(&args).output().unwrap();
+        assert!(output.status.success(), "{args:?}");
+        let text = String::from_utf8(output.stdout).unwrap();
+        assert!(text.contains("dobe-layout"), "{text}");
+        assert!(!text.contains("--connect") && !text.contains("designcraft-cli") && !text.contains("--control"), "{text}");
+    }
+}
+
+#[test]
+fn editor_modes_are_refused_even_before_help_or_missing_script() {
+    for args in [
+        vec!["app", "--help"],
+        vec!["mcp", "--connect", "7979"],
+        vec!["mcp", "--connect=7979", "--help"],
+        vec!["script", "/no/such/script", "--connect", "7979"],
+    ] {
+        let output = Command::new(env!("CARGO_BIN_EXE_dobe-layout")).args(&args).output().unwrap();
+        assert!(!output.status.success(), "{args:?}");
+        assert!(String::from_utf8(output.stderr).unwrap().contains("editor connections are unavailable"));
+    }
+}
