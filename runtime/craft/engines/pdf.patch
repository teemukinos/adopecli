+//! Replacement of named text must rewrite its native item, including editable metadata.
+//! Generic paragraph rewrites create new streams and leave that metadata stale.
+
+use std::collections::BTreeMap;
+use std::ops::Range;
+
+use super::{Replace, Replacement, Skip, find, refused};
+use crate::{Edit, EditError, guard};
+use pdfcraft_edit::{Added, Content, TextBlock};
+
+pub(super) struct OwnedPage {
+    items: Vec<Added>,
+    /// Every named item touched by each paragraph. Mixed ownership is refused, not guessed.
+    owners: Vec<Vec<usize>>,
+    valid: Vec<bool>,
+    pub matches: Vec<Vec<Range<usize>>>,
+}
+
+impl OwnedPage {
+    pub fn read(doc: &pdfcraft_cos::Document, page: usize, blocks: &[TextBlock], query: &Replace) -> Result<Self, EditError> {
+        let items: Vec<_> = pdfcraft_edit::list_added(doc).into_iter().filter(|item| item.page == page).collect();
+        if items.is_empty() {
+            return Ok(Self { items, owners: vec![Vec::new(); blocks.len()], valid: Vec::new(), matches: Vec::new() });
+        }
+        let ownership = pdfcraft_edit::text_ownership(doc, page)?;
+        let sources = ownership.blocks;
+        if sources.len() != blocks.len() {
+            return Err(EditError::Invalid("the page's paragraphs changed while reading their ownership".into()));
+        }
+        let owners: Vec<Vec<usize>> = sources
+            .iter()
+            .map(|refs| items.iter().enumerate().filter_map(|(index, item)| refs.contains(&Some(item.obj)).then_some(index)).collect())
+            .collect();
+        let valid = items
+            .iter()
+            .map(|item| {
+                let Content::Text(text) = &item.content else { return false };
+                // A paragraph can contain several named text items. Match each item's
+                // metadata against only the visible text drawn by its own stream.
+                ownership.text.get(&item.obj).is_some_and(|visible| equivalent(&text.text, visible))
+            })
+            .collect();
+        let matches = items
+            .iter()
+            .map(|item| match &item.content {
+                Content::Text(text) => find(&text.text, query, usize::MAX),
+                Content::Image(_) => Vec::new(),
+            })
+            .collect();
+        Ok(Self { items, owners, valid, matches })
+    }
+
+    pub fn ordinary(&self, block: usize) -> bool {
+        self.owners.get(block).is_some_and(Vec::is_empty)
+    }
+
+    pub fn same_item(&self, first: usize, last: usize) -> bool {
+        matches!((self.owners.get(first), self.owners.get(last)), (Some(a), Some(b)) if a.len() == 1 && a == b)
+    }
+
+    /// Map a highlighted rendered match to the corresponding native text range. The full
+    /// item must agree first, and all per-paragraph matches must have the same ordered count.
+    /// A match crossing paragraphs cannot be guessed from one paragraph's highlight.
+    pub fn highlighted(&self, block: usize, range: &Range<usize>, matches: &[Vec<Range<usize>>]) -> Option<(usize, Range<usize>)> {
+        let [owner] = self.owners.get(block)?.as_slice() else { return None };
+        if !self.valid.get(*owner).copied().unwrap_or(false) {
+            return None;
+        }
+        let mut ordinal = None;
+        let mut count = 0usize;
+        for (k, owners) in self.owners.iter().enumerate() {
+            if owners.as_slice() != [*owner] {
+                continue;
+            }
+            let held = matches.get(k)?;
+            if k == block {
+                ordinal = held.iter().position(|r| r == range).and_then(|i| count.checked_add(i));
+            }
+            count = count.checked_add(held.len())?;
+        }
+        let raw = self.matches.get(*owner)?;
+        if raw.len() != count {
+            return None;
+        }
+        Some((*owner, raw.get(ordinal?)?.clone()))
+    }
+
+    pub fn apply(
+        &self,
+        work: &mut pdfcraft_cos::Document,
+        page: usize,
+        chosen: BTreeMap<usize, Vec<Range<usize>>>,
+        query: &Replace,
+        edits: &mut Vec<Edit>,
+        out: &mut Replacement,
+    ) {
+        for (index, ranges) in chosen {
+            let count = ranges.len();
+            let Some(item) = self.items.get(index) else { continue };
+            if !self.valid.get(index).copied().unwrap_or(false) {
+                refused(out, count, page, "named text ownership or its visible wording does not agree with its editable data".into());
+                continue;
+            }
+            // An earlier generic edit must not have detached or changed this named item.
+            let current = pdfcraft_edit::list_added(work).into_iter().filter(|a| a.page == page).nth(index);
+            if current.as_ref() != Some(item) {
+                refused(out, count, page, "an earlier replacement changed the named text item".into());
+                continue;
+            }
+            let Content::Text(old) = &item.content else { continue };
+            let mut updated = old.clone();
+            let mut text = old.text.clone();
+            let mut end = text.len();
+            let mut valid = true;
+            for range in ranges.iter().rev() {
+                if range.end > end || text.get(range.clone()).is_none() {
+                    valid = false;
+                    break;
+                }
+                text.replace_range(range.clone(), &query.with);
+                end = range.start;
+            }
+            if !valid {
+                refused(out, count, page, "named text replacement ranges overlap or are invalid".into());
+                continue;
+            }
+            if text == old.text {
+                out.replaced = out.replaced.saturating_add(count);
+                continue;
+            }
+            updated.aligns = pdfcraft_edit::paragraph_align::remap(&old.text, &text, &old.aligns);
+            updated.text = text;
+            if pdfcraft_edit::first_undrawable(&updated).is_some() {
+                out.skip(Skip::MissingGlyphs, count);
+                continue;
+            }
+            let content = Content::Text(updated);
+            let mut trial = work.clone();
+            match guard(|| pdfcraft_edit::update_content(&mut trial, page, index, &content)) {
+                Ok(Ok(())) => {
+                    *work = trial;
+                    edits.push(Edit::UpdateContent { page, index, content });
+                    out.replaced = out.replaced.saturating_add(count);
+                    if !out.pages.contains(&page) {
+                        out.pages.push(page);
+                    }
+                }
+                Ok(Err(error)) => refused(out, count, page, error.to_string()),
+                Err(panic) => refused(out, count, page, panic),
+            }
+        }
+    }
+}
+
+fn equivalent(stored: &str, visible: &str) -> bool {
+    let covers = |text: &str, needle: &str| {
+        let text = text.trim();
+        let matches = pdfcraft_render::text::find_in_text(text, needle, true, false, 2);
+        matches.len() == 1 && matches.first().is_some_and(|range| range.start == 0 && range.end == text.len())
+    };
+    !stored.trim().is_empty() && covers(stored, visible) && covers(visible, stored)
+}
