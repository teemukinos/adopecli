+            attach(doc, root, Object::Dict(dict));
+        });
+        assert!(inspect_bytes(bytes).is_ok());
+    }
+
+    #[test]
+    fn missing_references_and_alias_cycles_are_refused() {
+        let missing = fixture(false, |doc, root| {
+            doc.update_dict(root, |d| d.set(b"DobeFixture".to_vec(), ObjRef::new(999_999, 0))).unwrap();
+        });
+        assert!(inspect_bytes(missing).is_err());
+        let cycle = fixture(false, |doc, root| {
+            let first = doc.add(Object::Null);
+            let second = doc.add(Object::Ref(first));
+            doc.set(first, Object::Ref(second));
+            doc.update_dict(root, |d| d.set(b"DobeFixture".to_vec(), first)).unwrap();
+        });
+        assert!(inspect_bytes(cycle).is_err());
+    }
+
+    #[test]
+    fn structural_and_page_limits_are_enforced() {
+        let many = pdfcraft_engine::Session::new().create_blank(200.0, 300.0, 257).unwrap();
+        assert!(inspect_bytes((*many).clone()).is_err());
+        let large = pdfcraft_engine::Session::new().create_blank(8193.0, 300.0, 1).unwrap();
+        assert!(inspect_bytes((*large).clone()).is_err());
+        let array = fixture(false, |doc, root| attach(doc, root, Object::Array(vec![Object::Null; 16_385])));
+        assert!(inspect_bytes(array).is_err());
+        let depth = fixture(false, |doc, root| {
+            let mut object = Object::Null;
+            for _ in 0..70 {
+                object = Object::Array(vec![object]);
+            }
+            attach(doc, root, object);
+        });
+        assert!(inspect_bytes(depth).is_err());
+        let image = fixture(false, |doc, root| {
+            let mut dict = Dict::new();
+            dict.set(b"Subtype".to_vec(), Object::name("Image"));
+            dict.set(b"Width".to_vec(), 32768_i64);
+            dict.set(b"Height".to_vec(), 32768_i64);
+            attach(doc, root, Object::Stream(Stream::from_raw(dict, vec![])));
+        });
+        assert!(inspect_bytes(image).is_err());
+        assert!(inspect_bytes(b"not a PDF".to_vec()).is_err());
+    }
