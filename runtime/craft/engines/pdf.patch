+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pdfcraft_cos::{PdfString, SaveOptions, Stream, write_full, write_incremental};
+
+    fn fixture(packed: bool, change: impl FnOnce(&mut Document, ObjRef)) -> Vec<u8> {
+        let bytes = pdfcraft_engine::Session::new().create_blank(200.0, 300.0, 2).unwrap();
+        let mut doc = Document::open(bytes).unwrap();
+        let root = doc.root().unwrap();
+        change(&mut doc, root);
+        if packed { write_full(&doc, &SaveOptions::default()).unwrap() } else { write_incremental(&doc, &SaveOptions::default()).unwrap() }
+    }
+
+    fn attach(doc: &mut Document, root: ObjRef, object: Object) {
+        let reference = doc.add(object);
+        doc.update_dict(root, |d| d.set(b"DobeFixture".to_vec(), reference)).unwrap();
+    }
+
+    #[test]
+    fn static_pdf_is_inspected_without_opening_a_session() {
+        let bytes = fixture(true, |_, _| {});
+        let first = inspect_bytes(bytes.clone()).unwrap();
+        assert_eq!(first, inspect_bytes(bytes.clone()).unwrap());
+        assert_eq!(first["pages"].as_array().unwrap().len(), 2);
+        assert_eq!(first["pages"][0]["width"], 200.0);
+        assert_eq!(first["document_actions_executed"], false);
+        assert!(!first["objects"].as_object().unwrap().is_empty());
+        let root = tempfile::tempdir().unwrap();
+        std::fs::write(root.path().join("owned.pdf"), bytes).unwrap();
+        let mut automation = Automation::new().with_root(root.path()).unwrap();
+        automation.call("dobe_inspect_pdf", &json!({"path":"owned.pdf"})).unwrap();
+        assert!(automation.session().docs().is_empty());
+        assert!(automation.call("dobe_inspect_pdf", &json!({"path":"../outside.pdf"})).is_err());
+    }
+
+    #[test]
+    fn precise_style_and_dependency_evidence_survives_a_cold_reopen() {
+        fn call(a: &mut Automation, tool: &str, args: Value) -> Value {
+            match a.call(tool, &args).unwrap().remove(0) {
+                crate::Content::Json(value) => value,
+                other => panic!("unexpected content: {other:?}"),
+            }
+        }
+        let root = tempfile::tempdir().unwrap();
+        let mut a = Automation::new().with_root(root.path()).unwrap();
+        let doc = call(&mut a, "doc_create", json!({"from":"blank","width":300,"height":400}))["doc"].clone();
+        call(
+            &mut a,
+            "page_add_text",
+            json!({"doc":doc,"page":1,"text":"Precise","rect":[20.125,30.25,280.625,80],"color":"#1659A0","align":"right"}),
+        );
+        call(
+            &mut a,
+            "comment_add",
+            json!({"doc":doc,"page":1,"type":"rectangle","rect":[20,100,200,150],"color":"#C4472D","fill":"#DDEEFF","width":2.5}),
+        );
+        let content = call(&mut a, "content_list", json!({"doc":doc}));
+        let comments = call(&mut a, "comment_list", json!({"doc":doc}));
+        assert_eq!(content["items"][0]["precise_rect"][0], 20.125);
+        assert_eq!(content["items"][0]["align"], "right");
+        assert!((content["items"][0]["rgb"][0].as_f64().unwrap() - 22.0 / 255.0).abs() < 1e-6);
+        assert_eq!(comments["comments"][0]["stroke_width"], 2.5);
+        assert!((comments["comments"][0]["fill_rgb"][0].as_f64().unwrap() - 221.0 / 255.0).abs() < 1e-6);
+        call(&mut a, "doc_set_info", json!({"doc":doc,"key":"Title","value":"Keep metadata"}));
+        call(&mut a, "doc_set_info", json!({"doc":doc,"key":"DobeCustom","value":"Unknown metadata stays"}));
+        call(&mut a, "doc_save", json!({"doc":doc,"path":"precise.pdf"}));
+        let profile = call(&mut a, "dobe_inspect_pdf", json!({"path":"precise.pdf"}));
+        assert!(profile["info_reference"].is_string());
+        for key in [b"Title".as_slice(), b"DobeCustom"] {
+            let key = key.iter().map(|byte| format!("{byte:02x}")).collect::<String>();
+            assert!(profile["info_entries"][&key]["sha256"].is_string());
+        }
+        let catalog = profile["catalog"].as_str().unwrap();
+        assert_eq!(profile["objects"][catalog]["dictionary_type"], "Catalog");
+        for edge in profile["pages"][0]["direct_references"].as_array().unwrap() {
+            assert_ne!(profile["objects"][edge.as_str().unwrap()]["dictionary_type"], "Pages");
+        }
+        let mut b = Automation::new().with_root(root.path()).unwrap();
+        let reopened = call(&mut b, "doc_open", json!({"path":"precise.pdf"}))["doc"].clone();
+        assert_eq!(call(&mut b, "content_list", json!({"doc":reopened})), content);
+        assert_eq!(call(&mut b, "comment_list", json!({"doc":reopened})), comments);
+    }
+
+    #[test]
+    fn compressed_and_indirect_actions_are_refused() {
+        for action in ["JavaScript", "Launch", "GoToR", "SubmitForm", "Rendition"] {
+            let bytes = fixture(true, |doc, root| {
+                let name = doc.add(Object::name(action));
+                let mut dict = Dict::new();
+                dict.set(b"S".to_vec(), name);
+                dict.set(b"Type".to_vec(), Object::name("Action"));
+                attach(doc, root, Object::Dict(dict));
+            });
+            assert!(bytes.windows(7).any(|w| w == b"/ObjStm"), "fixture must use object streams");
+            assert!(inspect_bytes(bytes).is_err(), "{action}");
+        }
+    }
+
+    #[test]
+    fn external_streams_and_dynamic_dictionary_surfaces_are_refused() {
+        let external = fixture(false, |doc, root| {
+            let mut dict = Dict::new();
+            dict.set(b"F".to_vec(), PdfString::text("/outside/private.pdf"));
+            attach(doc, root, Object::Stream(Stream::from_raw(dict, vec![])));
+        });
+        assert!(inspect_bytes(external).is_err());
+        for key in ["AA", "OpenAction", "JS", "XFA", "RichMediaContent", "3DD", "EmbeddedFiles", "EF", "AF", "Perms", "FS"] {
+            let bytes = fixture(true, |doc, root| {
+                let mut dict = Dict::new();
+                dict.set(key.as_bytes().to_vec(), PdfString::text("opaque"));
+                attach(doc, root, Object::Dict(dict));
+            });
+            assert!(inspect_bytes(bytes).is_err(), "{key}");
+        }
+    }
+
+    #[test]
+    fn static_links_are_data_not_network_execution() {
+        let bytes = fixture(true, |doc, root| {
+            let mut dict = Dict::new();
+            dict.set(b"Type".to_vec(), Object::name("Action"));
+            dict.set(b"S".to_vec(), Object::name("URI"));
