diff --git a/crates/automation/src/dobe_inspect.rs b/crates/automation/src/dobe_inspect.rs
new file mode 100644
index 0000000..2cccf63
--- /dev/null
+++ b/crates/automation/src/dobe_inspect.rs
@@ -0,0 +1,503 @@
+//! Bounded structural admission for Dobe's typed PDF jobs, before a Session opens the PDF.
+use std::collections::{BTreeMap, BTreeSet, HashSet};
+use std::io::Read;
+use std::sync::Arc;
+
+use pdfcraft_cos::{Dict, Document, ObjRef, Object};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+use crate::{Args, Automation, Result, failed};
+
+const MAX_FILE: usize = 64 << 20;
+const MAX_STREAM: usize = 16 << 20;
+const MAX_OBJECTS: usize = 16_384;
+const MAX_NODES: usize = 250_000;
+const MAX_SERIALIZED: usize = 256 << 20;
+const MAX_PAGES: usize = 256;
+
+impl Automation {
+    /// Inspect bytes through the non-executing COS reader. No document is added to the session.
+    pub(crate) fn dobe_inspect_pdf(&self, args: &Args) -> Result<Value> {
+        let path = self.resolve(args.str("path")?, false)?;
+        let before = std::fs::metadata(&path).map_err(failed)?;
+        if !before.is_file() || before.len() > MAX_FILE as u64 {
+            return Err(failed("PDF inspection requires a regular file of at most 64 MiB"));
+        }
+        let file = std::fs::File::open(&path).map_err(failed)?;
+        let metadata = file.metadata().map_err(failed)?;
+        if !metadata.is_file() || metadata.len() > MAX_FILE as u64 {
+            return Err(failed("PDF inspection requires a regular file of at most 64 MiB"));
+        }
+        let mut bytes = Vec::new();
+        file.take(MAX_FILE as u64 + 1).read_to_end(&mut bytes).map_err(failed)?;
+        inspect_bytes(bytes)
+    }
+}
+
+fn sha256(bytes: &[u8]) -> String {
+    Sha256::digest(bytes).iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+/// Inspect a bounded, immutable buffer without evaluating scripts or rendering pages.
+fn inspect_bytes(bytes: Vec<u8>) -> Result<Value> {
+    if bytes.len() > MAX_FILE || !bytes.starts_with(b"%PDF-") {
+        return Err(failed("PDF inspection requires a PDF header and at most 64 MiB"));
+    }
+    let digest = sha256(&bytes);
+    let bytes = Arc::new(bytes);
+    let doc = Document::open_with_stream_limit(bytes.clone(), None, MAX_STREAM).map_err(failed)?;
+    if doc.security().is_some() || doc.reconstructed() || !doc.repair_log().is_empty() {
+        return Err(failed("encrypted or repaired PDFs are outside the admitted PDF contract"));
+    }
+    let mut graph = Graph { doc: &doc, seen: HashSet::new(), nodes: 0, serialized: 0, image_pixels: 0, objects: BTreeMap::new() };
+    graph.walk(&Object::Dict(doc.trailer().clone()), 0, &mut BTreeSet::new())?;
+    if !doc.unreadable_objects().is_empty() || !doc.repair_log().is_empty() {
+        return Err(failed("PDF inspection encountered unreadable or repaired objects"));
+    }
+    let root = doc.root().ok_or_else(|| failed("PDF has no catalog reference"))?;
+    let catalog = doc.get(root);
+    let pages = catalog.as_dict().and_then(|d| d.get(b"Pages")).ok_or_else(|| failed("PDF has no page tree"))?;
+    let mut page_refs = Vec::new();
+    page_tree(&doc, pages, 0, &mut HashSet::new(), &mut page_refs)?;
+    if page_refs.is_empty() {
+        return Err(failed("PDF has no pages"));
+    }
+    // The structural gate has already rejected actions, external-file surfaces and an
+    // oversized page tree. This inspector reads geometry/metadata, never a Session.
+    let info = pdfcraft_render::inspect(bytes.clone(), None).map_err(failed)?;
+    if info.pages.len() != page_refs.len() || !info.warnings.is_empty() {
+        return Err(failed("PDF geometry inspection differs from its page tree or reports warnings"));
+    }
+    let mut total = 0.0_f64;
+    let mut sizes = Vec::new();
+    for (page, reference) in info.pages.iter().zip(page_refs) {
+        let (w, h) = (f64::from(page.width), f64::from(page.height));
+        total += w.ceil() * h.ceil();
+        if !w.is_finite()
+            || !h.is_finite()
+            || !(1.0..=8192.0).contains(&w)
+            || !(1.0..=8192.0).contains(&h)
+            || w.ceil() * h.ceil() > 64_000_000.0
+            || total > 128_000_000.0
+        {
+            return Err(failed("PDF page geometry exceeds the admitted rendering budget"));
+        }
+        let held = doc.get(reference);
+        let mut direct = BTreeSet::new();
+        if let Some(dict) = held.as_dict() {
+            for (key, value) in dict.iter() {
+                if key.as_slice() != b"Parent" {
+                    direct_references(value, &mut direct);
+                }
+            }
+        }
+        sizes.push(json!({"reference":reference.to_string(),"width":w,"height":h,"rotation":page.rotation,
+            "direct_references":direct.into_iter().map(|r|r.to_string()).collect::<Vec<_>>()}));
+    }
+    let mut info_entries = BTreeMap::new();
+    let info_reference = doc.trailer().get(b"Info").and_then(Object::as_ref).map(|r| r.to_string());
+    if let Some(value) = doc.trailer().get(b"Info") {
+        let held = doc.resolve(value);
+        let dictionary = held.as_dict().ok_or_else(|| failed("PDF Info must be a dictionary"))?;
+        for (key, value) in dictionary.iter() {
+            let mut encoded = Vec::new();
+            pdfcraft_cos::serialize(value, &mut encoded);
+            let mut references = BTreeSet::new();
+            direct_references(value, &mut references);
+            info_entries.insert(
+                key.iter().map(|byte| format!("{byte:02x}")).collect::<String>(),
+                json!({"sha256":sha256(&encoded),"references":references.into_iter().map(|r|r.to_string()).collect::<Vec<_>>()}),
+            );
+        }
+    }
+    let mut metadata = BTreeSet::new();
+    if let Some(value) = doc.trailer().get(b"Info") {
+        direct_references(value, &mut metadata);
+    }
+    if let Some(value) = catalog.as_dict().and_then(|d| d.get(b"Metadata")) {
+        direct_references(value, &mut metadata);
+    }
+    Ok(json!({"schema_version":1,"sha256":digest,"bytes":bytes.len(),"pages":sizes,
+        "info_entries":info_entries,"info_reference":info_reference,"catalog":root.to_string(),"metadata_references":metadata.into_iter().map(|r|r.to_string()).collect::<Vec<_>>(),"objects":graph.objects,"nodes":graph.nodes,"declared_image_pixels":graph.image_pixels,
+        "document_actions_executed":false,"qualification":"bounded-static-pdf-structure; not standards or rendering fidelity"}))
+}
+
+/// Literal edges only; the graph walker has already bounded every nested value.
+fn direct_references(object: &Object, references: &mut BTreeSet<ObjRef>) {
+    match object {
+        Object::Ref(reference) => {
+            references.insert(*reference);
+        }
+        Object::Array(values) => {
+            for value in values {
+                direct_references(value, references);
+            }
+        }
+        Object::Dict(dict) => {
+            for (_, value) in dict.iter() {
+                direct_references(value, references);
+            }
+        }
+        Object::Stream(stream) => {
+            for (_, value) in stream.dict.iter() {
+                direct_references(value, references);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Count actual leaves before invoking the renderer's page discovery; /Count is untrusted.
+fn page_tree(doc: &Document, object: &Object, depth: usize, seen: &mut HashSet<ObjRef>, pages: &mut Vec<ObjRef>) -> Result<()> {
+    if depth > 32 || seen.len() >= 4096 {
+        return Err(failed("PDF page tree exceeds structural limits"));
+    }
+    let reference = object.as_ref().ok_or_else(|| failed("PDF page nodes must be indirect objects"))?;
+    if !seen.insert(reference) {
+        return Err(failed("PDF page tree contains a cycle or repeated page node"));
+    }
+    let held = doc.get(reference);
+    let dict = held.as_dict().ok_or_else(|| failed("invalid PDF page dictionary"))?;
+    match name(doc, dict, b"Type").as_deref() {
+        Some(b"Page") => {
+            if pages.len() >= MAX_PAGES {
+                return Err(failed("PDF exceeds the 256-page limit"));
+            }
+            pages.push(reference);
+        }
+        Some(b"Pages") => {
+            let kids = dict.get(b"Kids").ok_or_else(|| failed("PDF page branch has no children"))?;
+            let kids = doc.resolve(kids);
+            let kids = kids.as_array().ok_or_else(|| failed("invalid PDF page children"))?;
+            if kids.is_empty() || kids.len() > 4096 {
+                return Err(failed("PDF page branch exceeds structural limits"));
+            }
+            for child in kids {
+                page_tree(doc, child, depth + 1, seen, pages)?;
+            }
+        }
+        _ => return Err(failed("unsupported PDF page node type")),
+    }
+    Ok(())
+}
+
+fn name(doc: &Document, dict: &Dict, key: &[u8]) -> Option<Vec<u8>> {
+    dict.get(key).and_then(|v| doc.resolve(v).as_name().map(<[u8]>::to_vec))
+}
+
+struct Graph<'a> {
+    doc: &'a Document,
+    seen: HashSet<ObjRef>,
+    nodes: usize,
+    serialized: usize,
+    image_pixels: u64,
+    objects: BTreeMap<String, Value>,
+}
+
+impl Graph<'_> {
+    /// Return an upper bound on serialized bytes before allocating a serialization buffer.
+    fn walk(&mut self, object: &Object, depth: usize, edges: &mut BTreeSet<ObjRef>) -> Result<usize> {
+        self.nodes += 1;
+        if depth > 64 || self.nodes > MAX_NODES {
+            return Err(failed("PDF object graph exceeds structural limits"));
+        }
+        let size = match object {
+            Object::Ref(reference) => {
+                edges.insert(*reference);
+                if !self.doc.accepted_generations(reference.num).contains(&reference.generation) {
+                    return Err(failed("PDF contains an unresolved object reference"));
+                }
+                if self.seen.insert(*reference) {
+                    if self.seen.len() > MAX_OBJECTS {
+                        return Err(failed("PDF exceeds the object limit"));
+                    }
+                    let held = self.doc.get(*reference);
+                    let mut alias = held.clone();
+                    let mut chain = HashSet::from([*reference]);
+                    while let Object::Ref(next) = &*alias {
+                        if chain.len() >= 32 || !chain.insert(*next) {
+                            return Err(failed("PDF reference aliases are cyclic or too deep"));
+                        }
+                        if !self.doc.accepted_generations(next.num).contains(&next.generation) {
+                            return Err(failed("PDF contains an unresolved object reference"));
+                        }
+                        alias = self.doc.get(*next);
+                    }
+                    let mut refs = BTreeSet::new();
+                    let bound = self.walk(&held, depth + 1, &mut refs)?;
+                    self.serialized = self.serialized.saturating_add(bound);
+                    if self.serialized > MAX_SERIALIZED {
+                        return Err(failed("PDF object data exceeds the aggregate byte budget"));
+                    }
+                    let mut encoded = Vec::new();
+                    pdfcraft_cos::serialize(&held, &mut encoded);
+                    if encoded.len() > bound {
+                        return Err(failed("PDF object serialization exceeded its inspected bound"));
+                    }
+                    self.objects.insert(
+                        reference.to_string(),
+                        json!({"sha256":sha256(&encoded),
+                        "dictionary_type":held.as_dict().and_then(|d| name(self.doc, d, b"Type")).map(|v|String::from_utf8_lossy(&v).into_owned()),
+                        "references":refs.into_iter().map(|r|r.to_string()).collect::<Vec<_>>()}),
+                    );
+                }
+                32
+            }
+            Object::Real(value) if !value.is_finite() => return Err(failed("PDF contains nonfinite geometry")),
+            Object::String(value) => {
+                if value.bytes.len() > 1 << 20 {
+                    return Err(failed("PDF string exceeds the byte limit"));
+                }
+                value.bytes.len().saturating_mul(4) + 16
+            }
+            Object::Name(value) => {
+                if value.len() > 256 {
+                    return Err(failed("PDF name exceeds the byte limit"));
+                }
+                value.len() * 3 + 8
+            }
+            Object::Array(values) => {
+                if values.len() > 16_384 {
+                    return Err(failed("PDF array exceeds the item limit"));
+                }
+                let mut size = values.len() + 16;
+                for value in values {
+                    size = size.saturating_add(self.walk(value, depth + 1, edges)?);
+                }
+                size
+            }
+            Object::Dict(dict) => self.dictionary(dict, depth, edges)?,
+            Object::Stream(stream) => {
+                if stream.dict.contains(b"F") || stream.dict.contains(b"Ref") {
+                    return Err(failed("PDF external-file streams and reference XObjects are unsupported"));
+                }
+                stream.raw.len().saturating_add(self.dictionary(&stream.dict, depth, edges)?).saturating_add(128)
+            }
+            _ => 64,
+        };
+        if size > MAX_FILE {
+            return Err(failed("PDF object exceeds the serialized byte limit"));
+        }
+        Ok(size)
+    }
+
+    fn dictionary(&mut self, dict: &Dict, depth: usize, edges: &mut BTreeSet<ObjRef>) -> Result<usize> {
+        if dict.len() > 4096 {
+            return Err(failed("PDF dictionary exceeds the key limit"));
+        }
+        for key in [b"AA".as_slice(), b"OpenAction", b"JS", b"XFA", b"RichMediaContent", b"3DD", b"EmbeddedFiles", b"EF", b"AF", b"Perms", b"FS"] {
+            if dict.contains(key) {
+                return Err(failed("PDF contains automatic actions, dynamic content, attached files or signing permissions"));
+            }
+        }
+        let kind = name(self.doc, dict, b"Type");
+        let subtype = name(self.doc, dict, b"Subtype");
+        let action = name(self.doc, dict, b"S");
+        if subtype.as_deref() == Some(b"Image") {
+            let dimension = |key: &[u8]| -> Result<u64> {
+                let value = dict
+                    .get(key)
+                    .and_then(|v| self.doc.resolve(v).as_int())
+                    .filter(|v| (1..=32768).contains(v))
+                    .ok_or_else(|| failed("PDF image dimensions exceed their admitted bounds"))?;
+                u64::try_from(value).map_err(failed)
+            };
+            let pixels = dimension(b"Width")? * dimension(b"Height")?;
+            self.image_pixels = self.image_pixels.saturating_add(pixels);
+            if pixels > 64_000_000 || self.image_pixels > 128_000_000 {
+                return Err(failed("PDF declared image pixels exceed the decoding budget"));
+            }
+        }
+        if matches!(kind.as_deref(), Some(b"Filespec" | b"Sig"))
+            || matches!(subtype.as_deref(), Some(b"3D" | b"RichMedia" | b"Movie" | b"Sound"))
+            || matches!(name(self.doc, dict, b"FT").as_deref(), Some(b"Sig"))
+            || matches!(
+                action.as_deref(),
+                Some(b"JavaScript" | b"Launch" | b"GoToR" | b"GoToE" | b"SubmitForm" | b"ImportData" | b"Rendition" | b"Movie" | b"Sound")
+            )
+            || kind.as_deref() == Some(b"Action") && !matches!(action.as_deref(), Some(b"URI" | b"GoTo"))
+        {
+            return Err(failed("PDF contains an unsupported executable, external, media or signature object"));
+        }
+        let mut size = 16_usize;
+        for (key, value) in dict.iter() {
+            if key.len() > 256 {
+                return Err(failed("PDF dictionary key exceeds the name limit"));
+            }
+            size = size.saturating_add(key.len() * 3 + 8).saturating_add(self.walk(value, depth + 1, edges)?);
+        }
+        Ok(size)
+    }
+}
