+#[test]
+fn dobe_replacement_keeps_added_text_editable_after_restyle() {
+    let (mut s, id) = open(pdf("BT /F1 12 Tf 72 750 Td (Untouched ordinary text) Tj ET"));
+    let original =
+        crate::AddedText { rect: [72.0, 500.0, 540.0, 550.0], text: "Production ready.".into(), size: 24.0, bold: true, ..Default::default() };
+    s.apply(id, Edit::AddText { page: 0, text: original.clone() }).unwrap();
+    // Creation measures the requested height. Compare against the native state that
+    // existed before replacement, not the initial maximum-height request.
+    let crate::AddedContent::Text(original) = s.get(id).unwrap().added()[0].content.clone() else { panic!("text") };
+    let before = s.get(id).unwrap().bytes.clone();
+    let plan = replace_all(&mut s, id, &query("Production ready.", "Release candidate."));
+    assert_eq!((plan.replaced, plan.skipped_total()), (1, 0));
+    let added = s.get(id).unwrap().added().to_vec();
+    let crate::AddedContent::Text(revised) = &added[0].content else { panic!("text stays text") };
+    assert_eq!(revised.text, "Release candidate.", "stored editable text must match the replacement");
+    let mut expected = original.clone();
+    expected.text = "Release candidate.".into();
+    assert_eq!(*revised, expected, "unrequested native text properties remain exact");
+    s.undo(id).unwrap();
+    assert_eq!(s.get(id).unwrap().bytes, before, "replacement remains one reversible edit");
+    s.redo(id).unwrap();
+    let mut restyled = expected;
+    restyled.set_color([0.4, 0.2, 0.1]);
+    s.apply(id, Edit::UpdateContent { page: 0, index: 0, content: crate::AddedContent::Text(restyled) }).unwrap();
+    let rendered = page_text(&s, id, 0).plain_text();
+    assert!(rendered.contains("Release candidate."), "{rendered}");
+    assert!(!rendered.contains("Production ready."), "restyling must not resurrect stale wording: {rendered}");
+    assert_eq!(rendered.matches("Release candidate.").count(), 1, "replacement must not leave duplicate page content");
+    let (cold, cold_id) = open(s.get(id).unwrap().bytes.as_ref().clone());
+    assert_eq!(cold.get(cold_id).unwrap().added(), s.get(id).unwrap().added());
+    assert_eq!(page_text(&cold, cold_id, 0).plain_text(), rendered);
+}
