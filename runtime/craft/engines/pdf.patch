+/// Stream ownership for paragraphs and independently editable named text. Ordinary
+/// paragraph grouping can join several named items; each item's visible text must
+/// therefore also be grouped from only the lines its own stream actually draws.
+pub struct TextOwnership {
+    pub blocks: Vec<Vec<Option<pdfcraft_cos::ObjRef>>>,
+    pub text: HashMap<pdfcraft_cos::ObjRef, String>,
+}
+
+pub fn text_ownership(doc: &Document, page: usize) -> Result<TextOwnership, EditError> {
+    let lines = text_lines(doc, page)?;
+    let streams = content_streams(doc, &page_dict(doc, page)?.dict)?;
+    let pieces = joined(&streams);
+    let ops = pieces.parse().ops;
+    let mut line_refs = Vec::new();
+    let mut by_stream: HashMap<pdfcraft_cos::ObjRef, Vec<TextLine>> = HashMap::new();
+    let mut ambiguous = HashSet::new();
+    for line in &lines {
+        let mut refs = Vec::new();
+        for operator in &line.ops {
+            let op = ops.get(*operator).ok_or_else(|| EditError::Invalid("a text line refers to a missing operator".into()))?;
+            let (first, last) = pieces.pieces_of(op);
+            let source = streams.get(first..=last).ok_or_else(|| EditError::Invalid("a text operator refers to missing content streams".into()))?;
+            for stream in source {
+                let reference = stream.entry.as_ref();
+                if !refs.contains(&reference) {
+                    refs.push(reference);
+                }
+            }
+        }
+        if let [Some(reference)] = refs.as_slice() {
+            by_stream.entry(*reference).or_default().push(line.clone());
+        } else {
+            ambiguous.extend(refs.iter().flatten().copied());
+        }
+        line_refs.push(refs);
+    }
+    let blocks = group_blocks(&lines)
+        .iter()
+        .map(|block| {
+            let mut refs = Vec::new();
+            for index in &block.lines {
+                let source = line_refs.get(*index).ok_or_else(|| EditError::Invalid("a paragraph refers to a missing line".into()))?;
+                for reference in source {
+                    if !refs.contains(reference) {
+                        refs.push(*reference);
+                    }
+                }
+            }
+            Ok(refs)
+        })
+        .collect::<Result<_, EditError>>()?;
+    let text = by_stream
+        .into_iter()
+        .filter_map(|(reference, lines)| {
+            let blocks = group_blocks(&lines);
+            if ambiguous.contains(&reference) || blocks.iter().any(|block| block.invisible) {
+                return None;
+            }
+            Some((reference, blocks.iter().map(|b| b.editor_text.as_str()).collect::<Vec<_>>().join("\n")))
+        })
+        .collect();
+    Ok(TextOwnership { blocks, text })
+}
