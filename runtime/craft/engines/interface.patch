+        PEAK.with(|c| c.set(c.get().max(self.peak)));
+        DENIED.with(|c| c.set(c.get().saturating_add(self.denied)));
+    }
+}
+
+/// Observe isolated layers while running `f`, with a limit no higher than the
+/// enclosing scope. Nested denials propagate out; state is restored on unwinding.
+/// The base image and codec allocations are outside this isolated-layer budget.
+pub fn audit_layers<T>(limit: u64, f: impl FnOnce() -> T) -> (T, LayerAudit) {
+    let scope = AuditScope {
+        limit: LIMIT.with(|c| c.replace(c.get().min(limit))),
+        peak: PEAK.with(|c| c.replace(HELD.with(Cell::get))),
+        denied: DENIED.with(|c| c.replace(0)),
+    };
+    let result = f();
+    let audit = LayerAudit { peak_bytes: PEAK.with(Cell::get), denied_layers: DENIED.with(Cell::get) };
+    drop(scope);
+    (result, audit)
+}
+
+#[cfg(test)]
+mod audit_tests {
+    use super::*;
+
+    #[test]
+    fn denial_is_counted_and_next_scope_recovers() {
+        let (ok, audit) = audit_layers(15, || Held::take(2, 2, 1).is_some());
+        assert!(!ok);
+        assert_eq!(audit, LayerAudit { peak_bytes: 0, denied_layers: 1 });
+        let (ok, audit) = audit_layers(16, || Held::take(2, 2, 1).is_some());
+        assert!(ok);
+        assert_eq!(audit, LayerAudit { peak_bytes: 16, denied_layers: 0 });
+    }
+
+    #[test]
+    fn nested_scope_cannot_raise_limit_or_hide_denial() {
+        let (_, outer) = audit_layers(16, || {
+            let _held = Held::take(2, 2, 1).unwrap();
+            let (ok, inner) = audit_layers(BUDGET, || Held::take(1, 1, 1).is_some());
+            assert!(!ok);
+            assert_eq!(inner.denied_layers, 1);
+        });
+        assert_eq!(outer, LayerAudit { peak_bytes: 16, denied_layers: 1 });
+    }
+
+    #[test]
+    fn scope_restores_limit_after_unwinding() {
+        let before = LIMIT.with(Cell::get);
+        let _ = std::panic::catch_unwind(|| audit_layers(0, || panic!("synthetic render failure")));
+        assert_eq!(LIMIT.with(Cell::get), before);
+        assert!(Held::take(1, 1, 1).is_some());
+    }
+
+    #[test]
+    fn real_clipped_frame_reports_dropped_content() {
+        use figcraft_color::{Color, Paint};
+        use figcraft_doc::{Document, NodeKind};
+        let mut doc = Document::new("Synthetic render audit");
+        let root = doc.create(doc.first_page().unwrap(), NodeKind::Frame, "Frame", 0.0, 0.0, 8.0, 8.0).unwrap();
+        doc.get_mut(root).unwrap().fills.clear();
+        let child = doc.create(root, NodeKind::Rectangle, "Ink", 0.0, 0.0, 8.0, 8.0).unwrap();
+        doc.get_mut(child).unwrap().fills = vec![Paint::solid(Color::BLACK)];
+        let render = || crate::render_area(&doc, &[root], figcraft_geom::Rect::new(0.0, 0.0, 8.0, 8.0), 1.0).unwrap();
+        let (omitted, denied) = audit_layers(64, render);
+        assert!(denied.denied_layers > 0);
+        assert!(omitted.pixels().iter().all(|p| p.alpha() == 0));
+        let (complete, accepted) = audit_layers(1024, render);
+        assert_eq!(accepted.denied_layers, 0);
+        assert!(complete.pixels().iter().all(|p| p.alpha() == 255));
+    }
+}
+
 impl Drop for Held {
     fn drop(&mut self) {
         HELD.with(|c| c.set(c.get().saturating_sub(self.0)));
