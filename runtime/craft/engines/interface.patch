@@ -0,0 +1,52 @@
+use super::*;
+
+fn scene() -> (Session, NodeId) {
+    let mut session = Session::new();
+    let result = session.execute("frame.create", &json!({"width":8,"height":8})).unwrap();
+    let root = crate::params::id_of(&result["id"]).unwrap();
+    session
+        .execute(
+            "node.create",
+            &json!({"type":"rectangle","parent":root,"width":8,"height":8,
+        "props":{"fill":"#111111"}}),
+        )
+        .unwrap();
+    (session, root)
+}
+
+#[test]
+fn incomplete_render_fails_without_writing_a_file_and_recovers() {
+    let (mut session, root) = scene();
+    let folder = std::env::temp_dir().join(format!("dobe-interface-export-audit-{}", std::process::id()));
+    std::fs::create_dir(&folder).unwrap();
+    let path = folder.join("output.png");
+    let params = json!({"ids":[root],"format":"png","scale":1,"path":path});
+    let (result, audit) = figcraft_render::audit_layers(64, || session.execute("file.export", &params));
+    assert!(result.unwrap_err().to_string().contains("would omit content"));
+    assert!(audit.denied_layers > 0);
+    assert!(!path.exists());
+    session.execute("file.export", &params).unwrap();
+    assert!(path.metadata().unwrap().len() > 0);
+    std::fs::remove_file(path).unwrap();
+    std::fs::remove_dir(folder).unwrap();
+}
+
+#[test]
+fn raster_budget_is_checked_before_allocating_layers() {
+    let (mut session, root) = scene();
+    let node = session.doc_mut().unwrap().get_mut(root).unwrap();
+    node.width = 8192.0;
+    node.height = 8192.0;
+    let (result, audit) = figcraft_render::audit_layers(256 << 20, || export_file(session.doc().unwrap(), &[root], &ExportSetting::default(), 1.0));
+    assert!(result.unwrap_err().to_string().contains("32 million pixels"));
+    assert_eq!(audit.peak_bytes, 0);
+    assert_eq!(audit.denied_layers, 0);
+}
+
+#[test]
+fn raster_cycle_is_refused_before_bounds_walk() {
+    let (mut session, root) = scene();
+    session.doc_mut().unwrap().get_mut(root).unwrap().children.push(root);
+    let result = export_file(session.doc().unwrap(), &[root], &ExportSetting::default(), 1.0);
+    assert!(result.unwrap_err().to_string().contains("maximum export depth"));
+}
