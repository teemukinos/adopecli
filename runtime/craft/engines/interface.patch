+use std::process::Command;
+
+#[test]
+fn identity_and_headless_help() {
+    let bin = env!("CARGO_BIN_EXE_dobe-interface");
+    let version = Command::new(bin).arg("--version").output().unwrap();
+    assert!(version.status.success());
+    assert_eq!(String::from_utf8(version.stdout).unwrap().trim(), "dobe-interface 0.18.1");
+    let help = Command::new(bin).arg("--help").output().unwrap();
+    let text = String::from_utf8(help.stdout).unwrap();
+    assert!(help.status.success() && text.contains("Dobe Interface") && text.contains("Usage: dobe-interface"));
+    assert!(!text.contains("FigCraft without a window"));
+}
+
+#[test]
+fn editor_and_publication_routes_are_refused_before_help() {
+    let bin = env!("CARGO_BIN_EXE_dobe-interface");
+    for args in [
+        vec!["mcp", "--attach", "7979", "--help"],
+        vec!["mcp", "--attach=7979"],
+        vec!["plugin", "publish", "missing", "--server", "example.invalid", "--help"],
+        vec!["connect", "--help"],
+    ] {
+        let result = Command::new(bin).args(&args).output().unwrap();
+        assert!(!result.status.success(), "{args:?}");
+        assert!(String::from_utf8(result.stderr).unwrap().contains("unavailable"));
+    }
+}
