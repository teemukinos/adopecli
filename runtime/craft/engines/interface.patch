--- /dev/null
+++ b/crates/engine/src/cmd/dobe_text.rs
@@ -0,0 +1,216 @@
+//! Read-only evidence from the same shaped layout used by the native renderer.
+//! This reports missing glyphs and substitutions; it does not approve publication.
+
+use std::collections::BTreeMap;
+
+use figcraft_doc::Node;
+use figcraft_geom::{Rect, kurbo::Shape};
+use serde_json::{Value, json};
+
+use super::CommandSpec;
+use crate::{Result, Session, bad, params::req_id, spec};
+
+const COMMAND: &str = "dobe.textDiagnostics";
+const MAX_CHARS: usize = 16_384;
+const MAX_GLYPHS: usize = 32_768;
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![spec!(
+        COMMAND,
+        "Inspect shaped text",
+        "{id}  read-only native layout evidence: actual font hashes and faces, glyph clusters, missing glyphs, unmapped characters and truncation; at most 16384 source characters",
+        false,
+        inspect
+    )]
+}
+
+fn inspect(s: &mut Session, p: &Value) -> Result<Value> {
+    let id = req_id(COMMAND, p, "id")?;
+    diagnose(s.doc()?.get(id)?)
+}
+
+fn face_index(face: &figcraft_text::Face, faces: &mut Vec<Value>, indices: &mut BTreeMap<u32, usize>) -> usize {
+    if let Some(index) = indices.get(&face.id) {
+        return *index;
+    }
+    // This existing helper is SHA-256 over arbitrary bytes, despite its image-key name.
+    let hash = figcraft_format::image_hash(face.bytes.data());
+    let index = faces.len();
+    let axes: Vec<Value> = face
+        .axes
+        .iter()
+        .map(|axis| {
+            json!({
+                "tag": axis.tag, "min": axis.min, "max": axis.max, "default": axis.default
+            })
+        })
+        .collect();
+    faces.push(json!({"sha256": hash, "index": face.index, "family": face.family,
+        "style": face.style, "postscript": face.postscript, "weight": face.weight,
+        "italic": face.italic, "axes": axes}));
+    indices.insert(face.id, index);
+    index
+}
+
+/// Bounds of the actual glyph ink, before node strokes/effects and ancestor clipping.
+/// Bitmap and COLR glyphs follow the same branches as the renderer at export scale 1.
+fn ink(glyph: &figcraft_text::Glyph) -> Option<Rect> {
+    let path_bounds = |path: figcraft_geom::BezPath| (!path.elements().is_empty()).then(|| path.bounding_box());
+    match glyph.color(1.0) {
+        Some(figcraft_text::ColorInk::Bitmap(bitmap, place)) => {
+            Some(place.transform_rect_bbox(Rect::new(0.0, 0.0, f64::from(bitmap.width), f64::from(bitmap.height))))
+        }
+        Some(figcraft_text::ColorInk::Layers(layers)) => {
+            layers.iter().filter_map(|layer| path_bounds(glyph.layer_path(layer.gid))).reduce(|a, b| a.union(b))
+        }
+        None => path_bounds(glyph.path()),
+    }
+}
+
+fn diagnose(node: &Node) -> Result<Value> {
+    let text = node.kind.text().ok_or_else(|| bad(COMMAND, "target must be text"))?;
+    // Check bytes before collecting chars, and runs before asking the shaper to expand spans.
+    if text.characters.len() > MAX_CHARS * 4 || text.runs.len() > MAX_CHARS || text.char_count() > MAX_CHARS {
+        return Err(bad(COMMAND, "text exceeds the diagnostic budget"));
+    }
+    if ![node.width, node.height].iter().all(|v| v.is_finite() && (0.0..=8192.0).contains(v)) {
+        return Err(bad(COMMAND, "text box exceeds the diagnostic budget"));
+    }
+    if text.spans().iter().any(|(_, _, style)| !style.font_size.is_finite() || !(1.0..=500.0).contains(&style.font_size)) {
+        return Err(bad(COMMAND, "text size exceeds the diagnostic budget"));
+    }
+    let chars: Vec<char> = text.characters.chars().collect();
+    let (layout, dy) = figcraft_text::layout_node(node).ok_or_else(|| bad(COMMAND, "text has no layout"))?;
+    if layout.glyphs.len() > MAX_GLYPHS || layout.styles.len() > MAX_CHARS || layout.lines.len() > MAX_CHARS + 1 {
+        return Err(bad(COMMAND, "shaped layout exceeds the diagnostic budget"));
+    }
+    let mut faces = Vec::new();
+    let mut face_indices = BTreeMap::new();
+    let mut glyphs = Vec::new();
+    let mut mapped = vec![false; chars.len()];
+    let mut missing = 0;
+    let mut bounds: Option<Rect> = None;
+    let mut style_coordinates = BTreeMap::new();
+    for glyph in &layout.glyphs {
+        let face = &glyph.face;
+        let face_index = face_index(face, &mut faces, &mut face_indices);
+        let start = glyph.char_start;
+        let end = glyph.char_end;
+        // Generated list markers can have an empty cluster. Preserve it as such.
+        if start > end || end > chars.len() || glyph.style >= layout.styles.len() {
+            return Err(bad(COMMAND, "shaper returned an invalid source cluster or style"));
+        }
+        let style = layout.styles.get(glyph.style).ok_or_else(|| bad(COMMAND, "missing glyph style"))?;
+        let expected = style_coordinates.entry((face.id, glyph.style)).or_insert_with(|| face.coords(&face.axis_values(style)));
+        let coordinates_match_style = *expected == glyph.coords;
+        if let Some(rect) = ink(glyph) {
+            bounds = Some(bounds.map_or(rect, |old| old.union(rect)));
+        }
+        if let Some(range) = mapped.get_mut(start..end) {
+            range.fill(true);
+        }
+        missing += usize::from(glyph.gid == 0);
+        let coords: Vec<i16> = glyph.coords.iter().map(|coord| coord.to_bits()).collect();
+        glyphs.push(json!({"gid": glyph.gid, "face": face_index, "coords_f2dot14": coords,
+            "start": start, "end": end, "style": glyph.style, "rtl": glyph.rtl,
+            "coordinates_match_style": coordinates_match_style,
+            "x": glyph.x, "y": glyph.y, "size": glyph.size, "advance": glyph.advance}));
+    }
+    let unmapped: Vec<Value> = chars
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| !mapped[*i])
+        .map(|(i, c)| json!({"index": i, "codepoint": *c as u32, "whitespace": c.is_whitespace(), "control": c.is_control()}))
+        .collect();
+    for decoration in &layout.decorations {
+        let rect = decoration.path().bounding_box();
+        bounds = Some(bounds.map_or(rect, |old| old.union(rect)));
+    }
+    let ink_bounds = bounds.map(|r| [r.x0, r.y0 + dy, r.x1, r.y1 + dy]);
+    if ![layout.width, layout.height, dy].iter().all(|v| v.is_finite()) || ink_bounds.is_some_and(|r| r.iter().any(|v| !v.is_finite())) {
+        return Err(bad(COMMAND, "layout contains nonfinite bounds"));
+    }
+    let styles: Vec<Value> = layout
+        .styles
+        .iter()
+        .map(|st| {
+            let primary = figcraft_text::find_face(&st.font_family, &st.font_style).map(|face| {
+                let index = face_index(&face, &mut faces, &mut face_indices);
+                let coords: Vec<i16> = face.coords(&face.axis_values(st)).iter().map(|c| c.to_bits()).collect();
+                json!({"face": index, "coords_f2dot14": coords})
+            });
+            json!({
+                "family": st.font_family, "style": st.font_style, "size": st.font_size,
+                "variations": st.variations, "case": st.case,
+                "primary": primary,
+                "family_available": figcraft_text::has_family(&st.font_family),
+                "style_available": figcraft_text::family_styles(&st.font_family).contains(&st.font_style)
+            })
+        })
+        .collect();
+    let report = json!({"version": 2, "id": node.id, "source_characters": chars.len(),
+        "width": layout.width, "height": layout.height, "vertical_offset": dy,
+        "ink_bounds": ink_bounds,
+        "truncated": layout.truncated, "on_path": layout.on_path.is_some(),
+        "missing_glyphs": missing, "unmapped": unmapped, "faces": faces,
+        "styles": styles, "glyphs": glyphs, "publication_approved": false});
+    // The private MCP client also bounds the outer frame. Keep space for JSON escaping there.
+    if serde_json::to_vec(&report).map_err(|e| bad(COMMAND, e.to_string()))?.len() > 6 * 1024 * 1024 {
+        return Err(bad(COMMAND, "diagnostic report exceeds the response budget"));
+    }
+    Ok(report)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn text(s: &mut Session, characters: &str) -> Value {
+        s.execute(
+            "node.create",
+            &json!({"type":"text", "text":characters,
+            "props":{"fontFamily":"Inter", "fontStyle":"Regular", "fontSize":20}}),
+        )
+        .unwrap()["id"]
+            .clone()
+    }
+
+    #[test]
+    fn reports_real_faces_and_clusters_without_editing_document() {
+        let mut s = Session::new();
+        let id = text(&mut s, "office café\nSecond line");
+        let before = serde_json::to_value(s.doc().unwrap()).unwrap();
+        let depth = s.undo_depth();
+        let report = s.execute(COMMAND, &json!({"id":id})).unwrap();
+        assert_eq!(report["missing_glyphs"], 0);
+        assert_eq!(report["truncated"], false);
+        assert_eq!(report["publication_approved"], false);
+        assert!(!report["glyphs"].as_array().unwrap().is_empty());
+        assert_eq!(report["faces"][0]["family"], "Inter");
+        assert_eq!(report["faces"][0]["sha256"].as_str().unwrap().len(), 64);
+        assert_eq!(before, serde_json::to_value(s.doc().unwrap()).unwrap());
+        assert_eq!(depth, s.undo_depth());
+    }
+
+    #[test]
+    fn reports_missing_glyph_instead_of_approving_fallback() {
+        let mut s = Session::new();
+        let id = text(&mut s, "\u{10ffff}");
+        let report = s.execute(COMMAND, &json!({"id":id})).unwrap();
+        assert!(report["missing_glyphs"].as_u64().unwrap() > 0);
+        assert_eq!(report["publication_approved"], false);
+    }
