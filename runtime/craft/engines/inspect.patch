+//! Private file transport. Public authorization and job control belong to Dobe's runtime.
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+use craft_anything_analysis::dobe;
+use std::fs::OpenOptions;
+use std::io::{Read, Write};
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::Path;
+
+fn read_input(path: &Path) -> Result<Vec<u8>, String> {
+    let file = OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK).open(path).map_err(|_| "cannot open regular input")?;
+    let before = file.metadata().map_err(|_| "cannot inspect input metadata")?;
+    if !before.is_file() || before.len() == 0 || before.len() > dobe::MAX_INPUT as u64 {
+        return Err("input must be a nonempty bounded regular file".into());
+    }
+    let mut bytes = Vec::new();
+    (&file).take(dobe::MAX_INPUT as u64 + 1).read_to_end(&mut bytes).map_err(|_| "cannot read input")?;
+    let after = file.metadata().map_err(|_| "cannot recheck input metadata")?;
+    if bytes.len() as u64 != before.len()
+        || before.len() != after.len()
+        || before.mtime() != after.mtime()
+        || before.mtime_nsec() != after.mtime_nsec()
+        || before.ctime() != after.ctime()
+        || before.ctime_nsec() != after.ctime_nsec()
+    {
+        return Err("input changed while reading".into());
+    }
+    Ok(bytes)
+}
+
+struct BoundedOutput(Vec<u8>);
+impl Write for BoundedOutput {
+    fn write(&mut self, data: &[u8]) -> std::io::Result<usize> {
+        if data.len() > dobe::MAX_OUTPUT.saturating_sub(self.0.len()) {
+            return Err(std::io::Error::other("inspection output limit exceeded"));
+        }
+        self.0.extend_from_slice(data);
+        Ok(data.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+fn run() -> Result<(), String> {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    if args.len() == 1 && args.first().is_some_and(|a| a == "--version") {
+        println!("dobe-inspect {}", env!("CARGO_PKG_VERSION"));
+        return Ok(());
+    }
+    let [command, format, permission, expected, input, output] = args.as_slice() else {
+        return Err("usage: dobe-inspect inspect FORMAT --owned-or-authorized SHA256 INPUT OUTPUT".into());
+    };
+    if command != "inspect" || permission != "--owned-or-authorized" {
+        return Err("explicit owned-or-authorized input consent is required".into());
+    }
+    let kind = format.to_str().ok_or("invalid format")?;
+    if !dobe::supported(kind) {
+        return Err("unsupported inspection format".into());
+    }
+    let expected = expected.to_str().ok_or("invalid expected SHA-256")?;
+    let bytes = read_input(Path::new(input))?;
+    let report = dobe::inspect(kind, &bytes, expected, true)?;
+    let mut encoded = BoundedOutput(Vec::new());
+    serde_json::to_writer(&mut encoded, &report).map_err(|_| "cannot serialize bounded inspection output")?;
+    let mut file = OpenOptions::new().write(true).create_new(true).mode(0o600).open(output).map_err(|_| "output must be a new file")?;
+    file.write_all(&encoded.0).and_then(|()| file.sync_all()).map_err(|_| "cannot persist inspection output")?;
+    Ok(())
+}
+
+fn main() -> std::process::ExitCode {
+    match run() {
+        Ok(()) => std::process::ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("{}", serde_json::json!({"error": "inspection_refused", "message": error}));
+            std::process::ExitCode::FAILURE
+        }
+    }
+}
