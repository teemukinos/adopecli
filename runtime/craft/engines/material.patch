@@ -0,0 +1,63 @@
+//! Evaluate one admitted graph without preview cooks, recovery images or saves.
+use crate::Session;
+use materialcraft_eval::{Cooked, DobeBudget, NodeOutput, Options};
+use serde_json::{Value, json};
+
+pub fn evaluate(session: &Session, graph_index: usize) -> Result<Value, String> {
+    cook(session, graph_index).map(|(_, report)| report)
+}
+
+pub fn cook(session: &Session, graph_index: usize) -> Result<(Cooked, Value), String> {
+    let graph = session.pkg.graphs.get(graph_index).ok_or("Dobe evaluation graph is absent")?;
+    if graph.function.is_some() {
+        return Err("Dobe evaluation requires a material graph".into());
+    }
+    if !session.load_warnings.is_empty() || !session.cooked.nodes.is_empty() || !session.dirty {
+        return Err("Dobe evaluation requires an unrecovered, uncooked source".into());
+    }
+    let decoder = session.resource_decoder();
+    let budget = DobeBudget::default();
+    let mut options = Options::new(&decoder);
+    options.environment = session.environment;
+    options.dobe_budget = Some(&budget);
+    let cooked = materialcraft_eval::cook(&session.pkg, graph_index, &options, &session.cache);
+    if cooked.cancelled {
+        return Err("Dobe evaluation cancelled".into());
+    }
+    if let Some((identity, error)) = cooked.nodes.iter().find_map(|(id, result)| result.error.as_ref().map(|error| (id, error))) {
+        return Err(format!("Dobe evaluation node {}: {error}", identity.0));
+    }
+    if cooked.nodes.len() != graph.nodes.len() {
+        return Err("Dobe evaluation omitted graph nodes".into());
+    }
+    let nodes: Vec<_> = graph
+        .nodes
+        .iter()
+        .filter_map(|node| {
+            cooked.nodes.get(&node.id).map(|result| {
+                json!({
+                    "id":node.id.0, "base":result.base, "baseValues":result.base_values, "parameters":result.parameters,
+                    "cached":result.cached, "outputs":result.outputs.iter().map(|output| match output {
+                        NodeOutput::Value(value) => json!({"value":value}),
+                        NodeOutput::Image(image) => json!({"width":image.w,"height":image.h,"channels":if image.is_gray(){1}else{4},
+                            "minimum":image.data.iter().copied().fold(f32::INFINITY,f32::min),
+                            "maximum":image.data.iter().copied().fold(f32::NEG_INFINITY,f32::max)})
+                    }).collect::<Vec<_>>()
+                })
+            })
+        })
+        .collect();
+    let mut report = json!({"nativePackage":session.pkg,"graph":graph_index,"nodes":nodes,"usage":budget.usage(),
+        "limits":{"node_visits":DobeBudget::MAX_NODE_VISITS,"node_texels":DobeBudget::MAX_NODE_TEXELS,"output_texels":DobeBudget::MAX_OUTPUT_TEXELS},
+        "fullSize":true,"finiteOutputs":true,"sourceSaved":false});
+    archived_packages(session, &mut report);
+    Ok((cooked, report))
+}
+
+/// Expose every admitted archive package; Package serialization omits this map.
+/// Single-package replies retain their existing envelope.
+pub fn archived_packages(session: &Session, report: &mut Value) {
+    if session.pkg.dependencies.len() > 1 {
+        report["archivedPackages"] = json!(session.pkg.dependencies);
+    }
+}
diff --git a/crates/engine/src/dobe_maps.rs b/crates/engine/src/dobe_maps.rs
new file mode 100644
index 0000000..5c8306d
--- /dev/null
+++ b/crates/engine/src/dobe_maps.rs
@@ -0,0 +1,140 @@
+//! Fixed-file map delivery from the same bounded cook used by evaluation.
+use crate::{ColorSpace, Session, dobe_evaluate};
+use materialcraft_formats::Depth;
+use materialcraft_image::linear_to_srgb;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::collections::{BTreeMap, BTreeSet};
+use std::io::Write;
+use std::path::Path;
+
+const MAX_MAPS: usize = 256;
+const MAX_TEXELS: u64 = 33_554_432;
+const MAX_FILE_BYTES: usize = 64 << 20;
+const MAX_TOTAL_BYTES: usize = 512 << 20;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    format: String,
+    depth: u8,
+    #[serde(default)]
+    outputs: Option<Vec<String>>,
+    #[serde(default)]
+    color_spaces: BTreeMap<String, String>,
+    #[serde(default)]
+    discard_alpha: bool,
+}
+
+pub fn export(session: &Session, index: usize, request: Request, destination: &Path) -> Result<Value, String> {
+    let depth = match (request.format.as_str(), request.depth) {
+        ("png", 16) => Depth::U16,
+        ("png" | "jpg" | "tga" | "bmp" | "webp", 8) => Depth::U8,
+        ("exr" | "hdr", 32) => Depth::F32,
+        _ => return Err("Dobe map format/depth combination is unsupported".into()),
+    };
+    let selected: Option<BTreeSet<_>> = request.outputs.as_ref().map(|items| items.iter().collect());
+    if request.outputs.as_ref().is_some_and(|items| items.is_empty() || items.len() > MAX_MAPS || selected.as_ref().is_none_or(|set| set.len() != items.len()))
+    {
+        return Err("Dobe map selection is empty, duplicated or oversized".into());
+    }
+    if request.color_spaces.len() > MAX_MAPS || request.color_spaces.values().any(|v| !matches!(v.as_str(), "srgb" | "linear" | "raw")) {
+        return Err("Dobe map color-space overrides are invalid".into());
+    }
+    let (cooked, evaluation) = dobe_evaluate::cook(session, index)?;
+    let graph = session.pkg.graphs.get(index).ok_or("Dobe map graph is absent")?;
+    let outputs = materialcraft_eval::outputs(graph, &cooked);
+    let mut names = BTreeSet::new();
+    for (_, _, name, _) in &outputs {
+        if name.is_empty() || name.len() > 4096 || !names.insert(name) {
+            return Err("Dobe map output identifiers are empty, duplicated or oversized".into());
+        }
+    }
+    if selected.as_ref().is_some_and(|set| set.iter().any(|name| !names.contains(name))) {
+        return Err("Dobe map selection contains an absent output".into());
+    }
+    let mut plan = Vec::new();
+    let mut skipped = Vec::new();
+    let mut texels = 0u64;
+    for (id, usage, name, image) in outputs {
+        if selected.as_ref().is_some_and(|set| !set.contains(&name)) {
+            continue;
+        }
+        let Some(image) = image else {
+            if selected.is_some() {
+                return Err("Dobe selected map has no raster output".into());
+            }
+            skipped.push(json!({"node":id.0,"identifier":name,"reason":"non-raster-output"}));
+            continue;
+        };
+        let space = if let Some(value) = request.color_spaces.get(&name) {
+            ColorSpace::from_id(value).ok_or("Dobe map color space is invalid")?
+        } else if image.is_gray() {
+            ColorSpace::Raw
+        } else if matches!(request.format.as_str(), "exr" | "hdr") {
+            ColorSpace::Linear
+        } else {
+            ColorSpace::for_usage(usage)
+        };
+        if image.is_gray() && space == ColorSpace::Srgb {
+            return Err("Dobe grayscale maps do not apply an sRGB transform".into());
+        }
+        let drops_alpha = matches!(request.format.as_str(), "jpg" | "exr" | "hdr");
+        let nonopaque = !image.is_gray() && image.data.chunks_exact(4).any(|p| p[3] != 1.0);
+        if drops_alpha && nonopaque && !request.discard_alpha {
+            return Err("Dobe map would discard nonopaque alpha; explicit discard_alpha is required".into());
+        }
+        // Check the actual transfer curve before the encoder can quantize away
+        // nonfinite values. RGBE's exponent conversion must never wrap.
+        for pixel in image.data.chunks_exact(if image.is_gray() { 1 } else { 4 }) {
+            let mut peak = 0.0f32;
+            for value in pixel.iter().take(if image.is_gray() { 1 } else { 3 }) {
+                let value = if space.encodes_srgb() { linear_to_srgb(*value) } else { *value };
+                if !value.is_finite() {
+                    return Err("Dobe map transfer produced a nonfinite sample".into());
+                }
+                if request.format == "hdr" && value < 0.0 {
+                    return Err("Dobe RGBE cannot preserve negative samples".into());
+                }
+                peak = peak.max(value);
+            }
+            if request.format == "hdr" && peak > 0.0 && !(-127..=127).contains(&(peak.log2().floor() as i32 + 1)) {
+                return Err("Dobe RGBE exponent is outside its nonzero finite range".into());
+            }
+        }
+        texels += u64::from(image.w) * u64::from(image.h);
+        plan.push((id, usage, name, image, space, drops_alpha && nonopaque));
+    }
+    if plan.is_empty() || plan.len() > MAX_MAPS || texels > MAX_TEXELS {
+        return Err("Dobe map count or aggregate raster budget is invalid".into());
+    }
+    if request.color_spaces.keys().any(|name| !plan.iter().any(|(_, _, planned, _, _, _)| planned == name)) {
+        return Err("Dobe color-space override does not name a selected raster map".into());
+    }
+    std::fs::create_dir(destination).map_err(|e| format!("Dobe map destination must be new: {e}"))?;
+    let write = || -> Result<Value, String> {
+        let mut total_bytes = 0usize;
+        let mut maps = Vec::new();
+        for (id, usage, name, image, space, alpha_discarded) in plan {
+            let bytes = materialcraft_formats::encode(image, &request.format, depth, space.encodes_srgb()).map_err(|e| e.to_string())?;
+            total_bytes += bytes.len();
+            if bytes.is_empty() || bytes.len() > MAX_FILE_BYTES || total_bytes > MAX_TOTAL_BYTES {
+                return Err("Dobe encoded maps exceed their byte budget".into());
+            }
+            let file = format!("map-{}.{}", id.0, request.format);
+            let mut output = std::fs::OpenOptions::new().write(true).create_new(true).open(destination.join(&file)).map_err(|e| e.to_string())?;
+            output.write_all(&bytes).and_then(|_| output.sync_all()).map_err(|e| e.to_string())?;
+            maps.push(json!({"node":id.0,"identifier":name,"usage":usage,"file":file,"width":image.w,"height":image.h,
+                "sourceChannels":if image.is_gray(){1}else{4},"colorSpace":space.id(),"bytes":bytes.len(),"alphaDiscarded":alpha_discarded,
+                "encoding":match request.format.as_str(){"hdr"=>"rgbe-shared-exponent","exr"=>"float32-rgb","jpg"=>"lossy-unorm8",_=>if request.depth==16{"unorm16"}else{"unorm8"}},
+                "integerClamping":!matches!(request.format.as_str(),"exr"|"hdr")}));
+        }
+        Ok(json!({"evaluation":evaluation,"maps":maps,"skipped":skipped,"format":request.format,"depth":request.depth,
+            "texels":texels,"bytes":total_bytes,"limits":{"maps":MAX_MAPS,"texels":MAX_TEXELS,"fileBytes":MAX_FILE_BYTES,"totalBytes":MAX_TOTAL_BYTES}}))
+    };
+    let result = write();
+    if result.is_err() {
+        let _ = std::fs::remove_dir_all(destination);
+    }
+    result
+}
