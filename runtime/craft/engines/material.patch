@@ -0,0 +1,16 @@
+//! Private CPU engine. Customer operations belong to the durable Dobe runtime.
+#![forbid(unsafe_code)]
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+#[path = "main.rs"]
+mod cli;
+fn main() {
+    // Refuse before token lookup or any connection; never attach to an editor.
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.first().is_some_and(|arg| matches!(arg.as_str(), "mcp" | "serve"))
+        || args.iter().any(|arg| matches!(arg.split('=').next(), Some("--bridge" | "--port" | "--token")))
+    {
+        eprintln!("dobe-material: private engine has no editor connection or network server; use the product MCP");
+        std::process::exit(2);
+    }
+    cli::main();
+}
