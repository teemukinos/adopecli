@@ -0,0 +1,63 @@
+//! Shared, fail-closed raster counters across one full graph and its instances.
+//! These counters bound requested output pixels, not every temporary allocation.
+//! The durable worker additionally enforces process, memory, disk and time limits.
+use crate::NodeOutput;
+use materialcraft_core::Value;
+use std::sync::Mutex;
+
+#[derive(Default, Clone, serde::Serialize)]
+pub struct DobeUsage {
+    pub node_visits: u64,
+    pub output_texels: u64,
+}
+
+#[derive(Default)]
+pub struct DobeBudget {
+    usage: Mutex<DobeUsage>,
+}
+
+impl DobeBudget {
+    pub const MAX_NODE_TEXELS: u64 = 16_777_216;
+    pub const MAX_OUTPUT_TEXELS: u64 = 67_108_864;
+    pub const MAX_NODE_VISITS: u64 = 16_384;
+
+    pub fn usage(&self) -> DobeUsage {
+        self.usage.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone()
+    }
+
+    pub(crate) fn admit(&self, width: u32, height: u32, images: usize) -> Result<(), String> {
+        let pixels = u64::from(width).checked_mul(u64::from(height)).ok_or("Dobe raster budget overflow")?;
+        if images > 0 && pixels > Self::MAX_NODE_TEXELS {
+            return Err("Dobe node raster budget exceeded".into());
+        }
+        let charge = pixels.checked_mul(images as u64).ok_or("Dobe raster budget overflow")?;
+        let mut usage = self.usage.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        let visits = usage.node_visits.checked_add(1).ok_or("Dobe node budget overflow")?;
+        let total = usage.output_texels.checked_add(charge).ok_or("Dobe raster budget overflow")?;
+        if visits > Self::MAX_NODE_VISITS || total > Self::MAX_OUTPUT_TEXELS {
+            return Err("Dobe aggregate evaluation budget exceeded".into());
+        }
+        usage.node_visits = visits;
+        usage.output_texels = total;
+        Ok(())
+    }
+
+    pub fn finite_value(value: &Value) -> bool {
+        match value {
+            Value::Float(v) => v.is_finite(),
+            Value::Float2(v) => v.iter().all(|v| v.is_finite()),
+            Value::Float3(v) => v.iter().all(|v| v.is_finite()),
+            Value::Float4(v) | Value::Color(v) => v.iter().all(|v| v.is_finite()),
+            // Structured values are already admitted immutable authoring data;
+            // evaluated scalar/vector results use the cases above.
+            _ => true,
+        }
+    }
+
+    pub(crate) fn finite_output(output: &NodeOutput) -> bool {
+        match output {
+            NodeOutput::Image(image) => image.data.iter().all(|value| value.is_finite()),
+            NodeOutput::Value(value) => Self::finite_value(value),
+        }
+    }
+}
