index 0000000..9c3a18e
--- /dev/null
+++ b/crates/automation/src/dobe_preview.rs
@@ -0,0 +1,240 @@
+//! Bounded CPU previews from one qualified cook, without editor or preview state.
+use image::ImageEncoder;
+use materialcraft_engine::{Session, dobe_evaluate, eval, image::linear_to_srgb};
+use materialcraft_render::{Lighting, Maps, Relief, Scene, Settings};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+use std::io::Write;
+use std::path::Path;
+
+const MAX_PIXELS: u64 = 16_777_216;
+const MAX_SAMPLES: u64 = 67_108_864;
+const MAX_RAY_WORK: u64 = 1_073_741_824;
+const MAX_BYTES: usize = 64 << 20;
+const CHANNELS: [&str; 8] = ["baseColor", "normal", "roughness", "metallic", "height", "ambientOcclusion", "emissive", "opacity"];
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    view: String,
+    width: u32,
+    height: u32,
+    output: Option<String>,
+    look: Option<Look>,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Look {
+    scene: String,
+    environment: String,
+    yaw: f32,
+    pitch: f32,
+    distance: f32,
+    target: [f32; 3],
+    tiling: f32,
+    exposure: f32,
+    environment_rotation: f32,
+    normal_y_flip: bool,
+    show_environment: bool,
+    supersample: u32,
+    ao_rays: u32,
+    key_light: f32,
+    transparency: bool,
+    alpha_view: bool,
+    displacement: f32,
+    displacement_level: f32,
+    triangles: usize,
+    channels: BTreeMap<String, String>,
+}
+fn bounded(v: f32, lo: f32, hi: f32) -> bool {
+    v.is_finite() && lo <= v && v <= hi
+}
+
+pub fn render(session: &Session, index: usize, request: Request, destination: &Path) -> Result<Value, String> {
+    let pixels = u64::from(request.width) * u64::from(request.height);
+    if !(1..=4096).contains(&request.width) || !(1..=4096).contains(&request.height) || pixels > MAX_PIXELS {
+        return Err("Dobe preview dimensions exceed their budget".into());
+    }
+    let (samples, ray_work) = match (request.view.as_str(), request.output.as_ref(), request.look.as_ref()) {
+        ("2d", Some(name), None) if !name.is_empty() && name.len() <= 4096 => (pixels, 0),
+        ("3d", None, Some(o)) => {
+            if !["material_ball", "sphere", "cube", "rounded_cube", "cylinder", "torus", "plane", "crate", "udim_plane"].contains(&o.scene.as_str())
+                || !["studio", "contrast", "overcast", "sunset", "warehouse", "night"].contains(&o.environment.as_str())
+            {
+                return Err("Dobe preview scene or environment is unknown".into());
+            }
+            if !bounded(o.yaw, -360., 360.)
+                || !bounded(o.pitch, -89., 89.)
+                || !bounded(o.distance, 1.05, 50.)
+                || o.target.iter().any(|v| !bounded(*v, -10., 10.))
+                || !bounded(o.tiling, 0.1, 64.)
+                || !bounded(o.exposure, -16., 16.)
+                || !bounded(o.environment_rotation, -360., 360.)
+                || !bounded(o.key_light, 0., 16.)
+                || !bounded(o.displacement, 0., 0.5)
+                || !bounded(o.displacement_level, 0., 1.)
+                || !(1..=4).contains(&o.supersample)
+                || o.ao_rays > 32
+                || !(64..=2_000_000).contains(&o.triangles)
+                || o.channels.keys().any(|k| !CHANNELS.contains(&k.as_str()))
+                || o.channels.values().any(|v| v.is_empty() || v.len() > 4096)
+            {
+                return Err("Dobe preview settings are invalid or exceed their budget".into());
+            }
+            let samples = pixels * u64::from(o.supersample).pow(2);
+            // Eight transparent surfaces; each sample can cast AO and key rays.
+            let rays = samples * 8 * (1 + u64::from(o.ao_rays) + u64::from(o.key_light > 0.));
+            if samples > MAX_SAMPLES || rays > MAX_RAY_WORK {
+                return Err("Dobe preview sample or ray-work budget exceeded".into());
+            }
+            (samples, rays)
+        }
+        _ => return Err("Dobe preview requires exactly a 2d output or 3d look".into()),
+    };
+    let (cooked, evaluation) = dobe_evaluate::cook(session, index)?;
+    let graph = session.pkg.graphs.get(index).ok_or("Dobe preview graph is absent")?;
+    let outputs = eval::outputs(graph, &cooked);
+    let mut by_name = BTreeMap::new();
+    for (id, usage, name, image) in &outputs {
+        if by_name.insert(name.as_str(), (*id, *usage, *image)).is_some() {
+            return Err("Dobe preview output names are ambiguous".into());
+        }
+    }
+    let (rgba, selection, geometry) = if let Some(name) = request.output.as_ref() {
+        let (id, usage, image) = by_name.get(name.as_str()).ok_or("Dobe preview output is absent")?;
+        let image = image.ok_or("Dobe preview output is not a raster")?;
+        let resized = image.resize(request.width, request.height, true);
+        for pixel in resized.data.chunks_exact(if resized.is_gray() { 1 } else { 4 }) {
+            for (i, v) in pixel.iter().enumerate() {
+                if !v.is_finite() || (!resized.is_gray() && i < 3 && !linear_to_srgb(*v).is_finite()) {
+                    return Err("Dobe 2d preview contains nonfinite resized/display samples".into());
+                }
+            }
+        }
+        (resized.to_rgba8_display(), json!([{"identifier":name,"node":id.0,"usage":usage,"width":image.w,"height":image.h}]), Value::Null)
+    } else {
+        let o = request.look.as_ref().ok_or("Dobe preview look is absent")?;
+        let mut assigned = BTreeMap::new();
+        for channel in CHANNELS {
+            if let Some(name) = o.channels.get(channel) {
+                let (id, _, image) = by_name.get(name.as_str()).ok_or("Dobe preview channel output is absent")?;
+                assigned.insert(channel, (*id, name.as_str(), image.ok_or("Dobe preview channel output is not a raster")?));
+            } else {
+                let matches: Vec<_> = outputs
+                    .iter()
+                    .filter(|(_, usage, _, image)| {
+                        materialcraft_engine::core::MaterialChannel::from_id(usage).is_some_and(|c| c.id() == channel) && image.is_some()
+                    })
+                    .collect();
+                if matches.len() > 1 {
+                    return Err("Dobe preview usage is ambiguous; select an explicit channel output".into());
+                }
+                if let Some((id, _, name, Some(image))) = matches.first() {
+                    assigned.insert(channel, (*id, name.as_str(), *image));
+                }
+            }
+        }
+        if assigned.is_empty() {
+            return Err("Dobe preview has no assigned material channels".into());
+        }
+        // The native normal-map shader interprets encoded XYZ in [0,1].
+        if let Some((_, _, image)) = assigned.get("normal") {
+            if image
+                .data
+                .chunks_exact(if image.is_gray() { 1 } else { 4 })
+                .any(|pixel| pixel.iter().take(if image.is_gray() { 1 } else { 3 }).any(|v| !bounded(*v, 0., 1.)))
+            {
+                return Err("Dobe preview normal map must use encoded samples in [0,1]".into());
+            }
+        }
+        let maps = Maps::from_usages(assigned.iter().map(|(usage, (_, _, image))| (*usage, *image)));
+        let mesh = materialcraft_render::builtin_mesh(&o.scene);
+        if mesh.triangle_count() > o.triangles {
+            return Err("Dobe preview base mesh exceeds the triangle budget".into());
+        }
+        let base_triangles = mesh.triangle_count();
+        let scene = Scene::new(mesh);
+        if o.displacement > 0. {
+            let height = maps.height.as_ref().ok_or("Dobe preview displacement requires a height channel")?;
+            if height.data.chunks_exact(if height.is_gray() { 1 } else { 4 }).any(|pixel| {
+                pixel
+                    .iter()
+                    .take(if height.is_gray() { 1 } else { 3 })
+                    .any(|v| ((f64::from(*v) - f64::from(o.displacement_level)) * f64::from(o.displacement)).abs() > 8.)
+            }) {
+                return Err("Dobe preview displacement exceeds eight scene radii".into());
+            }
+            // Shared seam vertices accumulate height before dividing and
+            // scaling. Bound that intermediate even for a tiny depth value.
+            let sum_limit = f64::from(f32::MAX) / (o.triangles * 3) as f64 / 4.0;
+            if height
+                .data
+                .chunks_exact(if height.is_gray() { 1 } else { 4 })
+                .any(|pixel| pixel.iter().take(if height.is_gray() { 1 } else { 3 }).any(|v| f64::from(*v).abs() > sum_limit))
+            {
+                return Err("Dobe preview height exceeds finite displacement working range".into());
+            }
+        }
+        let displaced = scene.with_relief(&maps, Relief { depth: o.displacement, level: o.displacement_level }, o.tiling, o.triangles);
+        let selected = displaced.as_ref().unwrap_or(&scene);
+        if selected.mesh.triangle_count() > o.triangles
+            || !selected.radius.is_finite()
+            || selected.mesh.positions.iter().any(|v| !v.is_finite())
+            || selected.mesh.normals.iter().any(|v| !v.is_finite())
+            || selected.mesh.tangents.iter().any(|v| !v.is_finite())
+        {
+            return Err("Dobe preview geometry is nonfinite or oversized".into());
+        }
+        let settings = Settings {
+            yaw: o.yaw,
+            pitch: o.pitch,
+            distance: o.distance,
+            target: o.target,
+            tiling: o.tiling,
+            exposure: o.exposure,
+            env_rotation: o.environment_rotation,
+            normal_y_flip: o.normal_y_flip,
+            show_env: o.show_environment,
+            supersample: o.supersample,
+            ao_rays: o.ao_rays,
+            key_light: o.key_light,
+            transparency: o.transparency,
+            alpha_view: o.alpha_view,
+        };
+        let light = Lighting::new(&o.environment);
+        let rgba = materialcraft_render::preview::render_checked(selected, &maps, &light, &settings, request.width, request.height)?;
+        let selection: Vec<_> = assigned
+            .iter()
+            .map(|(channel, (id, name, image))| json!({"channel":channel,"identifier":name,"node":id.0,"width":image.w,"height":image.h}))
+            .collect();
+        (
+            rgba,
+            json!(selection),
+            json!({"baseTriangles":base_triangles,"triangles":selected.mesh.triangle_count(),"vertices":selected.mesh.positions.len(),"displaced":displaced.is_some()}),
+        )
+    };
+    if rgba.len() != pixels as usize * 4 {
+        return Err("Dobe preview pixel buffer has an unexpected size".into());
+    }
+    let mut png = Vec::new();
+    image::codecs::png::PngEncoder::new(&mut png)
+        .write_image(&rgba, request.width, request.height, image::ExtendedColorType::Rgba8)
+        .map_err(|e| e.to_string())?;
+    if png.len() > MAX_BYTES {
+        return Err("Dobe preview encoded image exceeds its budget".into());
+    }
+    std::fs::create_dir(destination).map_err(|e| format!("Dobe preview destination must be new: {e}"))?;
+    let write = || -> Result<(), String> {
+        let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(destination.join("preview.png")).map_err(|e| e.to_string())?;
+        file.write_all(&png).and_then(|_| file.sync_all()).map_err(|e| e.to_string())
+    };
+    if let Err(error) = write() {
+        let _ = std::fs::remove_dir_all(destination);
+        return Err(error);
+    }
+    Ok(json!({"evaluation":evaluation,"request":request,"selection":selection,"geometry":geometry,"file":"preview.png","bytes":png.len(),
+        "pixels":pixels,"samples":samples,"rayWork":ray_work,"finiteDisplaySamples":true,
+        "limits":{"pixels":MAX_PIXELS,"samples":MAX_SAMPLES,"rayWork":MAX_RAY_WORK,"bytes":MAX_BYTES}}))
+}
