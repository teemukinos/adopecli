+#[cfg(all(test, feature = "threads"))]
+mod job_completion_regression {
+    use super::*;
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    #[test]
+    fn flush_waits_for_stats_after_rows_are_published() {
+        let mut decoder = Decoder::with_threads(2);
+        let shared = decoder.shared.clone();
+        // Hold exactly the lock acquired after the last decoded row is visible.
+        // This forces the real run_job to pause before its result is committed.
+        let stats_lock = shared.stats.lock().unwrap();
+        let frame = Arc::new(Frame::new(1, 0, 1, 1));
+        decoder.dispatch(frame.clone(), Vec::new(), false);
+        frame.wait_complete();
+        let (sent, received) = mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            decoder.flush();
+            sent.send(()).unwrap();
+            decoder
+        });
+        let premature = received.recv_timeout(Duration::from_millis(100)).is_ok();
+        drop(stats_lock);
+        let decoder = worker.join().unwrap();
+        assert!(!premature, "flush returned after row publication but before picture statistics were committed");
+        assert_eq!(decoder.stats().pictures, 1);
+    }
+
+    #[test]
+    fn flush_waits_for_untracked_job_and_preserves_late_error() {
+        let mut decoder = Decoder::with_threads(2);
+        let shared = decoder.shared.clone();
+        let completion = JobCompletion::new(shared.clone());
+        let (release, wait) = mpsc::channel();
+        let job = std::thread::spawn(move || {
+            wait.recv().unwrap();
+            *shared.error.lock().unwrap() = Some(Error::Invalid("late decode failure".into()));
+            drop(completion);
+        });
+        // Completed rows can already have removed the frame from in_flight.
+        assert!(decoder.in_flight.is_empty());
+        let (sent, received) = mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            decoder.flush();
+            sent.send(()).unwrap();
+            decoder
+        });
+        let premature = received.recv_timeout(Duration::from_millis(100)).is_ok();
+        release.send(()).unwrap();
+        job.join().unwrap();
+        let mut decoder = worker.join().unwrap();
+        assert!(!premature, "flush ignored a job whose rows were no longer in flight");
+        assert!(decoder.take_error().unwrap().to_string().contains("late decode failure"));
+    }
+
+    #[test]
+    fn job_completion_is_released_on_unwind() {
+        let mut decoder = Decoder::with_threads(1);
+        let shared = decoder.shared.clone();
+        let caught = std::panic::catch_unwind(|| {
