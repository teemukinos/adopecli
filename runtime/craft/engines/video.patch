+/// Keep video presentation boundaries exact. A millisecond movie timebase truncates
+/// fractional-rate edit lists even when every media sample has the right duration.
+/// Prefer a common audio/video timebase. If its LCM exceeds a signed 32-bit value,
+/// use the largest video multiple, keeping audio rounding below one nanosecond.
+/// The container field is unsigned, but common players read it as signed.
+fn presentation_timescale(video: u32, audio: Option<u32>) -> Result<u32> {
+    const LIMIT: u32 = i32::MAX as u32;
+    if video == 0 || video > LIMIT {
+        return Err(ExportError::Unsupported("encoded video timebase exceeds interoperable MP4 timing".into()));
+    }
+    let Some(audio) = audio.filter(|rate| *rate > 0) else { return Ok(video) };
+    let (mut a, mut b) = (video, audio);
+    while b != 0 {
+        (a, b) = (b, a % b);
+    }
+    let lcm = u64::from(video / a) * u64::from(audio);
+    Ok(if lcm <= u64::from(LIMIT) { lcm as u32 } else { (LIMIT / video) * video })
