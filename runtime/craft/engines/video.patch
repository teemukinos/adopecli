diff --git a/apps/filmcraft-cli/src/owned_decode.rs b/apps/filmcraft-cli/src/owned_decode.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d816d3910c711dbb4806250a52821c5e5017fae1
--- /dev/null
+++ b/apps/filmcraft-cli/src/owned_decode.rs
@@ -0,0 +1,121 @@
+//! Private Dobe runtime protocol for complete owned H.264/AAC decoding.
+use std::fs::File;
+use std::io::Read;
+
+use filmcraft_codecs::owned_decode::{MAX_BYTES, Request, Span, VideoSample};
+use serde_json::{Value, json};
+
+fn read(path: &str, limit: usize) -> Result<Vec<u8>, String> {
+    let metadata = std::fs::symlink_metadata(path).map_err(|e| e.to_string())?;
+    if !metadata.is_file() || metadata.len() > limit as u64 {
+        return Err("owned decode requires a bounded regular file".into());
+    }
+    let file = File::open(path).map_err(|e| e.to_string())?;
+    let before = file.metadata().map_err(|e| e.to_string())?;
+    if !before.is_file() || before.len() > limit as u64 {
+        return Err("owned decode input changed before reading".into());
+    }
+    let mut bytes = Vec::new();
+    (&file).take(limit as u64 + 1).read_to_end(&mut bytes).map_err(|e| e.to_string())?;
+    let after = file.metadata().map_err(|e| e.to_string())?;
+    if bytes.len() > limit
+        || before.len() != after.len()
+        || bytes.len() as u64 != before.len()
+        || before.modified().map_err(|e| e.to_string())? != after.modified().map_err(|e| e.to_string())?
+    {
+        return Err("owned decode input changed while reading".into());
+    }
+    Ok(bytes)
+}
+
+fn unsigned(v: &Value) -> Result<u64, String> {
+    v.as_u64().ok_or_else(|| "owned decode requires unsigned integers".into())
+}
+
+fn small(v: &Value) -> Result<u32, String> {
+    u32::try_from(unsigned(v)?).map_err(|_| "owned decode integer exceeds u32".into())
+}
+
+fn signed(v: &Value) -> Result<i64, String> {
+    v.as_i64().ok_or_else(|| "owned decode requires signed integers".into())
+}
+
+fn array(v: &Value, maximum: usize) -> Result<&Vec<Value>, String> {
+    v.as_array().filter(|a| a.len() <= maximum).ok_or_else(|| "owned decode array exceeds its budget".into())
+}
+
+fn request(v: &Value) -> Result<Request, String> {
+    let keys =
+        ["schema", "width", "height", "frames", "rate_num", "rate_den", "media_start", "media_begin", "media_end", "avcc", "video", "audio_frames", "audio"];
+    let object = v.as_object().ok_or("owned decode manifest must be an object")?;
+    if object.len() != keys.len() || object.keys().any(|k| !keys.contains(&k.as_str())) || v["schema"] != 1 {
+        return Err("unsupported owned decode manifest".into());
+    }
+    let avcc = array(&v["avcc"], 65536)?
+        .iter()
+        .map(|b| u8::try_from(unsigned(b)?).map_err(|_| "invalid configuration byte".into()))
+        .collect::<Result<Vec<_>, String>>()?;
+    let mut video = Vec::new();
+    for row in array(&v["video"], 600)? {
+        let fields = array(row, 4)?;
+        if fields.len() != 4 {
+            return Err("invalid owned picture sample".into());
+        }
+        video.push(VideoSample {
+            span: Span { offset: unsigned(&fields[0])?, size: small(&fields[1])? },
+            pts: signed(&fields[2])?,
+            sync: fields[3].as_bool().ok_or("invalid owned sync flag")?,
+        });
+    }
+    let mut audio = Vec::new();
+    for row in array(&v["audio"], 32769)? {
+        let fields = array(row, 2)?;
+        if fields.len() != 2 {
+            return Err("invalid owned audio sample".into());
+        }
+        audio.push(Span { offset: unsigned(&fields[0])?, size: small(&fields[1])? });
+    }
+    Ok(Request {
+        width: small(&v["width"])?,
+        height: small(&v["height"])?,
+        frames: small(&v["frames"])?,
+        rate_num: small(&v["rate_num"])?,
+        rate_den: small(&v["rate_den"])?,
+        media_start: signed(&v["media_start"])?,
+        media_begin: unsigned(&v["media_begin"])?,
+        media_end: unsigned(&v["media_end"])?,
+        avcc,
+        video,
+        audio_frames: if v["audio_frames"].is_null() { None } else { Some(unsigned(&v["audio_frames"])?) },
+        audio,
+    })
+}
+
+pub fn inspect(path: &str, manifest: &str) -> Result<Value, String> {
+    let raw = read(manifest, 4 << 20)?;
+    let value: Value = serde_json::from_slice(&raw).map_err(|e| e.to_string())?;
+    let request = request(&value)?;
+    let bytes = read(path, MAX_BYTES)?;
+    let report = filmcraft_codecs::owned_decode::inspect(&bytes, &request).map_err(|e| e.to_string())?;
+    Ok(json!({"schema": 1, "bytes": bytes.len(), "complete_decode_verified": true,
+        "decoder": "native-software-h264-aac", "threads": 2,
+        "pictures": report.pictures.iter().map(|(pts, hash)| json!({"pts": pts, "yuv_fnv1a64": format!("{hash:016x}")})).collect::<Vec<_>>(),
+        "macroblocks": report.macroblocks, "audio_packets": report.audio_packets,
+        "decoded_audio_frames": report.decoded_audio_frames, "presented_audio_frames": report.presented_audio_frames,
+        "audio_fnv1a64": format!("{:016x}", report.audio_fnv1a64), "audio_peak": report.audio_peak}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hostile_manifest_shapes_are_errors() {
+        for value in [Value::Null, json!([]), json!({"schema":1}), json!({"schema":2})] {
+            assert!(std::panic::catch_unwind(|| request(&value)).expect("no panic").is_err());
+        }
+        for value in [json!(-1), json!(true), json!("1"), json!(1.5), json!(u64::MAX)] {
+            assert!(small(&value).is_err());
+        }
+    }
+}
