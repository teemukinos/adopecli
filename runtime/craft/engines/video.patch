new file mode 100644
index 0000000000000000000000000000000000000000..210ac4ca6c8b95d89596caab7c9625222bd376ce
--- /dev/null
+++ b/crates/codecs/src/owned_decode.rs
@@ -0,0 +1,302 @@
+//! Complete software decoding of an owned, previously inspected H.264/AAC output.
+//!
+//! The caller supplies bounded sample spans from its container inspector. This
+//! layer independently checks those spans and decodes every packet, including
+//! priming and padding. It must not use playback sources: those conceal failures.
+
+use std::collections::BTreeMap;
+
+use filmcraft_bitstream::unescape_rbsp;
+use filmcraft_h264::{Decoder, Picture, params::Sps};
+
+use crate::{CodecError, Result};
+
+pub const MAX_BYTES: usize = 512 << 20;
+const MAX_SAMPLES: usize = 40000;
+const OFFSET: u64 = 0xcbf29ce484222325;
+const PRIME: u64 = 0x100000001b3;
+
+#[derive(Clone, Debug)]
+pub struct Span {
+    pub offset: u64,
+    pub size: u32,
+}
+
+#[derive(Clone, Debug)]
+pub struct VideoSample {
+    pub span: Span,
+    pub pts: i64,
+    pub sync: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct Request {
+    pub width: u32,
+    pub height: u32,
+    pub frames: u32,
+    pub rate_num: u32,
+    pub rate_den: u32,
+    pub media_start: i64,
+    pub media_begin: u64,
+    pub media_end: u64,
+    pub avcc: Vec<u8>,
+    pub video: Vec<VideoSample>,
+    pub audio_frames: Option<u64>,
+    pub audio: Vec<Span>,
+}
+
+#[derive(Debug)]
+pub struct Report {
+    /// Presentation-ordered (raw PTS, visible Y/U/V FNV-1a checksum).
+    pub pictures: Vec<(i64, u64)>,
+    pub macroblocks: u64,
+    pub audio_packets: usize,
+    pub decoded_audio_frames: u64,
+    pub presented_audio_frames: u64,
+    /// FNV-1a over interleaved stereo f32 little-endian presentation samples.
+    /// Diagnostic only; the runtime binds the inspected file with SHA-256.
+    pub audio_fnv1a64: u64,
+    pub audio_peak: f32,
+}
+
+fn ensure(ok: bool, message: &str) -> Result<()> {
+    if ok { Ok(()) } else { Err(CodecError::Decode(format!("owned video: {message}"))) }
+}
+
+fn bytes<'a>(file: &'a [u8], span: &Span) -> Result<&'a [u8]> {
+    let begin = usize::try_from(span.offset).map_err(|_| CodecError::Decode("sample offset overflows".into()))?;
+    let end = begin.checked_add(span.size as usize).ok_or_else(|| CodecError::Decode("sample length overflows".into()))?;
+    file.get(begin..end).ok_or_else(|| CodecError::Decode("sample lies outside owned file".into()))
+}
+
+fn validate(file: &[u8], r: &Request) -> Result<()> {
+    ensure((16..=MAX_BYTES).contains(&file.len()), "file byte budget exceeded")?;
+    ensure((2..=32768).contains(&r.width) && (2..=32768).contains(&r.height) && r.width.is_multiple_of(2) && r.height.is_multiple_of(2), "invalid dimensions")?;
+    let pixels = u64::from(r.width) * u64::from(r.height);
+    ensure((1..=600).contains(&r.frames) && pixels <= 16777216 && pixels * u64::from(r.frames) <= 552960000, "pixel/frame budget exceeded")?;
+    ensure(
+        r.rate_den > 0 && r.rate_num <= i32::MAX as u32 && r.rate_num >= r.rate_den && u64::from(r.rate_num) <= 240 * u64::from(r.rate_den),
+        "invalid exact frame rate",
+    )?;
+    ensure(r.video.len() == r.frames as usize && r.audio.len() + r.video.len() <= MAX_SAMPLES, "invalid sample count")?;
+    ensure((0..=1_i64 << 40).contains(&r.media_start) && (7..=65536).contains(&r.avcc.len()), "invalid configuration or media start")?;
+    ensure(r.media_begin < r.media_end && r.media_end <= file.len() as u64, "invalid media extent")?;
+    let mut spans: Vec<&Span> = r.video.iter().map(|s| &s.span).chain(&r.audio).collect();
+    spans.sort_unstable_by_key(|s| s.offset);
+    let mut next = r.media_begin;
+    for span in spans {
+        ensure(span.size > 0 && span.offset == next, "sample bytes overlap or leave gaps")?;
+        next = next.checked_add(u64::from(span.size)).ok_or_else(|| CodecError::Decode("sample extent overflows".into()))?;
+        ensure(next <= r.media_end, "sample exceeds media extent")?;
+    }
+    ensure(next == r.media_end, "unclaimed media tail")?;
+    let mut timestamps: Vec<i64> = r.video.iter().map(|s| s.pts).collect();
+    timestamps.sort_unstable();
+    ensure(timestamps.iter().enumerate().all(|(i, &pts)| pts == r.media_start + i as i64 * i64::from(r.rate_den)), "unexpected picture timestamps")?;
+    match r.audio_frames {
+        None => ensure(r.audio.is_empty(), "unexpected audio samples")?,
+        Some(n) => {
+            ensure((1..=33554432).contains(&n) && r.audio.len() as u64 == n.div_ceil(1024) + 1, "invalid AAC sample count or padding")?;
+            // A native partial-range WAV may end one sample either side of the
+            // floor-rounded picture duration. Preserve that explicit endpoint.
+            let picture_samples = u64::from(r.frames) * u64::from(r.rate_den) * 48000 / u64::from(r.rate_num);
+            ensure(n.abs_diff(picture_samples) <= 1, "audio endpoint disagrees with picture duration")?;
+        }
+    }
+    Ok(())
+}
+
+fn hash(digest: &mut u64, data: &[u8]) {
+    for byte in data {
+        *digest = (*digest ^ u64::from(*byte)).wrapping_mul(PRIME);
+    }
+}
+
+fn picture(p: Picture, r: &Request, expected: &BTreeMap<i64, bool>, seen: &mut BTreeMap<i64, u64>) -> Result<()> {
+    ensure(p.width == r.width && p.height == r.height && !p.draft, "decoder changed picture dimensions or used draft mode")?;
+    ensure(p.chroma_width == r.width / 2 && p.chroma_height == r.height / 2, "decoder changed chroma shape")?;
+    ensure(expected.get(&p.pts) == Some(&p.key) && !seen.contains_key(&p.pts), "decoder repeated or changed a picture timestamp/key flag")?;
+    ensure(!p.color.full_range && p.color.primaries == 1 && p.color.transfer == 1 && p.color.matrix == 1, "decoded color signal is not limited-range Rec.709")?;
+    ensure(matches!(p.sar, (0, 0) | (1, 1)), "decoded pixel aspect is not square")?;
+    let mut digest = OFFSET;
+    for (plane, stride, width, height) in
+        [(&p.y, p.y_stride, p.width, p.height), (&p.u, p.uv_stride, p.chroma_width, p.chroma_height), (&p.v, p.uv_stride, p.chroma_width, p.chroma_height)]
+    {
+        let (width, height) = (width as usize, height as usize);
+        ensure(stride >= width && stride <= width.div_ceil(16) * 16 && plane.len() == stride * height, "decoded plane shape is invalid")?;
+        for row in plane.chunks_exact(stride) {
+            hash(&mut digest, &row[..width]);
+        }
+    }
+    seen.insert(p.pts, digest);
+    Ok(())
+}
+
+pub fn inspect(file: &[u8], r: &Request) -> Result<Report> {
+    validate(file, r)?;
+    let config = filmcraft_isobmff::AvcConfig::parse(&r.avcc).map_err(|e| CodecError::Decode(e.to_string()))?;
+    ensure(config.length_size == 4 && !config.sps.is_empty() && !config.pps.is_empty(), "invalid AVC parameter sets")?;
+    // Bound coded surfaces before configuring the decoder, not after allocation.
+    // In-band parameter changes are refused below, so every picture uses this bound.
+    let mut macroblocks_per_picture = 0;
+    for nal in &config.sps {
+        ensure(nal.first().is_some_and(|h| h & 0x9f == 7), "invalid SPS NAL")?;
+        let rbsp = unescape_rbsp(nal.get(1..).ok_or_else(|| CodecError::Decode("missing SPS".into()))?);
+        let sps = Sps::parse(&rbsp).map_err(|e| CodecError::Decode(e.to_string()))?;
+        sps.check_supported().map_err(|e| CodecError::Decode(e.to_string()))?;
+        let (_, _, width, height) = sps.crop_rect();
+        ensure(
+            width == r.width && height == r.height && sps.width() == r.width.div_ceil(16) * 16 && sps.height() == r.height.div_ceil(16) * 16,
+            "SPS surface differs from requested picture",
+        )?;
+        ensure(!sps.gaps_in_frame_num_allowed, "SPS permits missing reference frames")?;
+        macroblocks_per_picture = u64::from(sps.pic_width_in_mbs) * u64::from(sps.frame_height_in_mbs());
+    }
+    let mut decoder = Decoder::with_threads(2);
+    decoder.configure_avcc(&r.avcc).map_err(|e| CodecError::Decode(e.to_string()))?;
+    let expected: BTreeMap<i64, bool> = r.video.iter().map(|s| (s.pts, s.sync)).collect();
+    let mut seen = BTreeMap::new();
+    let mut nal_count = 0usize;
+    for sample in &r.video {
+        let data = bytes(file, &sample.span)?;
+        let mut vcl = false;
+        let mut idr = false;
+        let mut remaining = data;
+        while !remaining.is_empty() {
+            // Count before the decoder's NAL vector allocation. Empty NALs must
+            // not turn a bounded file into hundreds of millions of entries.
+            nal_count += 1;
+            ensure(nal_count <= 1000000 && remaining.len() >= 5, "NAL budget or framing exceeded")?;
+            let length = u32::from_be_bytes([remaining[0], remaining[1], remaining[2], remaining[3]]) as usize;
+            remaining = &remaining[4..];
+            ensure(length > 0 && length <= remaining.len(), "NAL payload exceeds its sample")?;
+            let nal = &remaining[..length];
+            remaining = &remaining[length..];
+            let header = nal.first().copied().ok_or_else(|| CodecError::Decode("empty NAL".into()))?;
+            ensure(header & 128 == 0, "forbidden NAL bit")?;
+            match header & 31 {
+                1 | 5 => {
+                    vcl = true;
+                    idr |= header & 31 == 5;
+                }
+                7 => ensure(config.sps.iter().any(|s| s == nal), "in-band SPS changed")?,
+                8 => ensure(config.pps.iter().any(|s| s == nal), "in-band PPS changed")?,
+                6 | 9 | 12 => {}
+                _ => return Err(CodecError::Decode("unsupported owned NAL type".into())),
+            }
+        }
+        ensure(vcl && idr == sample.sync, "picture and sync metadata disagree")?;
+        for p in decoder.decode(data, sample.pts).map_err(|e| CodecError::Decode(e.to_string()))? {
+            picture(p, r, &expected, &mut seen)?;
+        }
+    }
+    for p in decoder.flush() {
+        picture(p, r, &expected, &mut seen)?;
+    }
+    if let Some(error) = decoder.take_error() {
+        return Err(CodecError::Decode(error.to_string()));
+    }
+    let stats = decoder.stats();
+    let macroblocks =
+        stats.mb_i4x4 + stats.mb_i8x8 + stats.mb_i16x16 + stats.mb_pcm + stats.mb_p_skip + stats.mb_b_skip + stats.mb_b_direct16x16 + stats.mb_inter;
+    ensure(
+        seen.len() == r.frames as usize && stats.pictures == u64::from(r.frames) && stats.frame_num_gaps == 0 && stats.draft_pictures == 0,
+        "incomplete or concealed picture decoding",
+    )?;
+    ensure(macroblocks == macroblocks_per_picture * u64::from(r.frames), "incomplete decoded macroblocks")?;
+    drop(decoder);
+
+    let mut decoded = 0u64;
+    let mut presented = 0u64;
+    let mut audio_hash = OFFSET;
+    let mut peak = 0.0f32;
+    if let Some(frames) = r.audio_frames {
+        // Fixed AAC-LC stereo/48 kHz configuration, already checked in the container.
+        // Use the raw native decoder, never a fallback or a playback concealment path.
+        let mut audio = craft_audio::aac::Decoder::new(&[0x11, 0x90]).map_err(|e| CodecError::Decode(e.to_string()))?;
+        for span in &r.audio {
+            let channels = audio.decode(bytes(file, span)?).map_err(|e| CodecError::Decode(e.to_string()))?;
+            ensure(
+                channels.len() == 2 && channels.iter().all(|c| c.len() == 1024 && c.iter().all(|v| v.is_finite())),
+                "AAC output shape or samples are invalid",
+            )?;
+            ensure(audio.sample_rate() == 48000 && audio.channels() == 2 && !audio.sbr(), "AAC changed its declared configuration")?;
+            // Shape was checked above; index only the complete bounded output.
+            for i in 0..1024 {
+                if (1024..1024 + frames).contains(&(decoded + i as u64)) {
+                    for channel in &channels {
+                        let value = channel[i];
+                        hash(&mut audio_hash, &value.to_le_bytes());
+                        peak = peak.max(value.abs());
+                    }
+                    presented += 1;
+                }
+            }
+            decoded += 1024;
+        }
+        ensure(presented == frames, "AAC presentation is incomplete")?;
+    }
+    Ok(Report {
+        pictures: seen.into_iter().collect(),
+        macroblocks,
+        audio_packets: r.audio.len(),
+        decoded_audio_frames: decoded,
+        presented_audio_frames: presented,
+        audio_fnv1a64: audio_hash,
+        audio_peak: peak,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn request() -> Request {
+        Request {
+            width: 2,
+            height: 2,
+            frames: 1,
+            rate_num: 24,
+            rate_den: 1,
+            media_start: 0,
+            media_begin: 8,
+            media_end: 16,
+            avcc: vec![0; 7],
+            video: vec![VideoSample { span: Span { offset: 8, size: 8 }, pts: 0, sync: true }],
+            audio_frames: None,
+            audio: vec![],
+        }
+    }
+
+    #[test]
+    fn hostile_manifest_limits_precede_codec_configuration() {
+        let file = [0; 16];
+        for field in 0..9 {
+            let mut r = request();
+            match field {
+                0 => r.width = u32::MAX,
+                1 => r.height = 1,
+                2 => r.frames = 601,
+                3 => r.rate_den = 0,
+                4 => r.media_start = i64::MAX,
+                5 => r.video[0].span.offset = u64::MAX,
+                6 => r.video[0].span.size = u32::MAX,
+                7 => r.video[0].pts = i64::MIN,
+                _ => r.audio_frames = Some(u64::MAX),
+            }
+            assert!(std::panic::catch_unwind(|| inspect(&file, &r)).expect("must not panic").is_err());
+        }
+    }
+
+    #[test]
+    fn complete_span_ownership_is_required() {
+        let file = [0; 16];
+        assert!(validate(&file, &request()).is_ok());
+        let mut r = request();
+        r.video[0].span.offset = 9;
+        assert!(validate(&file, &r).is_err());
+        r = request();
+        r.video[0].span.size = 7;
+        assert!(validate(&file, &r).is_err());
+    }
+}
