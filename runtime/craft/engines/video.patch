+/// Inspect the exact renderer layout for the supported static title profile.
+/// Animated text must be inspected across its timeline; one snapshot cannot qualify it.
+fn text_diagnostics(s: &Session, clip: ClipId) -> Result<Value> {
+    let cmd = "graphics.textDiagnostics";
+    let seq = s.active_sequence().ok_or(EngineError::NoSequence)?;
+    let (_, it) = seq.find_item(clip).ok_or_else(|| bad(cmd, "no such clip"))?;
+    if it.duration.0 <= 0 || it.effects.len() > 32 {
+        return Err(bad(cmd, "invalid title duration or excessive effects"));
+    }
+    let size = match s.project.item(it.item).map(|p| &p.kind) {
+        Some(ItemKind::Graphic { width, height, .. }) => (*width, *height),
+        _ => return Err(bad(cmd, "requires a graphic clip")),
+    };
+    let indices = layer_indices(&it.effects);
+    if indices.len() != 1 {
+        return Err(bad(cmd, "requires exactly one static text layer"));
+    }
+    let effect = it.effects.get(indices[0]).ok_or_else(|| bad(cmd, "missing layer"))?;
+    if effect.params.values().any(Param::is_animated) {
+        return Err(bad(cmd, "animated title parameters are not qualified"));
+    }
