+/// Decode an owned still raster for the maintained worker. This uses the same
+/// decoder as picture rendering, with tighter limits before any pixel allocation.
+#[cfg(feature = "dobe")]
+pub fn dobe_picture(bytes: &[u8]) -> Result<image::RgbaImage, String> {
+    if bytes.is_empty() || bytes.len() > 16 << 20 {
+        return Err("picture exceeds encoded byte budget".into());
+    }
+    let reader = image::ImageReader::new(std::io::Cursor::new(bytes)).with_guessed_format().map_err(|e| e.to_string())?;
+    if !matches!(reader.format(), Some(image::ImageFormat::Png | image::ImageFormat::Jpeg)) {
+        return Err("picture requires PNG or JPEG".into());
+    }
+    let (width, height) = reader.into_dimensions().map_err(|e| e.to_string())?;
+    if width > 8192 || height > 8192 || !fits(width, height, 64 << 20) {
+        return Err("picture exceeds pixel budget".into());
+    }
+    decode_raster(bytes, 64 << 20).ok_or_else(|| "picture cannot be decoded".into())
+}
