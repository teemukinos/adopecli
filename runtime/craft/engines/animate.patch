+        assert!(limited(Work::Walk, 1).run(|| checked.project(Vec2::ZERO)).is_err());
+        assert!(limited(Work::Walk, 1).run(|| checked.tail(5.0)).is_err());
+        let points = [Vec2::ZERO, Vec2::new(10.0, 0.0), Vec2::new(10.0, 10.0)];
+        assert_eq!(Budget::default().run(|| PathWalk::new(&points)).unwrap(), PathWalk::new(&points));
+        assert!(limited(Work::Walk, 8).run(|| PathWalk::new(&points)).is_err());
+        let walk = PathWalk::new(&points).unwrap();
+        assert!(limited(Work::Walk, 2).run(|| walk.project(Vec2::ZERO)).is_err());
