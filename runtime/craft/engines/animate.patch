@@ -0,0 +1,17 @@
+//! Private headless entry. Never delegates to the desktop app.
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let result = if args.iter().any(|arg| arg == "--screenshot") {
+        Err("Dobe Animate does not open an editor or screenshot window".to_string())
+    } else {
+        anicraft_cli::run(&args)
+    };
+    match result {
+        Ok(output) if !output.is_empty() => println!("{output}"),
+        Ok(_) => {}
+        Err(error) => {
+            eprintln!("error: {error}");
+            std::process::exit(1);
+        }
+    }
+}
