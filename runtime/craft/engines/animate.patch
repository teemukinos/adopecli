+    fn curve_walk_refuses_native_segment_truncation() {
+        let mut path = Path::new();
+        path.move_to(Vec2::ZERO);
+        for i in 1..=10_001 {
+            path.line_to(Vec2::new(i as f32, 0.0));
+        }
+        assert!(CurveWalk::new(&path).is_some());
+        assert_eq!(Budget::default().run(|| CurveWalk::new(&path)).unwrap_err(), "native curve walking would truncate its segments");
+    }
+}
