+//! Complete-file qualification for automation. The interactive importer remains
+//! tolerant of damaged tails; this entry refuses discarded bytes/frames instead.
+//! Uses the same native decoders, with explicit finite-sample and sample budgets.
+use crate::{AudioError, Collector, Format, MAX_RATE, MAX_SAMPLES, MIN_RATE, Pcm};
+
+const MAX_BYTES: usize = 32 << 20;
+
+fn u16_at(data: &[u8], at: usize) -> Result<u16, AudioError> {
+    let bytes = data.get(at..at + 2).ok_or(AudioError::Unreadable)?;
+    Ok(u16::from_le_bytes(bytes.try_into().map_err(|_| AudioError::Unreadable)?))
+}
+fn u32_at(data: &[u8], at: usize) -> Result<u32, AudioError> {
+    let bytes = data.get(at..at + 4).ok_or(AudioError::Unreadable)?;
+    Ok(u32::from_le_bytes(bytes.try_into().map_err(|_| AudioError::Unreadable)?))
+}
+fn u64_at(data: &[u8], at: usize) -> Result<u64, AudioError> {
+    let bytes = data.get(at..at + 8).ok_or(AudioError::Unreadable)?;
+    Ok(u64::from_le_bytes(bytes.try_into().map_err(|_| AudioError::Unreadable)?))
+}
+fn finite(samples: &[f32]) -> Result<(), AudioError> {
+    if samples.iter().all(|v| v.is_finite()) { Ok(()) } else { Err(AudioError::Unreadable) }
+}
+
+/// Decode a complete bounded file without the tolerant importer's tail recovery.
+/// This checks container/frame completeness, not perceptual fidelity or provenance.
+/// Returned samples retain the native first-two-channel and gapless policies.
+pub fn decode_complete(data: &[u8], max_samples: usize) -> Result<Pcm, AudioError> {
+    if data.len() > MAX_BYTES || max_samples == 0 || max_samples > MAX_SAMPLES {
+        return Err(AudioError::TooLong);
+    }
+    crate::guarded(|| match Format::sniff(data).ok_or(AudioError::UnknownFormat)? {
+        Format::Wav => wav(data, max_samples),
+        Format::Vorbis => vorbis(data, max_samples),
+        Format::Mp3 => mp3(data, max_samples),
+    })
+}
+
+fn wav(data: &[u8], max_samples: usize) -> Result<Pcm, AudioError> {
+    let declared = u32_at(data, 4)?;
+    // A streamed WAV may use a sentinel. Its actual bytes must still form whole
+    // chunks/frames; a sentinel data chunk extends exactly to the physical EOF.
+    if declared != 0 && declared != u32::MAX && declared as usize + 8 != data.len() {
+        return Err(AudioError::Unreadable);
+    }
+    let mut at = 12;
+    let mut format = None;
+    let mut body = None;
+    let mut count = 0;
+    while at < data.len() {
+        count += 1;
+        if count > 256 {
+            return Err(AudioError::Unreadable);
+        }
+        let tag = data.get(at..at + 4).ok_or(AudioError::Unreadable)?;
+        let length = u32_at(data, at + 4)?;
+        let start = at + 8;
+        let streamed = tag == b"data" && (length == 0 || length == u32::MAX);
+        let end = if streamed { data.len() } else { start.checked_add(length as usize).ok_or(AudioError::Unreadable)? };
+        let chunk = data.get(start..end).ok_or(AudioError::Unreadable)?;
+        if tag == b"fmt " {
+            if format.is_some() || !(16..=128).contains(&chunk.len()) {
+                return Err(AudioError::Unreadable);
+            }
+            format = Some(chunk);
+        } else if tag == b"data" {
+            if body.is_some() {
+                return Err(AudioError::Unreadable);
+            }
+            body = Some(chunk);
+        }
+        at = end + if streamed { 0 } else { length as usize & 1 };
+        if at > data.len() {
+            return Err(AudioError::Unreadable);
+        }
+    }
+    let fmt = format.ok_or(AudioError::Unreadable)?;
+    let body = body.ok_or(AudioError::Empty)?;
+    let mut tag = u16_at(fmt, 0)?;
+    if tag == 0xfffe {
+        if u16_at(fmt, 16)? < 22 || fmt.get(26..40) != Some(&[0, 0, 0, 0, 16, 0, 128, 0, 0, 170, 0, 56, 155, 113]) {
+            return Err(AudioError::Unreadable);
+        }
+        tag = u16_at(fmt, 24)?;
+    }
+    let channels = usize::from(u16_at(fmt, 2)?);
+    let rate = u32_at(fmt, 4)?;
+    let bits = u16_at(fmt, 14)?;
+    if !(1..=32).contains(&channels) || !(MIN_RATE..=MAX_RATE).contains(&rate) {
+        return Err(AudioError::Unreadable);
+    }
+    let width = match (tag, bits) {
+        (1, 8) => 1,
+        (1, 16) => 2,
+        (1, 24) => 3,
+        (1 | 3, 32) => 4,
+        (3, 64) => 8,
+        _ => return Err(AudioError::Unreadable),
+    };
+    let block = usize::from(u16_at(fmt, 12)?).max(width * channels);
+    let frames = body.len() / block;
+    if body.len() % block != 0 {
+        return Err(AudioError::Unreadable);
+    }
+    if frames * channels.min(2) > max_samples {
+        return Err(AudioError::TooLong);
+    }
+    // Pcm::new replaces nonfinite values. Detect them before that repair,
+    // including finite f64 values which overflow when converted to f32.
+    if tag == 3 {
+        for frame in body.chunks_exact(block) {
+            for sample in frame.chunks_exact(block / channels).take(channels.min(2)) {
+                let value = if width == 4 { f32::from_bits(u32_at(sample, 0)?) } else { f64::from_bits(u64_at(sample, 0)?) as f32 };
+                if !value.is_finite() {
+                    return Err(AudioError::Unreadable);
+                }
+            }
+        }
+    }
+    crate::wav::decode(data)
+}
+
+/// Verify every Ogg page, including its CRC, sequence, packet-continuation flags
+/// and physical EOS. Chained streams are refused instead of retaining one part.
+fn ogg_pages(data: &[u8]) -> Result<(), AudioError> {
+    let mut at = 0;
+    let mut serial = None;
+    let mut sequence = 0u32;
+    let mut pending = false;
+    let mut ended = false;
+    let mut granule = 0;
+    while at < data.len() {
+        if ended || sequence >= 65536 {
+            return Err(AudioError::Unreadable);
+        }
+        let header = data.get(at..at + 27).ok_or(AudioError::Unreadable)?;
+        if header.get(..5) != Some(b"OggS\0") {
+            return Err(AudioError::Unreadable);
+        }
+        let flags = *header.get(5).ok_or(AudioError::Unreadable)?;
+        if flags & !7 != 0 || (flags & 2 != 0) != (sequence == 0) || (flags & 1 != 0) != pending {
+            return Err(AudioError::Unreadable);
+        }
+        let id = u32_at(header, 14)?;
+        if serial.is_some_and(|s| s != id) || u32_at(header, 18)? != sequence {
+            return Err(AudioError::Unreadable);
+        }
+        serial = Some(id);
+        let segments = usize::from(*header.get(26).ok_or(AudioError::Unreadable)?);
+        let lacing = data.get(at + 27..at + 27 + segments).ok_or(AudioError::Unreadable)?;
+        let size: usize = lacing.iter().map(|&n| usize::from(n)).sum();
+        let end = at + 27 + segments + size;
+        let page = data.get(at..end).ok_or(AudioError::Unreadable)?;
+        let mut crc = 0u32;
+        for (i, &byte) in page.iter().enumerate() {
+            crc ^= u32::from(if (22..26).contains(&i) { 0 } else { byte }) << 24;
+            for _ in 0..8 {
+                crc = if crc & 0x80000000 != 0 { (crc << 1) ^ 0x04c11db7 } else { crc << 1 };
+            }
+        }
+        if crc != u32_at(header, 22)? {
+            return Err(AudioError::Unreadable);
+        }
+        if let Some(&last) = lacing.last() {
+            pending = last == 255;
+        }
+        let next = u64_at(header, 6)?;
+        if next != u64::MAX {
+            if next < granule {
+                return Err(AudioError::Unreadable);
+            }
+            granule = next;
+        }
+        ended = flags & 4 != 0;
+        if ended && pending {
+            return Err(AudioError::Unreadable);
+        }
+        at = end;
+        sequence += 1;
+    }
+    if !ended || pending {
+        return Err(AudioError::Unreadable);
+    }
+    Ok(())
+}
+
+fn vorbis(data: &[u8], max_samples: usize) -> Result<Pcm, AudioError> {
+    ogg_pages(data)?;
+    let mut reader = lewton::inside_ogg::OggStreamReader::new(std::io::Cursor::new(data)).map_err(|_| AudioError::Unreadable)?;
+    let rate = reader.ident_hdr.audio_sample_rate;
+    if !(MIN_RATE..=MAX_RATE).contains(&rate) {
+        return Err(AudioError::Unreadable);
+    }
+    let mut collector = Collector::new(usize::from(reader.ident_hdr.audio_channels));
+    loop {
+        match reader.read_dec_packet_generic::<lewton::samples::InterleavedSamples<f32>>() {
+            Ok(Some(packet)) => {
+                if packet.channel_count != collector.channels {
+                    return Err(AudioError::Unreadable);
+                }
+                finite(&packet.samples)?;
+                let additional = packet.samples.len() / collector.channels * usize::from(collector.out_channels());
+                if collector.samples.len() + additional > max_samples {
+                    return Err(AudioError::TooLong);
+                }
+                collector.push(&packet.samples)?;
+            }
+            Ok(None) => break,
+            Err(_) => return Err(AudioError::Unreadable),
+        }
+    }
+    Pcm::new(rate, collector.out_channels(), collector.samples)
+}
+
+fn mp3(data: &[u8], max_samples: usize) -> Result<Pcm, AudioError> {
+    let stream = nanomp3::strip_tags(data);
+    let mut end = 0;
+    let mut format = None;
+    let mut count = 0u32;
+    let mut frames = 0usize;
+    let mut vbr = None;
+    let mut decoder = nanomp3::Decoder::new();
+    let mut samples = [0f32; nanomp3::MAX_SAMPLES_PER_FRAME];
+    for frame in nanomp3::frames(stream) {
+        if frame.offset != end {
+            return Err(AudioError::Unreadable);
+        }
+        end += frame.data.len();
+        let current = (frame.sample_rate, frame.channels, frame.layer);
+        if format.is_some_and(|f| f != current) {
+            return Err(AudioError::Unreadable);
+        }
+        format = Some(current);
+        if count == 0 {
+            vbr = nanomp3::VbrTag::parse(frame.data);
+        }
+        count += 1;
+        if count == 1 && vbr.is_some() {
+            continue;
+        }
+        let remaining = stream.get(frame.offset..).ok_or(AudioError::Unreadable)?;
+        let (consumed, result) = decoder.decode(remaining, &mut samples);
+        let info = result.map_err(|_| AudioError::Unreadable)?;
+        if consumed != frame.data.len() || info.samples_produced != frame.samples {
+            return Err(AudioError::Unreadable);
+        }
+        finite(samples.get(..info.samples_produced * usize::from(info.channels.num())).ok_or(AudioError::Unreadable)?)?;
+        frames = frames.checked_add(info.samples_produced).ok_or(AudioError::TooLong)?;
+        if frames * usize::from(info.channels.num()) > MAX_SAMPLES + 16384 {
+            return Err(AudioError::TooLong);
+        }
+    }
+    if end != stream.len() || count == 0 {
+        return Err(AudioError::Unreadable);
+    }
+    if let Some(tag) = vbr {
+        if tag.frames.is_some_and(|n| n != count - 1) {
+            return Err(AudioError::Unreadable);
+        }
+        if tag.frames.is_some()
+            && let Some((delay, padding)) = tag.encoder_delay_padding
+        {
+            let start = usize::from(delay) + 529;
+            if frames >= start {
+                frames -= start;
+            }
+            let tail = usize::from(padding).saturating_sub(529);
+            if frames >= tail {
+                frames -= tail;
+            }
+        }
+    }
+    let (_, channels, _) = format.ok_or(AudioError::Empty)?;
+    if frames * usize::from(channels.num()) > max_samples {
+        return Err(AudioError::TooLong);
+    }
+    let pcm = crate::mp3::decode(data)?;
+    if pcm.frames() != frames {
+        return Err(AudioError::Unreadable);
+    }
+    finite(&pcm.samples)?;
+    Ok(pcm)
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::indexing_slicing)]
+mod tests {
+    use super::*;
+    const OGG: &[u8] = include_bytes!("../tests/data/tone.ogg");
+    const MP3: &[u8] = include_bytes!("../tests/data/tone.mp3");
+    #[test]
+    fn complete_native_fixtures_match_tolerant_samples() {
+        let wav = crate::wav::encode(8000, 1, &[0.25; 100], crate::wav::Bits::Float32);
+        for bytes in [&wav[..], OGG, MP3] {
+            let exact = decode_complete(bytes, MAX_SAMPLES).unwrap();
+            assert_eq!(exact, crate::decode(bytes).unwrap());
+            assert!(decode_complete(bytes, exact.samples.len() - 1).is_err());
+            assert_eq!(decode_complete(bytes, exact.samples.len()).unwrap(), exact);
+        }
+    }
+    #[test]
+    fn corrupt_or_unconsumed_tails_are_not_success() {
+        for bytes in [OGG, MP3] {
+            for cut in [1, 5, 32] {
+                assert!(decode_complete(&bytes[..bytes.len() - cut], MAX_SAMPLES).is_err());
+            }
+            let mut appended = bytes.to_vec();
+            appended.extend_from_slice(b"discarded tail");
+            assert!(decode_complete(&appended, MAX_SAMPLES).is_err());
+        }
+        let mut chained = OGG.to_vec();
+        chained.extend_from_slice(OGG);
+        assert!(decode_complete(&chained, MAX_SAMPLES).is_err());
+        let mut damaged = OGG.to_vec();
+        damaged[100] ^= 1;
+        assert!(decode_complete(&damaged, MAX_SAMPLES).is_err());
+    }
+    #[test]
+    fn wav_nonfinite_and_partial_frames_are_refused() {
+        let mut wav = crate::wav::encode(8000, 1, &[0.25; 3], crate::wav::Bits::Float32);
+        wav[44..48].copy_from_slice(&f32::NAN.to_le_bytes());
+        assert!(crate::decode(&wav).is_ok());
+        assert!(decode_complete(&wav, MAX_SAMPLES).is_err());
+        wav[44..48].copy_from_slice(&0.25f32.to_le_bytes());
+        wav.pop();
+        assert!(crate::decode(&wav).is_ok());
+        assert!(decode_complete(&wav, MAX_SAMPLES).is_err());
+    }
+    #[test]
+    fn wav_streaming_lengths_still_require_whole_frames() {
+        let mut wav = crate::wav::encode(8000, 1, &[0.25; 3], crate::wav::Bits::Float32);
+        wav[4..8].copy_from_slice(&u32::MAX.to_le_bytes());
+        wav[40..44].copy_from_slice(&u32::MAX.to_le_bytes());
+        assert_eq!(decode_complete(&wav, MAX_SAMPLES).unwrap().frames(), 3);
+        wav.pop();
+        assert!(decode_complete(&wav, MAX_SAMPLES).is_err());
+    }
+}
