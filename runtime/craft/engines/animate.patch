+/// Compare the entire serialized native state before repair and after a cold
+/// save/load cycle. The runtime must admit the original JSON and media first:
+/// serde defaults, custom deserializers and ignored fields precede this check.
+/// This does not claim byte preservation of the original JSON or render fidelity.
+#[cfg(feature = "dobe")]
+pub fn inspect_preservation(text: &str) -> Result<usize, EngineError> {
+    const LIMIT: usize = 64 << 20;
+    if text.len() > LIMIT {
+        return Err(EngineError::Format("preservation inspection exceeds 64 MiB".into()));
+    }
+    let env: EnvelopeIn = serde_json::from_str(text).map_err(|e| EngineError::Format(e.to_string()))?;
+    if env.format != FORMAT_NAME || env.version != FORMAT_VERSION {
+        return Err(EngineError::Format("preservation inspection requires native format 3".into()));
+    }
