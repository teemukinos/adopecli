+#[test]
+fn independent_frame_entry_does_not_inherit_a_waiting_frames_scope() {
+    let waiting = limited(Work::Bytes, 1);
+    let mut doc = anicraft_doc::Document::default();
+    doc.stage.width = 8;
+    doc.stage.height = 8;
+    waiting
+        .run(|| {
+            // A nested Rayon wait can execute another frame's outer dispatch task
+            // before entering its own prepare workers. The frame entry must isolate
+            // its context too, not just the inner worker closures.
+            let result = checked_render(&doc, 0, 1.0);
+            assert!(result.is_ok(), "independent frame inherited waiting frame: {result:?}");
+            assert!(active());
+        })
+        .unwrap();
+    assert_eq!(waiting.report()["bytes_reserved"], 0);
+    assert_eq!(waiting.report()["raster_steps"], 0);
+    assert!(!active() && geometry::current().is_none());
+}
