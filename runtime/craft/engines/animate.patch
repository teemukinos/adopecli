+//! Checked native frame evaluation. This bounds evaluation, not rasterization or
+//! file parsing. Stored document admission remains a separate runtime contract.
+use crate::{Action, BitmapId, Document, Element, ElementKind, Filter, Paint, Pixels};
+use anicraft_geom::{Affine, Rect, Vec2, budget};
+use serde::Serialize;
+use std::{cell::RefCell, collections::HashMap, rc::Rc, sync::Arc};
+
+#[derive(Clone, Debug, Default, Serialize)]
+pub struct FrameWork {
+    pub timelines: usize,
+    pub layers: usize,
+    pub elements: usize,
+    pub continuity: usize,
+    pub bounds: usize,
+    pub helpers: usize,
+    pub items: usize,
+    pub structures: usize,
+    pub copy_bytes_reserved: usize,
+    pub decoded_pixels: usize,
+    pub encoded_bytes: usize,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum Work {
+    Timeline,
+    Layer,
+    Element,
+    Continuity,
+    Bounds,
+    Helper,
+    Item,
+    Structure,
+    Copy,
+    Pixels,
+    Bytes,
+}
+
+#[derive(Default)]
+struct State {
+    work: FrameWork,
+    error: Option<&'static str>,
+    images: HashMap<BitmapId, Arc<Pixels>>,
+}
+thread_local! { static CURRENT: RefCell<Option<Rc<RefCell<State>>>> = const { RefCell::new(None) }; }
+struct Scope(Option<Rc<RefCell<State>>>);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        CURRENT.with(|slot| {
+            slot.replace(self.0.take());
+        });
+    }
+}
+
+pub(crate) fn active() -> bool {
+    CURRENT.with(|slot| slot.borrow().is_some())
+}
+pub(crate) fn healthy() -> bool {
+    budget::healthy() && CURRENT.with(|slot| slot.borrow().as_ref().is_none_or(|s| s.borrow().error.is_none()))
+}
+pub(crate) fn fail(message: &'static str) -> bool {
+    CURRENT.with(|slot| {
+        if let Some(state) = slot.borrow().as_ref() {
+            state.borrow_mut().error.get_or_insert(message);
+            true
+        } else {
+            false
+        }
+    })
+}
+pub(crate) fn require(valid: bool, message: &'static str) -> bool {
+    valid || !fail(message)
+}
+pub(crate) fn charge(kind: Work, count: usize) -> bool {
+    if !budget::healthy() {
+        return false;
+    }
+    CURRENT.with(|slot| {
+        let current = slot.borrow();
+        let Some(state) = current.as_ref() else { return true };
+        let mut state = state.borrow_mut();
+        if state.error.is_some() {
+            return false;
+        }
+        let (value, limit, message) = match kind {
+            Work::Timeline => (&mut state.work.timelines, 65_536, "frame exceeds its expanded timeline budget"),
+            Work::Layer => (&mut state.work.layers, 1_000_000, "frame exceeds its layer scan budget"),
+            Work::Element => (&mut state.work.elements, 1_000_000, "frame exceeds its element scan budget"),
+            Work::Continuity => (&mut state.work.continuity, 1_000_000, "frame exceeds its instance continuity budget"),
+            Work::Bounds => (&mut state.work.bounds, 1_000_000, "frame exceeds its recursive bounds budget"),
+            Work::Helper => (&mut state.work.helpers, 20_000_000, "frame exceeds its helper work budget"),
+            Work::Item => (&mut state.work.items, 32_768, "frame exceeds 32768 display items"),
+            Work::Structure => (&mut state.work.structures, 32_768, "frame exceeds its clip/group budget"),
+            Work::Copy => (&mut state.work.copy_bytes_reserved, 64 << 20, "frame exceeds its copied metadata budget"),
+            Work::Pixels => (&mut state.work.decoded_pixels, 64_000_000, "frame exceeds its decoded bitmap pixel budget"),
+            Work::Bytes => (&mut state.work.encoded_bytes, 48 << 20, "frame exceeds its encoded bitmap budget"),
+        };
+        *value = value.saturating_add(count);
+        if *value > limit {
+            state.error = Some(message);
+            false
+        } else {
+            true
+        }
+    })
+}
+
+/// Retain the geometry budget for the renderer to enter explicitly. Successful
+/// evaluation alone does not authorize rasterization, export or publication.
+pub struct CheckedFrame {
+    pub display: crate::DisplayList,
+    pub work: FrameWork,
+    pub geometry: budget::Budget,
+}
+
+/// Enter the same stored-document and evaluation limits for consumers that use
+/// guided layers directly, such as HTML timeline baking. The closure must not
+/// publish files. Counters and bitmap decoding are shared across this operation,
+/// isolated from any surrounding operation for another document.
+pub fn checked_operation<T>(doc: &Document, compute: impl FnOnce() -> Result<T, String>) -> Result<(T, FrameWork), String> {
+    let state = Rc::new(RefCell::new(State::default()));
+    let restore = Scope(CURRENT.with(|slot| slot.replace(Some(state.clone()))));
+    let geometry = budget::current().unwrap_or_default();
+    let result = geometry.run(|| if preflight(doc) { compute() } else { Err("stored document admission failed".into()) });
+    let error = state.borrow().error;
+    let work = state.borrow().work.clone();
+    drop(restore);
+    if let Some(error) = error {
+        return Err(error.into());
+    }
+    Ok((result??, work))
+}
+
+/// Validate media actually embedded by a checked consumer, even when it is not
+/// visible on the first movie frame. Reuse only this operation's fresh decode.
+pub fn checked_bitmap(doc: &Document, id: BitmapId) -> Result<Arc<Pixels>, String> {
+    if !active() {
+        return Err("bitmap validation requires checked evaluation".into());
+    }
+    bitmap(doc, id)
+        .ok_or_else(|| CURRENT.with(|slot| slot.borrow().as_ref().and_then(|s| s.borrow().error).unwrap_or("checked bitmap failed").to_string()))
+}
+
+pub fn checked_evaluate(doc: &Document, frame: u32) -> Result<CheckedFrame, String> {
+    let state = CURRENT.with(|slot| slot.borrow().clone()).unwrap_or_default();
+    let restore = Scope(CURRENT.with(|slot| slot.replace(Some(state.clone()))));
+    let geometry = budget::current().unwrap_or_default();
+    let result = geometry.run(|| {
+        if !preflight(doc) {
+            return crate::DisplayList::default();
+        }
+        if !require(frame < doc.frame_count(), "frame is outside the movie") {
+            return crate::DisplayList::default();
+        }
+        crate::evaluate(doc, frame)
+    });
+    let error = state.borrow().error;
+    let work = state.borrow().work.clone();
+    drop(restore);
+    if let Some(error) = error {
+        return Err(error.into());
+    }
+    Ok(CheckedFrame { display: result?, work, geometry })
+}
+
+pub(crate) fn transform(m: &Affine) -> bool {
+    !active() || (healthy() && m.m.chunks(2).all(|v| budget::point(Vec2::new(v[0], v[1]))))
+}
+pub(crate) fn rect(r: Rect) -> bool {
+    !active() || (healthy() && ((r.min.x > r.max.x || r.min.y > r.max.y) || (budget::point(r.min) && budget::point(r.max))))
+}
+fn paint_size(paint: &Paint) -> Option<usize> {
+    match paint {
+        Paint::Linear { stops, .. } | Paint::Radial { stops, .. } => {
+            if !require(stops.len() <= 256, "frame paint exceeds 256 gradient stops") || !charge(Work::Helper, stops.len()) {
+                return None;
+            }
+            Some(stops.len() * std::mem::size_of::<crate::GradientStop>())
+        }
+        _ => Some(0),
+    }
+}
+fn filter_size(filter: &Filter) -> Option<usize> {
+    match filter {
+        Filter::GradientGlow { stops, .. } | Filter::GradientBevel { stops, .. } => {
+            if !require(stops.len() <= crate::MAX_RAMP_STOPS, "frame filter exceeds its ramp budget") {
+                return None;
+            }
+            Some(std::mem::size_of::<Filter>() + stops.len() * std::mem::size_of::<crate::GradientStop>())
+        }
+        _ => Some(std::mem::size_of::<Filter>()),
+    }
+}
+fn action_size(action: &Action) -> usize {
+    use crate::actions::FrameRef;
+    std::mem::size_of::<Action>()
+        + match action {
+            Action::Stop { target }
+            | Action::Play { target }
+            | Action::NextFrame { target }
+            | Action::PrevFrame { target }
+            | Action::SetProperty { target, .. } => target.0.len(),
+            Action::GotoAndPlay { target, frame, scene } | Action::GotoAndStop { target, frame, scene } => {
+                target.0.len().saturating_add(scene.as_ref().map_or(0, String::len)).saturating_add(match frame {
+                    FrameRef::Number(_) => 0,
+                    FrameRef::Label(text) => text.len(),
+                })
+            }
+            Action::Trace { message } => message.len(),
+            Action::NextScene | Action::PrevScene => 0,
+        }
+}
+fn element_size(el: &Element) -> Option<usize> {
+    let mut size = std::mem::size_of::<Element>().saturating_add(el.name.len());
+    match &el.kind {
+        ElementKind::Shape(shape) => {
+            if !require(shape.path.cmds.len() <= 250_000, "frame path exceeds 250000 stored commands") {
+                return None;
+            }
+            if let Some(paint) = &shape.fill {
+                size = size.saturating_add(paint_size(paint)?.saturating_mul(3));
+            }
+            if let Some(stroke) = &shape.stroke {
+                let profile = stroke.profile.as_ref().map_or(0, |p| p.points().len());
+                let dash = match &stroke.style.dash {
+                    Some(crate::Dash::Dashed { lengths, .. }) => lengths.len(),
+                    _ => 0,
+                };
+                if !require(profile <= 64 && dash <= 64, "frame stroke exceeds its stored profile/dash budget") {
+                    return None;
+                }
+                if !charge(Work::Helper, (profile + dash).saturating_mul(32)) {
+                    return None;
+                }
+                size = size.saturating_add((profile + dash).saturating_mul(64));
+            }
+        }
+        ElementKind::Symbol { filters, events, .. } => {
+            if !require(filters.len() <= 8 && events.len() <= 16, "frame instance exceeds its filter/event budget") {
+                return None;
+            }
+            for filter in filters {
+                size = size.saturating_add(filter_size(filter)?.saturating_mul(3));
+            }
+            for handler in events {
+                if !require(handler.actions.len() <= 256, "frame event exceeds its action budget") || !charge(Work::Helper, handler.actions.len()) {
+                    return None;
+                }
+                size = size.saturating_add(std::mem::size_of::<crate::EventHandler>());
+                for action in &handler.actions {
+                    size = size.saturating_add(action_size(action));
+                }
+            }
+        }
+        ElementKind::Text(text) => {
+            if !require(text.outline.cmds.len() <= 250_000, "frame text exceeds 250000 stored outline commands") {
+                return None;
+            }
+            if !require(text.box_width.is_finite() && text.box_height.is_finite(), "frame text has nonfinite stored bounds") {
+                return None;
+            }
+            // The text block and its outline are Arc-shared, not copied.
+        }
+        ElementKind::Camera => {}
+    }
+    Some(size)
+}
+pub(crate) fn copy_element(el: &Element) -> bool {
+    !active() || element_size(el).is_some_and(|size| charge(Work::Copy, size))
+}
+pub(crate) fn scalar(value: f32) -> bool {
+    !active() || budget::point(Vec2::new(value, 0.0))
+}
+pub(crate) fn color(color: &crate::ColorTransform) -> bool {
+    !active() || color.mul.iter().chain(&color.add).all(|v| scalar(*v))
+}
+pub(crate) fn output(
+    path: &anicraft_geom::Path,
+    xf: &Affine,
+    fill: Option<&Paint>,
+    stroke: Option<&crate::Stroke>,
+    color: &crate::ColorTransform,
+) -> bool {
+    if !active() {
+        return true;
+    }
+    if !charge(Work::Item, 1) || !transform(xf) || !budget::path(path, xf) {
+        return false;
+    }
+    if !self::color(color) {
+        return false;
+    }
+    if let Some(stroke) = stroke
+        && !budget::point(Vec2::new(stroke.width, stroke.reach()))
+    {
+        return false;
+    }
+    match fill {
+        Some(Paint::Linear { start, end, .. }) => budget::point(xf.apply(*start)) && budget::point(xf.apply(*end)),
+        Some(Paint::Radial { center, radius, .. }) => budget::point(xf.apply(*center)) && budget::point(Vec2::new(*radius, radius * xf.mean_scale())),
+        Some(Paint::Bitmap { matrix, .. }) => transform(&xf.mul(matrix)),
+        _ => true,
+    }
+}
+
+pub(crate) fn bitmap(doc: &Document, id: BitmapId) -> Option<Arc<Pixels>> {
+    if !active() {
+        return doc.bitmap(id).and_then(crate::Bitmap::pixels);
+    }
+    if !healthy() || !charge(Work::Helper, doc.bitmaps.len()) {
+        return None;
+    }
+    if let Some(pixels) = CURRENT.with(|slot| slot.borrow().as_ref().and_then(|s| s.borrow().images.get(&id).cloned())) {
+        return Some(pixels);
+    }
+    let Some(bitmap) = doc.bitmap(id) else {
+        fail("frame references a missing bitmap");
+        return None;
+    };
+    if !require(bitmap.png.len() <= 32 << 20, "frame bitmap exceeds 32 MiB") || !charge(Work::Bytes, bitmap.png.len()) {
+        return None;
+    }
+    // Decode afresh once per checked evaluation, so mutable metadata or a stale
+    // legacy decode cache cannot bypass dimensions or allocation accounting.
+    let Some(pixels) = crate::decode_png(&bitmap.png) else {
+        fail("frame bitmap cannot decode within its budget");
+        return None;
+    };
+    if !require(pixels.width == bitmap.width && pixels.height == bitmap.height, "frame bitmap metadata differs from decoded dimensions") {
+        return None;
+    }
+    let pixels = Arc::new(pixels);
+    CURRENT.with(|slot| {
+        if let Some(state) = slot.borrow().as_ref() {
+            state.borrow_mut().images.insert(id, pixels.clone());
+        }
+    });
+    Some(pixels)
+}
+
+fn preflight(doc: &Document) -> bool {
+    if !require(doc.scenes.len() <= 64 && doc.library.len() <= 512 && doc.bitmaps.len() <= 256, "frame exceeds its stored scene/symbol/bitmap budget")
+    {
+        return false;
+    }
+    let (mut layers, mut keys, mut elements, mut motion_keys, mut bones, mut metadata) = (0usize, 0usize, 0usize, 0usize, 0usize, 0usize);
+    for timeline in doc.timelines() {
+        layers = layers.saturating_add(timeline.layers.len());
+        if !require(layers <= 1024, "frame exceeds 1024 stored layers") {
+            return false;
+        }
+        for layer in &timeline.layers {
+            keys = keys.saturating_add(layer.keyframes.len());
+            if !require(keys <= 8192, "frame exceeds 8192 stored keyframes") {
+                return false;
+            }
+            if let Some(arm) = &layer.armature {
+                bones = bones.saturating_add(arm.bones.len());
+                if !require(arm.bones.len() <= 256 && bones <= 4096, "frame exceeds its stored bone budget") {
+                    return false;
+                }
+            }
+            for key in &layer.keyframes {
+                elements = elements.saturating_add(key.elements.len());
+                if !require(
+                    elements <= 32768 && key.hints.len() <= 26 && key.pose.0.len() <= 256,
+                    "frame exceeds its stored element/hint/pose budget",
+                ) {
+                    return false;
+                }
+                if let Some(motion) = &key.motion {
+                    if !require(
+                        motion.tracks.len() <= 20 && motion.pins.len() <= 256 && motion.path.as_ref().is_none_or(|p| p.cmds.len() <= 1001),
+                        "frame exceeds its stored motion budget",
+                    ) {
+                        return false;
+                    }
+                    for track in &motion.tracks {
+                        motion_keys = motion_keys.saturating_add(track.keys.len());
+                    }
+                    if !require(motion_keys <= 32768, "frame exceeds 32768 motion property keys") {
+                        return false;
+                    }
+                }
+                for el in &key.elements {
+                    let Some(size) = element_size(el) else { return false };
+                    metadata = metadata.saturating_add(size);
+                    if !require(metadata <= 64 << 20, "frame exceeds its stored metadata budget") || !transform(&el.transform) {
+                        return false;
+                    }
+                }
+            }
+        }
+    }
+    charge(Work::Helper, layers.saturating_mul(3).saturating_add(keys).saturating_add(elements).saturating_add(motion_keys))
+}
