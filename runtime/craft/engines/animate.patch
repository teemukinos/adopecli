+fn bounded_native_json(doc: &Document, limit: usize) -> Result<Vec<u8>, EngineError> {
+    let paths = path_table::build_table(doc);
+    let env = EnvelopeOut {
+        format: FORMAT_NAME,
+        version: FORMAT_VERSION,
+        generator: format!("AniCraft {}", env!("CARGO_PKG_VERSION")),
+        paths: &paths,
+        document: doc,
+    };
+    let mut output = anicraft_render::sequence::LimitedBytes::new(limit);
+    path_table::write_with_paths(&paths, || serde_json::to_writer(&mut output, &env)).map_err(|e| EngineError::Format(e.to_string()))?;
+    Ok(output.into_bytes())
