+fn shape(id: u64) -> Arc<Element> {
+    Arc::new(Element {
+        id: ElementId(id),
+        name: String::new(),
+        transform: Affine::IDENTITY,
+        color: ColorEffect::default(),
+        kind: ElementKind::Shape(Shape::filled(Path::rect(0.0, 0.0, 10.0, 10.0), Paint::Solid(crate::Rgba::BLACK))),
+    })
+}
+fn instance(id: u64, symbol: u64, scale: f32) -> Arc<Element> {
+    Arc::new(Element {
+        id: ElementId(id),
+        name: String::new(),
+        transform: Affine::scale(scale, scale),
+        color: ColorEffect::default(),
+        kind: ElementKind::Symbol {
+            symbol: SymbolId(symbol),
+            loop_mode: Default::default(),
+            first_frame: 0,
+            blend: Default::default(),
+            filters: Vec::new(),
+            events: Vec::new(),
+        },
+    })
+}
+fn root(doc: &mut Document, elements: Vec<Arc<Element>>) {
+    let mut key = Keyframe::new(0, 1);
+    key.elements = elements;
+    Arc::make_mut(&mut doc.timeline_mut(0).layers[0]).keyframes = vec![Arc::new(key)];
+}
+fn tree(depth: usize, branches: usize, scale: f32) -> Document {
+    let mut doc = Document::default();
+    for i in 0..depth {
+        let id = 100 + i as u64;
+        let mut layer = Layer::new(LayerId(1000 + i as u64), "nested");
+        let mut key = Keyframe::new(0, 1);
+        key.elements = if i + 1 == depth {
+            vec![shape(10000 + i as u64)]
+        } else {
+            (0..branches).map(|j| instance(20000 + i as u64 * 8 + j as u64, id + 1, scale)).collect()
+        };
+        layer.keyframes = vec![Arc::new(key)];
+        doc.library.push(Arc::new(Symbol {
+            id: SymbolId(id),
+            name: "nested".into(),
+            kind: SymbolKind::Graphic,
+            linkage: None,
+            scale_grid: None,
+            scale_grid_kept: None,
+            timeline: Timeline { layers: vec![Arc::new(layer)] },
+        }));
+    }
+    root(&mut doc, vec![instance(2, 100, scale)]);
+    doc
+}
+fn same(a: &crate::DisplayList, b: &crate::DisplayList) {
+    assert_eq!(a.clip_parents, b.clip_parents);
+    assert_eq!(a.groups, b.groups);
+    assert_eq!(a.items.len(), b.items.len());
+    for (a, b) in a.items.iter().zip(&b.items) {
+        assert_eq!(a.path, b.path);
+        assert_eq!(a.transform, b.transform);
+        assert_eq!(a.fill, b.fill);
+        assert_eq!(a.stroke, b.stroke);
+        assert_eq!(a.fill_rule, b.fill_rule);
+        assert_eq!(a.color, b.color);
+        assert_eq!(a.layer, b.layer);
+        assert_eq!(a.element, b.element);
+        assert_eq!(a.outline, b.outline);
+        assert_eq!(a.clip, b.clip);
+        assert_eq!(a.masks, b.masks);
+        assert_eq!(a.guide, b.guide);
+        assert_eq!(a.group, b.group);
+        assert_eq!(a.image, b.image);
+        assert_eq!(a.smooth, b.smooth);
+    }
+}
+fn refusal(doc: &Document, frame: u32) -> String {
+    match checked_evaluate(doc, frame) {
+        Ok(_) => panic!("expected refusal"),
+        Err(e) => e,
+    }
+}
