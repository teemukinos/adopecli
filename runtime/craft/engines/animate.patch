+#[test]
+fn workers_share_aggregate_limits_and_restore_scopes() {
+    let b = limited(Work::Bytes, 1000);
+    let pool = rayon::ThreadPoolBuilder::new().num_threads(4).build().unwrap();
+    assert!(
+        pool.install(|| b.run(|| {
+            let capture = capture();
+            (0..100).into_par_iter().for_each(|_| {
+                capture.run(|| {
+                    reserve::<u8>(64);
+                })
+            });
+        }))
+        .unwrap_err()
+        .contains("buffer reservation")
+    );
+    assert!(b.report()["bytes_reserved"].as_u64().unwrap() >= 1024);
+    pool.install(|| (0..100).into_par_iter().for_each(|_| assert!(!active() && geometry::current().is_none())));
+}
