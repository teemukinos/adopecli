+        .unwrap();
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::indexing_slicing)]
+mod soundtrack_tests {
+    use super::*;
+    use anicraft_doc::{FrameSound, Sound, SoundId, SoundSync};
+    use std::sync::Arc;
+
+    fn session(frames: u32, sync: SoundSync) -> Session {
+        let mut s = Session::default();
+        s.doc.stage.fps = 8.0;
+        let data = audio::wav::encode(8000, 1, &[0.25; 100], audio::wav::Bits::Float32);
+        s.doc.sounds.push(Arc::new(Sound::from_data(SoundId(50), "tone", data).unwrap()));
+        let layer = Arc::make_mut(&mut s.doc.timeline_mut(0).layers[0]);
+        layer.keyframes.truncate(1);
