+    doc.bitmaps.push(Arc::new(anicraft_doc::Bitmap::from_png(anicraft_doc::BitmapId(50), "dot", png).unwrap()));
+    let wav = anicraft_doc::audio::wav::encode(8000, 1, &[0.0; 80], anicraft_doc::audio::wav::Bits::Int16);
+    doc.sounds.push(Arc::new(anicraft_doc::Sound::from_data(anicraft_doc::SoundId(60), "beep", wav).unwrap()));
+    let key = Arc::make_mut(&mut Arc::make_mut(&mut doc.timeline_mut(0).layers[0]).keyframes[0]);
+    key.elements = vec![Arc::new(Element {
+        id: ElementId(70),
+        name: String::new(),
+        transform: Affine::IDENTITY,
+        color: Default::default(),
+        kind: ElementKind::Shape(Shape::filled(
+            Path::rect(0.0, 0.0, 10.0, 10.0),
+            Paint::Bitmap { bitmap: anicraft_doc::BitmapId(50), repeat: true, matrix: Affine::IDENTITY },
+        )),
+    })];
+    key.sound = Some(anicraft_doc::FrameSound::new(anicraft_doc::SoundId(60)));
+    let checked = checked_html(&doc, &HtmlOptions::default()).unwrap();
+    assert_eq!(checked.output.stats.images, 1);
+    assert_eq!(checked.output.stats.sounds, 1);
+    // Warm legacy caches cannot validate changed payloads or metadata.
+    assert!(doc.bitmaps[0].pixels().is_some());
+    assert!(doc.sounds[0].decoded().is_some());
+    // A surrounding evaluation for another document must not supply this
+    // export's bitmap cache merely because both documents use the same ID.
+    anicraft_doc::eval_budget::checked_operation(&doc, || {
+        anicraft_doc::eval_budget::checked_bitmap(&doc, anicraft_doc::BitmapId(50))?;
+        let mut other = doc.clone();
+        let bitmap = Arc::make_mut(&mut other.bitmaps[0]);
+        bitmap.png = Arc::new(bitmap.png[..33].to_vec());
+        assert!(checked_html(&other, &HtmlOptions::default()).is_err());
+        assert!(anicraft_doc::eval_budget::checked_bitmap(&doc, anicraft_doc::BitmapId(50)).is_ok());
+        Ok(())
