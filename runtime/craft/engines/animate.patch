@@ -0,0 +1,228 @@
+//! Bounded admission and serialization for the native Lottie exporter.
+//! Reservations are conservative work units, not measured peak memory. Player
+//! fidelity and complete stored-document admission are separate qualifications.
+use super::{Bez, Fill, LottieExport, Track};
+use crate::{RenderError, budget};
+use anicraft_doc::{DisplayList, Document};
+use serde_json::Value;
+use std::io::Write;
+
+pub const MAX_LOTTIE_BYTES: usize = 64 << 20;
+
+pub struct CheckedLottie {
+    pub output: LottieExport,
+    pub work: Value,
+}
+
+pub fn checked_lottie(doc: &Document, name: &str, from: u32, to: u32, background: bool) -> Result<CheckedLottie, RenderError> {
+    if !to.checked_sub(from).and_then(|n| n.checked_add(1)).is_some_and(|n| n <= crate::sequence::MAX_FRAMES) {
+        return Err(RenderError::Budget("Lottie must contain 1 to 600 frames".into()));
+    }
+    if name.len() > 4096 {
+        return Err(RenderError::Budget("Lottie name exceeds 4096 UTF-8 bytes".into()));
+    }
+    // Samples survive across frames, unlike raster sequences. Keep the total
+    // retained-work reservation at 512 MiB rather than the raster export's 8 GiB.
+    let scope = budget::Budget::new(anicraft_geom::budget::Budget::export());
+    let output = scope.run_worker(|| super::try_to_lottie(doc, name, from, to, background)).map_err(RenderError::Budget)??;
+    Ok(CheckedLottie { output, work: scope.report() })
+}
+
+pub(super) fn reserve(bytes: usize, helpers: usize) -> Result<(), RenderError> {
+    if !budget::reserve::<u8>(bytes) || !budget::charge(budget::Work::Helper, helpers) {
+        budget::check()?;
+    }
+    Ok(())
+}
+
+fn outline(display: DisplayList) -> DisplayList {
+    match crate::stroke::outline_variable_strokes(&display) {
+        std::borrow::Cow::Owned(outlined) => outlined,
+        std::borrow::Cow::Borrowed(_) => display,
+    }
+}
+
+pub(super) fn frame(doc: &Document, f: u32) -> Result<DisplayList, RenderError> {
+    if !budget::active() {
+        return Ok(outline(anicraft_doc::evaluate(doc, f)));
+    }
+    let scope = budget::current().ok_or_else(|| RenderError::Budget("missing Lottie scope".into()))?.frame_child();
+    scope
+        .run_worker(|| {
+            let checked = anicraft_doc::eval_budget::checked_evaluate(doc, f).map_err(RenderError::Budget)?;
+            let dl = checked.display;
+            reserve(checked.work.copy_bytes_reserved.saturating_mul(2), dl.items.len())?;
+            if !budget::reserve::<anicraft_doc::DisplayItem>(dl.items.len().saturating_mul(2))
+                || !budget::reserve::<anicraft_doc::Group>(dl.groups.len())
+                || !budget::reserve::<u32>(dl.clip_parents.len())
+            {
+                budget::check()?;
+            }
+            // Both native evaluation and variable-stroke outlining keep frame caps,
+            // and contribute to the enclosing export's counters.
+            let outlined = outline(dl);
+            budget::check()?;
+            Ok(outlined)
+        })
+        .map_err(RenderError::Budget)?
+}
+
+pub(super) fn bezier_copy(paths: &[Bez]) -> Result<(), RenderError> {
+    reserve(paths.len().saturating_mul(256), paths.len())?;
+    for b in paths {
+        reserve(b.v.len().saturating_add(b.i.len()).saturating_add(b.o.len()).saturating_mul(32), b.v.len())?;
+    }
+    Ok(())
+}
+
+/// Reserve before the native JSON tree exists. Per-vertex units cover three
+/// coordinate pairs, their arrays, hold-keyframe copies, property comparisons,
+/// and enclosing serde_json containers. Per-frame units cover fixed transforms,
+/// paint/stroke properties, metadata and container growth. This deliberately
+/// overcounts static frames that the native exporter later deduplicates.
+pub(super) fn layer(tr: &Track) -> Result<(), RenderError> {
+    if !budget::active() {
+        return Ok(());
+    }
+    reserve(tr.name.len().saturating_mul(16).saturating_add(16384), tr.frames.len())?;
+    for (_, sample) in &tr.frames {
+        reserve(16384, 512)?;
+        for b in sample.paths.iter().chain(&sample.masks) {
+            reserve(b.v.len().saturating_mul(8192).saturating_add(8192), b.v.len().saturating_mul(128).saturating_add(128))?;
+        }
+        let stops = match &sample.fill {
+            Some(Fill::Gradient { stops, .. }) => stops.len(),
+            _ => 0,
+        };
+        let dashes = sample.stroke.as_ref().map_or(0, |s| s.dash.len());
+        let components = stops.saturating_add(dashes);
+        reserve(components.saturating_mul(4096), components.saturating_mul(128))?;
+    }
+    Ok(())
+}
+
+pub(super) fn serialize(root: &Value) -> Result<String, RenderError> {
+    if !budget::active() {
+        return Ok(root.to_string());
+    }
+    struct Output(crate::sequence::LimitedBytes);
+    impl Write for Output {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            // Account for geometric capacity growth before the bounded writer.
+            reserve(bytes.len().saturating_mul(2), 1).map_err(std::io::Error::other)?;
+            self.0.write(bytes)
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut output = Output(crate::sequence::LimitedBytes::new(MAX_LOTTIE_BYTES));
+    serde_json::to_writer(&mut output, root).map_err(|e| RenderError::Budget(format!("Lottie serialization failed: {e}")))?;
+    String::from_utf8(output.0.into_bytes()).map_err(|e| RenderError::Budget(e.to_string()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use anicraft_geom::{Affine, Path, PathCmd, Vec2};
+
+    #[test]
+    fn checked_export_preserves_native_animation_and_loss_report() {
+        for doc in [anicraft_doc::sample::demo(), anicraft_doc::sample::interactive()] {
+            let before = serde_json::to_value(&doc).unwrap();
+            for (from, to, background) in [(0, 0, false), (1, 12, true), (0, doc.frame_count() - 1, false)] {
+                let native = super::super::to_lottie(&doc, "animation", from, to, background);
+                let checked = checked_lottie(&doc, "animation", from, to, background).unwrap();
+                let mut expected: Value = serde_json::from_str(&native.json).unwrap();
+                expected["meta"]["g"] = serde_json::json!(format!("Dobe Animate {}", env!("CARGO_PKG_VERSION")));
+                assert_eq!(checked.output.json, expected.to_string());
+                assert_eq!(checked.output.layers, native.layers);
+                assert_eq!(checked.output.report, native.report);
+                assert!(checked.work["bytes_reserved"].as_u64().unwrap() > 0);
+            }
+            assert_eq!(serde_json::to_value(&doc).unwrap(), before);
+        }
+    }
+
+    #[test]
+    fn invalid_ranges_names_and_late_frames_cannot_return_exports() {
+        let doc = anicraft_doc::sample::demo();
+        for (from, to) in [(1, 0), (0, 600), (0, u32::MAX), (0, doc.frame_count()), (doc.frame_count(), doc.frame_count())] {
+            assert!(checked_lottie(&doc, "animation", from, to, false).is_err());
+        }
+        assert!(checked_lottie(&doc, &"x".repeat(4097), 0, 0, false).is_err());
+        assert!(checked_lottie(&doc, "animation", 0, 0, false).is_ok());
+    }
+
+    #[test]
+    fn composed_vertices_and_tangents_fail_instead_of_becoming_zero() {
+        let path =
+            Path { cmds: vec![PathCmd::MoveTo(Vec2::ZERO), PathCmd::CubicTo(Vec2::new(20.0, 0.0), Vec2::new(0.0, 20.0), Vec2::new(1.0, 1.0))] };
+        let scope = budget::Budget::new(Default::default());
+        assert!(scope.run_worker(|| super::super::beziers(&path, &Affine::scale(1e9, 1e9))).is_err());
+        for value in [f32::NAN, f32::INFINITY, f32::MAX] {
+            let scope = budget::Budget::new(Default::default());
+            assert!(scope.run_worker(|| super::super::n(value)).is_err());
+        }
+    }
+
+    #[test]
+    fn bezier_allocation_refuses_before_expanding_large_paths() {
+        let path = Path { cmds: vec![PathCmd::MoveTo(Vec2::ZERO); 1_048_577] };
+        let scope = budget::Budget::new(Default::default());
+        let error = scope.run_worker(|| assert!(super::super::beziers(&path, &Affine::IDENTITY).is_empty())).unwrap_err();
+        assert!(error.contains("buffer reservation"));
+    }
+
+    #[test]
+    fn checked_entry_isolates_unrelated_failed_worker_scope() {
+        let unrelated = budget::Budget::new(Default::default());
+        let result = unrelated.run_worker(|| {
+            budget::fail("unrelated caller failed");
+            assert!(checked_lottie(&anicraft_doc::sample::demo(), "isolated", 0, 0, false).is_ok());
+            assert!(budget::check().is_err());
+        });
+        assert!(result.unwrap_err().contains("unrelated"));
+        assert!(budget::current().is_none());
+    }
+
+    #[test]
+    fn json_byte_limit_is_checked_during_serialization() {
+        let root = Value::String("x".repeat(MAX_LOTTIE_BYTES));
+        let scope = budget::Budget::new(Default::default());
+        let result = scope.run_worker(|| serialize(&root)).unwrap();
+        assert!(result.unwrap_err().to_string().contains("encoded byte limit"));
+    }
+
+    #[test]
+    fn retained_json_materialization_is_reserved_before_layer_build() {
+        let scope = budget::Budget::new(Default::default());
+        let sample = super::super::Sample {
+            paths: vec![Bez { closed: false, v: vec![Vec2::ZERO; 65536], i: vec![Vec2::ZERO; 65536], o: vec![Vec2::ZERO; 65536] }],
+            fill: None,
+            stroke: None,
+            opacity: 1.0,
+            masks: Vec::new(),
+        };
+        let tr = Track {
+            key: super::super::Key {
+                layer: 1,
+                element: 1,
+                occurrence: 0,
+                shape: vec![(false, 65536)],
+                fill: 0,
+                stops: 0,
+                stroke: None,
+                masks: Vec::new(),
+                blend: 0,
+            },
+            name: "large".into(),
+            first: 0,
+            last: 0,
+            frames: vec![(0, sample)],
+            first_index: 0,
+        };
+        let error = scope.run_worker(|| assert!(layer(&tr).is_err())).unwrap_err();
+        assert!(error.contains("buffer reservation"));
+    }
+}
