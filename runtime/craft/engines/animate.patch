+#[test]
+fn checked_frames_match_native_float_pixels_in_one_and_four_worker_pools() {
+    for threads in [1, 4] {
+        let pool = rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap();
+        pool.install(|| {
+            for doc in [anicraft_doc::sample::demo(), anicraft_doc::sample::interactive()] {
+                let before = serde_json::to_value(&doc).unwrap();
+                for frame in [0, doc.frame_count() / 2, doc.frame_count() - 1] {
+                    let expected = crate::render_frame(&doc, frame, 0.25).unwrap();
+                    let (actual, _, report) = checked_render(&doc, frame, 0.25).unwrap();
+                    assert_eq!(actual, expected);
+                    assert!(report["render"]["bytes_reserved"].as_u64().unwrap() > 0);
+                    assert!(report["render"]["raster_steps"].as_u64().unwrap() > 0);
+                }
+                assert_eq!(serde_json::to_value(&doc).unwrap(), before);
+            }
+        });
+    }
+    assert!(!active() && geometry::current().is_none());
+}
