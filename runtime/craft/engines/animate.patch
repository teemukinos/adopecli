+#[test]
+fn nested_filtered_and_masked_groups_preserve_every_float_pixel() {
+    let mut dl = drawing();
+    let mut mask = item();
+    mask.path = Arc::new(Path::rect(0.0, 0.0, 28.0, 64.0));
+    mask.masks = Some(0);
+    dl.items[0].group = Some(1);
+    dl.items[0].clip = Some(0);
+    dl.items.insert(0, mask);
+    dl.clip_parents = vec![None];
+    dl.groups = vec![
+        group(None, vec![Filter::Blur { blur_x: 4.0, blur_y: 6.0, quality: 2 }]),
+        group(Some(0), vec![Filter::Glow { blur_x: 3.0, blur_y: 3.0, quality: 1, strength: 0.5, color: Rgba::BLACK, inner: false, knockout: false }]),
