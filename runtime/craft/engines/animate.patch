diff --git a/crates/render/src/sequence.rs b/crates/render/src/sequence.rs
new file mode 100644
index 0000000..bf8cfe2
--- /dev/null
+++ b/crates/render/src/sequence.rs
@@ -0,0 +1,201 @@
+//! Bounded CPU frame sequences. Frames share export counters while keeping their
+//! individual limits. No file is published here, and only one frame is retained.
+use crate::{Document, Pixmap, RenderError, View, budget, checked_render_budget};
+use std::io::Write;
+
+pub const MAX_FRAMES: u32 = 600;
+pub const MAX_SEQUENCE_PIXELS: u64 = 600 * 1280 * 720;
+pub const MAX_ENCODED_BYTES: usize = 512 << 20;
+
+pub struct CheckedSequence<'a> {
+    doc: &'a Document,
+    view: View,
+    next: u32,
+    end: u32,
+    budget: budget::Budget,
+    failed: bool,
+}
+
+impl<'a> CheckedSequence<'a> {
+    pub fn new(doc: &'a Document, from: u32, to: u32, scale: f32) -> Result<Self, RenderError> {
+        if !scale.is_finite() || scale <= 0.0 {
+            return Err(RenderError::Budget("sequence scale must be finite and positive".into()));
+        }
+        let count = to.checked_sub(from).and_then(|n| n.checked_add(1));
+        if !count.is_some_and(|n| n <= MAX_FRAMES) || to >= doc.frame_count() {
+            return Err(RenderError::Budget("sequence must contain 1 to 600 frames within the movie".into()));
+        }
+        let view = View::stage(doc, scale);
+        let pixels = u64::from(view.width) * u64::from(view.height);
+        if pixels > crate::MAX_PIXELS || pixels.saturating_mul(u64::from(count.unwrap_or(0))) > MAX_SEQUENCE_PIXELS {
+            return Err(RenderError::Budget("sequence exceeds its frame or aggregate pixel limit".into()));
+        }
+        Ok(Self { doc, view, next: from, end: to, budget: budget::Budget::export(), failed: false })
+    }
+
+    /// Errors latch for the sequence. Callers must discard all earlier outputs.
+    /// The borrowed document cannot change between frames.
+    pub fn next_frame(&mut self) -> Result<Option<Pixmap>, RenderError> {
+        if self.failed {
+            return Err(RenderError::Budget("sequence previously failed".into()));
+        }
+        if self.next > self.end {
+            return Ok(None);
+        }
+        let frame = self.budget.frame_child();
+        match checked_render_budget(self.doc, self.next, &self.view, &frame) {
+            Ok((pixels, _, _)) => {
+                self.next += 1; // the constructor excludes u32::MAX via movie bounds
+                Ok(Some(pixels))
+            }
+            Err(error) => {
+                self.failed = true;
+                Err(error)
+            }
+        }
+    }
+
+    /// Preserve the stage geometry but export an alpha background.
+    pub fn transparent(mut self) -> Self {
+        self.view.background = None;
+        self
+    }
+
+    pub fn dimensions(&self) -> (u32, u32) {
+        (self.view.width, self.view.height)
+    }
+
+    pub fn report(&self) -> serde_json::Value {
+        self.budget.report()
+    }
+}
+
+/// Refuse encoded output before extending the retained byte buffer. The PNG
+/// encoder's own workspace and RGBA conversion remain bounded by frame pixels.
+pub fn encode_png_limited(pixels: &Pixmap, remaining: usize) -> Result<Vec<u8>, RenderError> {
+    encode_rgba_limited(pixels.width, pixels.height, &pixels.to_rgba8(), remaining)
+}
+
+pub fn encode_rgba_limited(width: u32, height: u32, rgba: &[u8], remaining: usize) -> Result<Vec<u8>, RenderError> {
+    let count = u64::from(width) * u64::from(height);
+    if count == 0 || count > crate::MAX_PIXELS || count * 4 != rgba.len() as u64 {
+        return Err(RenderError::Budget("PNG buffer dimensions are invalid".into()));
+    }
+    let mut output = LimitedBytes::new(remaining);
+    {
+        let mut encoder = png::Encoder::new(&mut output, width, height);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        let mut writer = encoder.write_header().map_err(|e| RenderError::Png(e.to_string()))?;
+        writer.write_image_data(rgba).map_err(|e| RenderError::Png(e.to_string()))?;
+        writer.finish().map_err(|e| RenderError::Png(e.to_string()))?;
+    }
+    Ok(output.bytes)
+}
+
+pub struct LimitedBytes {
+    bytes: Vec<u8>,
+    limit: usize,
+}
+impl LimitedBytes {
+    pub fn new(limit: usize) -> Self {
+        Self { bytes: Vec::new(), limit: limit.min(MAX_ENCODED_BYTES) }
+    }
+    pub fn into_bytes(self) -> Vec<u8> {
+        self.bytes
+    }
+}
+impl Write for LimitedBytes {
+    fn write(&mut self, data: &[u8]) -> std::io::Result<usize> {
+        if data.len() > self.limit.saturating_sub(self.bytes.len()) {
+            return Err(std::io::Error::other("sequence exceeds its encoded byte limit"));
+        }
+        let needed = self.bytes.len() + data.len();
+        let target = needed.max(self.bytes.capacity().saturating_mul(2)).min(self.limit);
+        if self.bytes.capacity() < needed {
+            self.bytes.try_reserve_exact(target - self.bytes.len()).map_err(std::io::Error::other)?;
+        }
+        self.bytes.extend_from_slice(data);
+        Ok(data.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn byte_fragments_reuse_capacity_and_keep_the_output_limit() {
+        let mut output = LimitedBytes::new(4096);
+        let mut growths = 0;
+        for _ in 0..4096 {
+            let capacity = output.bytes.capacity();
+            output.write_all(b"x").unwrap();
+            growths += usize::from(output.bytes.capacity() != capacity);
+        }
+        assert!(growths < 16);
+        assert!(output.write_all(b"x").is_err());
+        assert_eq!(output.into_bytes(), vec![b'x'; 4096]);
+    }
+
+    #[test]
+    fn transparent_frames_and_raw_png_buffers_preserve_native_pixels() {
+        let doc = anicraft_doc::sample::demo();
+        let mut sequence = CheckedSequence::new(&doc, 0, 0, 0.125).unwrap().transparent();
+        let mut view = View::stage(&doc, 0.125);
+        view.background = None;
+        let expected = crate::render(&anicraft_doc::evaluate(&doc, 0), &view).unwrap().0;
+        assert_eq!(sequence.dimensions(), (view.width, view.height));
+        assert_eq!(sequence.next_frame().unwrap().unwrap(), expected);
+        let rgba = expected.to_rgba8();
+        assert_eq!(encode_rgba_limited(view.width, view.height, &rgba, MAX_ENCODED_BYTES).unwrap(), expected.encode_png().unwrap());
+        assert!(encode_rgba_limited(view.width, view.height, &rgba[1..], MAX_ENCODED_BYTES).is_err());
+        assert!(encode_rgba_limited(0, 1, &[], MAX_ENCODED_BYTES).is_err());
+        assert!(encode_rgba_limited(u32::MAX, u32::MAX, &[], MAX_ENCODED_BYTES).is_err());
+    }
+
+    #[test]
+    fn sequence_matches_independent_frames_and_accumulates_work() {
+        let doc = anicraft_doc::sample::demo();
+        let original = serde_json::to_value(&doc).unwrap();
+        let mut sequence = CheckedSequence::new(&doc, 0, 23, 0.125).unwrap();
+        let mut bytes = 0;
+        for frame in 0..24 {
+            let actual = sequence.next_frame().unwrap().unwrap();
+            assert_eq!(actual, crate::render_frame(&doc, frame, 0.125).unwrap());
+            let used = sequence.report()["bytes_reserved"].as_u64().unwrap();
+            assert!(used > bytes);
+            bytes = used;
+            let expected = actual.encode_png().unwrap();
+            assert_eq!(encode_png_limited(&actual, expected.len()).unwrap(), expected);
+            assert!(encode_png_limited(&actual, expected.len() - 1).is_err());
+        }
+        assert!(sequence.next_frame().unwrap().is_none());
+        assert_eq!(serde_json::to_value(&doc).unwrap(), original);
+    }
+
+    #[test]
+    fn range_scale_and_aggregate_surface_limits_precede_frame_work() {
+        let mut doc = Document::default();
+        std::sync::Arc::make_mut(&mut std::sync::Arc::make_mut(&mut doc.timeline_mut(0).layers[0]).keyframes[0]).duration = 1000;
+        assert!(CheckedSequence::new(&doc, 0, 600, 1.0).is_err());
+        assert!(CheckedSequence::new(&doc, 2, 1, 1.0).is_err());
+        assert!(CheckedSequence::new(&doc, 999, 1000, 1.0).is_err());
+        assert!(CheckedSequence::new(&doc, 0, 0, f32::NAN).is_err());
+        doc.stage.width = 4096;
+        doc.stage.height = 4096;
+        assert!(CheckedSequence::new(&doc, 0, 32, 1.0).is_err());
+        assert!(CheckedSequence::new(&doc, 0, 31, 1.0).is_ok());
+    }
+
+    #[test]
+    fn byte_writer_never_extends_past_its_limit() {
+        let mut out = LimitedBytes { bytes: Vec::new(), limit: 3 };
+        out.write_all(b"abc").unwrap();
+        assert!(out.write_all(b"d").is_err());
+        assert_eq!(out.bytes, b"abc");
+    }
+}
