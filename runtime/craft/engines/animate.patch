+    assert!(checked_voices(&d, 8000).unwrap_err().contains("expanded envelope"));
+}
+
+#[test]
+fn checked_layout_refuses_truncation_and_quadratic_start_work() {
+    let mut d = nested(SymbolKind::Graphic, 2, &[(0, 1, with(SoundSync::Event, 1, false))],
