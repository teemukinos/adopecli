+fn inspect_frame(session: &mut Session, params: &Value) -> Result<Value> {
+    if params.as_object().is_none_or(|p| p.keys().any(|k| k != "frame")) {
+        return Err(EngineError::Param("frame inspection accepts only frame".into()));
+    }
+    let frame = match params.get("frame") {
+        None => 0,
+        Some(value) => {
+            value.as_u64().and_then(|v| u32::try_from(v).ok()).ok_or_else(|| EngineError::Param("frame must be an unsigned 32-bit integer".into()))?
+        }
+    };
+    let checked = anicraft_doc::eval_budget::checked_evaluate(&session.doc, frame).map_err(EngineError::Param)?;
+    Ok(json!({"frame":frame,"items":checked.display.items.len(),"groups":checked.display.groups.len(),
+        "clips":checked.display.clip_parents.len(),"evaluation":checked.work,"geometry":checked.geometry.report(),
+        "evaluation_budget_verified":true,"render_budget_verified":false,"media_integrity_verified":false,"document_changed":false}))
+}
