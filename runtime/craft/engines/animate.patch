+    Arc::make_mut(&mut doc.sounds[0]).frames += 1;
+    assert!(checked_html(&doc, &HtmlOptions::default()).err().unwrap().to_string().contains("complete native decoding"));
+    assert!(checked_html(&doc, &HtmlOptions { sound: false, ..Default::default() }).is_ok());
+    Arc::make_mut(&mut doc.bitmaps[0]).width = 2;
+    assert!(checked_html(&doc, &HtmlOptions { sound: false, ..Default::default() }).err().unwrap().to_string().contains("bitmap header"));
+}
