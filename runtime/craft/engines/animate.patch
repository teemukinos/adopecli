+fn invalid_scale_and_surface_limits_refuse_without_fallback() {
+    let mut doc = anicraft_doc::Document::default();
+    for scale in [0.0, -1.0, f32::NAN, f32::INFINITY] {
+        assert!(checked_render(&doc, 0, scale).is_err());
+    }
+    doc.stage.width = 4097;
+    doc.stage.height = 4097;
