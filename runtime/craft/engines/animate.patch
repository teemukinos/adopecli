+//! Checked Dobe exports. Compute every PNG before any destination is changed.
+//! Multi-file I/O failures still require the runtime's owned publication boundary.
+use crate::cmds_file::{gif_delays, scale_param};
+use crate::params::*;
+use crate::{EngineError, Result, Session, vfs};
+use anicraft_render::sequence::{CheckedSequence, LimitedBytes, MAX_ENCODED_BYTES, encode_png_limited, encode_rgba_limited};
+use serde_json::{Value, json};
+use std::path::Path;
+
+fn range(s: &Session, p: &Value) -> Result<(u32, u32)> {
+    let last = s.doc.frame_count().saturating_sub(1);
+    let from = opt_u32(p, "from")?.unwrap_or(0).min(last);
+    let to = opt_u32(p, "to")?.unwrap_or(last).min(last);
+    if to < from {
+        return Err(EngineError::Param("'to' must not be before 'from'".into()));
+    }
+    Ok((from, to))
+}
+
+fn output_path(path: &Path) -> Result<()> {
+    if !vfs::in_memory() {
+        crate::automation::path(path, true)?;
+    }
+    if vfs::is_dir(path) {
+        return Err(EngineError::Param("export output names an existing directory".into()));
+    }
+    Ok(())
+}
+
+pub(crate) fn gif(s: &Session, p: &Value) -> Result<Value> {
+    gif_limited(s, p, MAX_ENCODED_BYTES)
+}
+
+fn gif_limited(s: &Session, p: &Value, byte_limit: usize) -> Result<Value> {
+    let path = Path::new(str_req(p, "path")?);
+    let (from, to) = range(s, p)?;
+    let mut sequence = CheckedSequence::new(&s.doc, from, to, scale_param(p)?)?;
+    let (width, height) = sequence.dimensions();
+    let (Ok(w), Ok(h)) = (u16::try_from(width), u16::try_from(height)) else {
+        return Err(EngineError::Param("GIF frames are limited to 65535 px per side".into()));
+    };
+    let looping = opt_bool(p, "loop")?.unwrap_or(true);
+    let delays = gif_delays((to - from + 1) as usize, s.doc.stage.fps);
+    let error = |e: gif::EncodingError| EngineError::Format(e.to_string());
+    let mut encoder = gif::Encoder::new(LimitedBytes::new(byte_limit), w, h, &[]).map_err(error)?;
+    if looping {
+        encoder.set_repeat(gif::Repeat::Infinite).map_err(error)?;
+    }
+    crate::publish::tick(s.job.as_deref(), 0)?;
+    let mut frames = 0;
+    while let Some(pixels) = sequence.next_frame()? {
+        // Native quantization and delay calculation remain authoritative. The
+        // sequence pixel cap bounds quantization input; retain only this frame.
+        let mut rgba = pixels.to_rgba8();
+        let mut frame = gif::Frame::from_rgba_speed(w, h, &mut rgba, 10);
+        frame.delay = delays.get(frames).copied().ok_or_else(|| EngineError::State("GIF delay count differs from frames".into()))?;
+        encoder.write_frame(&frame).map_err(error)?;
+        frames += 1;
+        crate::publish::tick(s.job.as_deref(), 1)?;
+    }
+    let bytes = encoder.into_inner().map_err(error)?.into_bytes();
+    output_path(path)?;
+    crate::publish::tick(s.job.as_deref(), 0)?;
+    vfs::write(path, &bytes)?;
+    Ok(json!({"written":path.display().to_string(),"frames":frames,"bytes":bytes.len(),
+        "width":width,"height":height,"render_work":sequence.report()}))
+}
+
+pub(crate) fn sprite_sheet(s: &Session, p: &Value) -> Result<Value> {
+    let path = Path::new(str_req(p, "path")?);
+    if !path.extension().and_then(|v| v.to_str()).is_some_and(|v| v.eq_ignore_ascii_case("png")) {
+        return Err(EngineError::Param("sprite sheet path must end in .png".into()));
+    }
+    let (from, to) = range(s, p)?;
+    let scale = scale_param(p)?;
+    let mut sequence = CheckedSequence::new(&s.doc, from, to, scale)?;
+    if !opt_bool(p, "background")?.unwrap_or(false) {
+        sequence = sequence.transparent();
+    }
+    let n = (to - from + 1) as usize;
+    let pad = opt_u32(p, "padding")?.unwrap_or(0).min(256);
+    let cols = match opt_u32(p, "columns")? {
+        Some(0) => return Err(EngineError::Param("param 'columns' must be at least 1".into())),
+        Some(c) => (c as usize).min(n),
+        None => (n as f64).sqrt().ceil() as usize,
+    }
+    .max(1);
+    let rows = n.div_ceil(cols);
+    let (fw, fh) = sequence.dimensions();
+    let width = u64::from(fw) * cols as u64 + u64::from(pad) * (cols as u64 - 1);
+    let height = u64::from(fh) * rows as u64 + u64::from(pad) * (rows as u64 - 1);
+    let pixels = width
+        .checked_mul(height)
+        .filter(|&n| n <= anicraft_render::MAX_PIXELS)
+        .filter(|_| width <= u64::from(u32::MAX) && height <= u64::from(u32::MAX))
+        .ok_or_else(|| EngineError::Param("sprite sheet exceeds its pixel limit".into()))?;
+    let stem = path.file_stem().map_or_else(|| "frame".to_string(), |v| v.to_string_lossy().into_owned());
+    if stem.len() > 256 {
+        return Err(EngineError::Param("sprite sheet name exceeds 256 bytes".into()));
+    }
+    // One RGBA8 canvas replaces the old retained collection of floating-point
+    // frames plus another floating-point canvas. At most MAX_PIXELS * 4 bytes.
+    let mut canvas = Vec::new();
+    canvas.try_reserve_exact(pixels as usize * 4).map_err(|e| EngineError::State(e.to_string()))?;
+    canvas.resize(pixels as usize * 4, 0u8);
+    let delays = gif_delays(n, s.doc.stage.fps);
+    let mut map = serde_json::Map::new();
+    crate::publish::tick(s.job.as_deref(), 0)?;
+    let mut index = 0usize;
+    while let Some(frame) = sequence.next_frame()? {
+        let rgba = frame.to_rgba8();
+        let x = index % cols * (fw as usize + pad as usize);
+        let y = index / cols * (fh as usize + pad as usize);
+        let row_bytes = fw as usize * 4;
+        for (row, src) in rgba.chunks_exact(row_bytes).enumerate() {
+            let at = ((y + row) * width as usize + x) * 4;
+            let dst = canvas.get_mut(at..at + row_bytes).ok_or_else(|| EngineError::State("sprite row lies outside canvas".into()))?;
+            dst.copy_from_slice(src);
+        }
+        let delay = delays.get(index).copied().ok_or_else(|| EngineError::State("sprite delay count differs from frames".into()))?;
+        map.insert(
+            format!("{stem}_{:04}", u64::from(from) + index as u64 + 1),
+            json!({
+                "frame":{"x":x,"y":y,"w":fw,"h":fh},"rotated":false,"trimmed":false,
+                "spriteSourceSize":{"x":0,"y":0,"w":fw,"h":fh},"sourceSize":{"w":fw,"h":fh},"duration":u32::from(delay)*10,
+            }),
+        );
+        index += 1;
+        crate::publish::tick(s.job.as_deref(), 1)?;
+    }
+    let png = encode_rgba_limited(width as u32, height as u32, &canvas, MAX_ENCODED_BYTES)?;
+    let image = path.file_name().map_or_else(String::new, |v| v.to_string_lossy().into_owned());
+    let atlas = json!({"frames":map,"meta":{"app":"Dobe Animate","version":env!("CARGO_PKG_VERSION"),
+        "image":image,"format":"RGBA8888","size":{"w":width,"h":height},"scale":scale.to_string(),"frameRate":s.doc.stage.fps}});
+    let mut text = LimitedBytes::new(4 << 20);
+    serde_json::to_writer_pretty(&mut text, &atlas).map_err(|e| EngineError::Format(e.to_string()))?;
+    let text = text.into_bytes();
+    let json_path = path.with_extension("json");
+    output_path(path)?;
+    output_path(&json_path)?;
+    crate::publish::tick(s.job.as_deref(), 0)?;
+    vfs::write(path, png)?;
+    vfs::write(&json_path, text)?;
+    Ok(json!({"written":path.display().to_string(),"map":json_path.display().to_string(),
+        "frames":n,"columns":cols,"rows":rows,"width":width,"height":height,"render_work":sequence.report()}))
+}
+
+pub(crate) fn png_sequence(s: &Session, dir: &Path, from: u32, to: u32, scale: f32) -> Result<Value> {
+    let mut sequence = CheckedSequence::new(&s.doc, from, to, scale)?;
+    let mut encoded = Vec::new();
+    let mut retained = 0usize;
+    crate::publish::tick(s.job.as_deref(), 0)?;
+    while let Some(pixels) = sequence.next_frame()? {
+        let png = encode_png_limited(&pixels, MAX_ENCODED_BYTES.saturating_sub(retained))?;
+        retained += png.len();
+        encoded.push(png);
+        crate::publish::tick(s.job.as_deref(), 1)?;
+    }
+    // Preflight all paths after computation and before creating the destination.
+    // The operation runs inside an owned root, not an adversarial mutable tree.
+    for offset in 0..encoded.len() {
+        let file = dir.join(format!("frame_{:05}.png", u64::from(from) + offset as u64 + 1));
+        if !vfs::in_memory() {
+            crate::automation::path(&file, true)?;
+        }
+        if vfs::is_dir(&file) {
+            return Err(crate::EngineError::Param("sequence output names an existing directory".into()));
+        }
+    }
+    crate::publish::tick(s.job.as_deref(), 0)?;
+    vfs::create_dir_all(dir)?;
+    let frames = encoded.len();
+    for (offset, png) in encoded.into_iter().enumerate() {
+        vfs::write(&dir.join(format!("frame_{:05}.png", u64::from(from) + offset as u64 + 1)), png)?;
+    }
+    Ok(json!({"frames":frames,"dir":dir.display().to_string(),"encoded_bytes":retained,
+        "render_work":sequence.report()}))
+}
+
