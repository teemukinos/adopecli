+    // A sound only on a guide makes the symbol sounding, without placing any voices.
+    let mut d = nested(SymbolKind::Graphic, 1, &[(0, 1, with(SoundSync::Event, 1, false))],
+        &[(0, 100000, LoopMode::Loop, 0, 90)], 10);
+    Arc::make_mut(&mut Arc::make_mut(&mut d.library[0]).timeline.layers[0]).kind = LayerKind::Guide;
