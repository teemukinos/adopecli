diff --git a/crates/engine/src/automation.rs b/crates/engine/src/automation.rs
new file mode 100644
index 0000000..a1c9f90
--- /dev/null
+++ b/crates/engine/src/automation.rs
@@ -0,0 +1,157 @@
+//! Explicit filesystem roots for the headless Dobe entry.
+//! This constrains engine access in an owned attempt directory, not a hostile
+//! filesystem that another process can mutate between validation and opening.
+use std::cell::RefCell;
+use std::io;
+use std::path::{Component, Path, PathBuf};
+
+#[derive(Clone)]
+struct Roots {
+    read: PathBuf,
+    write: PathBuf,
+}
+thread_local! { static ROOTS: RefCell<Option<Roots>> = const { RefCell::new(None) }; }
+fn denied(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::PermissionDenied, message)
+}
+
+pub fn configure(read: &Path, write: &Path) -> io::Result<()> {
+    if !read.is_absolute() || !write.is_absolute() {
+        return Err(denied("Dobe automation roots must be absolute"));
+    }
+    let roots = Roots { read: read.canonicalize()?, write: write.canonicalize()? };
+    if !roots.read.is_dir() || !roots.write.is_dir() {
+        return Err(denied("Dobe automation roots must be existing directories"));
+    }
+    ROOTS.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if slot.is_some() {
+            return Err(denied("Dobe automation roots are already configured"));
+        }
+        *slot = Some(roots);
+        Ok(())
+    })
+}
+
+pub fn path(path: &Path, write: bool) -> io::Result<PathBuf> {
+    if path.as_os_str().is_empty() || path.components().any(|c| matches!(c, Component::ParentDir | Component::Prefix(_))) {
+        return Err(denied("Dobe path must not be empty or contain parent traversal"));
+    }
+    ROOTS.with(|slot| {
+        let slot = slot.borrow();
+        let roots = slot.as_ref().ok_or_else(|| denied("Dobe automation roots are required"))?;
+        let base = if write { &roots.write } else { &roots.read };
+        let candidate = if path.is_absolute() { path.to_path_buf() } else { base.join(path) };
+        let root = if candidate.starts_with(&roots.write) {
+            &roots.write
+        } else if !write && candidate.starts_with(&roots.read) {
+            &roots.read
+        } else {
+            return Err(denied("Dobe path leaves the permitted root"));
+        };
+        // Check the root itself too: replacing an attempt root with a link must fail.
+        if root.canonicalize()? != *root {
+            return Err(denied("Dobe root changed since configuration"));
+        }
+        let mut current = root.clone();
+        let suffix = candidate.strip_prefix(root).map_err(|_| denied("Dobe path leaves its root"))?;
+        let mut paths = vec![current.clone()];
+        for part in suffix.components() {
+            current.push(part.as_os_str());
+            paths.push(current.clone());
+        }
+        for current in paths {
+            match std::fs::symlink_metadata(&current) {
+                Ok(metadata) if metadata.file_type().is_symlink() => return Err(denied("Dobe paths must not contain symbolic links")),
+                Ok(_) => {}
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(error) => return Err(error),
+            }
+        }
+        Ok(candidate)
+    })
+}
+
+pub fn command(id: &str) -> crate::Result<()> {
+    if id.starts_with("plugin.") || id == "file.export_video" {
+        return Err(crate::EngineError::Param(
+            "Dobe Animate refuses external plugins and executable-based video export; use native frame exports".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Resolve file command paths before overwrite confirmation and native execution.
+/// Reads and writes with the same relative spelling can live in different roots.
+pub fn parameters(id: &str, params: &serde_json::Value) -> crate::Result<serde_json::Value> {
+    let mut result = params.clone();
+    if id.starts_with("file.") {
+        let writing = id.starts_with("file.export_") || matches!(id, "file.save" | "file.save_as" | "file.autosave" | "file.discard_recovery");
+        for key in ["path", "dir"] {
+            if let Some(value) = result.get(key).and_then(serde_json::Value::as_str) {
+                let checked = path(Path::new(value), writing)?;
+                result[key] = serde_json::json!(checked);
+            }
+        }
+    }
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn roots_are_required_and_read_cannot_be_used_to_write() {
+        std::thread::spawn(|| {
+            assert!(path(Path::new("missing"), false).is_err());
+            let base = std::env::temp_dir().join(format!("dobe-animate-roots-{}", std::process::id()));
+            let read = base.join("read");
+            let write = base.join("write");
+            std::fs::create_dir_all(&read).unwrap();
+            std::fs::create_dir_all(&write).unwrap();
+            let read = read.canonicalize().unwrap();
+            let write = write.canonicalize().unwrap();
+            configure(&read, &write).unwrap();
+            assert!(configure(&read, &write).is_err());
+            assert_eq!(path(Path::new("input"), false).unwrap(), read.canonicalize().unwrap().join("input"));
+            assert!(path(&read.join("input"), true).is_err());
+            assert!(path(Path::new("../input"), false).is_err());
+            assert!(path(&base.join("other"), false).is_err());
+            assert!(path(Path::new("output/deep/file"), true).unwrap().starts_with(write.canonicalize().unwrap()));
+            #[cfg(unix)]
+            {
+                std::os::unix::fs::symlink(&read, write.join("link")).unwrap();
+                assert!(path(&write.join("link/file"), true).unwrap_err().to_string().contains("symbolic"));
+                std::os::unix::fs::symlink(base.join("absent"), write.join("dangling")).unwrap();
+                assert!(path(&write.join("dangling"), true).unwrap_err().to_string().contains("symbolic"));
+            }
+            std::fs::write(read.join("input"), b"original").unwrap();
+            assert_eq!(crate::vfs::read(Path::new("input")).unwrap(), b"original");
+            crate::vfs::write(Path::new("output"), b"result").unwrap();
+            assert_eq!(std::fs::read(write.join("output")).unwrap(), b"result");
+            assert!(crate::vfs::write(&read.join("input"), b"loss").is_err());
+            assert_eq!(std::fs::read(read.join("input")).unwrap(), b"original");
+            let mut session = crate::Session::default();
+            std::fs::write(write.join("saved.anicraft"), b"owned").unwrap();
+            let error = session.execute("file.save", &serde_json::json!({"path":"saved.anicraft"})).unwrap_err();
+            assert!(matches!(error, crate::EngineError::NeedsConfirmation(_)));
+            assert_eq!(std::fs::read(write.join("saved.anicraft")).unwrap(), b"owned");
+            session.execute("file.save", &serde_json::json!({"path":"new.anicraft"})).unwrap();
+            assert_eq!(session.path, Some(write.join("new.anicraft")));
+            assert!(write.join("new.anicraft").is_file());
+            assert!(!read.join("new.anicraft").exists());
+            std::fs::remove_dir_all(base).unwrap();
+        })
+        .join()
+        .unwrap();
+    }
+    #[test]
+    fn command_denies_external_execution() {
+        for id in ["plugin.install", "plugin.reload", "plugin.run", "file.export_video"] {
+            assert!(command(id).is_err());
+        }
+        for id in ["draw.rect", "file.save", "file.export_png", "file.export_gif"] {
+            assert!(command(id).is_ok());
+        }
+    }
+}
