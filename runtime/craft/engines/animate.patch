+#[test]
+fn nested_scopes_cannot_reset_failure_or_counters() {
+    let b = limited(Work::Helper, 1);
+    let fresh = Budget::new(Default::default());
+    assert!(
+        b.run(|| {
+            assert!(charge(Work::Helper, 1));
+            fresh.run(|| charge(Work::Helper, 1))
+        })
+        .is_err()
+    );
+    assert_eq!(b.report()["helper_steps"], 2);
+    assert_eq!(fresh.report()["helper_steps"], 0);
+    let mut called = false;
+    assert!(b.run(|| called = true).is_err());
+    assert!(!called);
+    assert!(!active() && geometry::current().is_none());
+}
+
+#[test]
+fn dispatched_context_overrides_and_restores_an_unrelated_waiting_worker() {
+    let a = Budget::new(Default::default());
+    let b = Budget::new(Default::default());
+    let captured = b.run(capture).unwrap();
+    let unscoped = capture();
+    a.run(|| {
+        assert!(charge(Work::Helper, 1));
+        assert!(geometry::charge(geometry::Work::Path, 1));
+        captured.run(|| {
+            assert!(charge(Work::Helper, 7));
+            assert!(geometry::charge(geometry::Work::Path, 7));
+        });
+        unscoped.run(|| {
+            assert!(!active() && geometry::current().is_none());
+            assert!(charge(Work::Helper, 100));
+        });
+        assert!(active());
+        assert!(charge(Work::Helper, 1));
+        assert!(geometry::charge(geometry::Work::Path, 1));
+    })
+    .unwrap();
+    assert_eq!(a.report()["helper_steps"], 2);
+    assert_eq!(a.report()["geometry"]["path_commands"], 2);
+    assert_eq!(b.report()["helper_steps"], 7);
+    assert_eq!(b.report()["geometry"]["path_commands"], 7);
+}
