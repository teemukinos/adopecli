new file mode 100644
index 0000000..63050f0
--- /dev/null
+++ b/crates/doc/src/sound_budget.rs
@@ -0,0 +1,97 @@
+//! Bounded native sound layout for automation. Defaults keep legacy playback;
+//! checked layout returns an error instead of a partial or unbounded soundtrack.
+use serde::Serialize;
+
+#[derive(Clone, Debug, Default, Serialize)]
+pub struct SoundWork {
+    pub timeline_calls: usize,
+    pub layer_visits: usize,
+    pub keyframe_visits: usize,
+    pub element_visits: usize,
+    pub continuity_steps: usize,
+    pub placements: usize,
+    pub envelope_points: usize,
+    pub resolution_checks: usize,
+    pub decoded_samples: usize,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum Work {
+    Timeline,
+    Layer,
+    Keyframe,
+    Element,
+    Continuity,
+    Placement,
+    Envelope,
+    Resolve,
+}
+
+#[derive(Default)]
+pub(crate) struct Guard {
+    pub checked: bool,
+    pub work: SoundWork,
+    pub error: Option<&'static str>,
+}
+
+impl Guard {
+    pub fn charge(&mut self, kind: Work, count: usize) -> bool {
+        if !self.checked {
+            return true;
+        }
+        if self.error.is_some() {
+            return false;
+        }
+        let (value, limit, message) = match kind {
+            Work::Timeline => (&mut self.work.timeline_calls, 100_000, "sound layout exceeds its timeline budget"),
+            Work::Layer => (&mut self.work.layer_visits, 1_000_000, "sound layout exceeds its layer budget"),
+            Work::Keyframe => (&mut self.work.keyframe_visits, 1_000_000, "sound layout exceeds its keyframe budget"),
+            Work::Element => (&mut self.work.element_visits, 1_000_000, "sound layout exceeds its element budget"),
+            Work::Continuity => (&mut self.work.continuity_steps, 1_000_000, "sound layout exceeds its instance continuity budget"),
+            Work::Placement => (&mut self.work.placements, 8192, "sound layout exceeds 8192 expanded placements"),
+            Work::Envelope => (&mut self.work.envelope_points, 262_144, "sound layout exceeds its expanded envelope budget"),
+            Work::Resolve => (&mut self.work.resolution_checks, 2_000_000, "sound layout exceeds its start/stop resolution budget"),
+        };
+        *value = value.saturating_add(count);
+        if *value > limit {
+            self.error = Some(message);
+            false
+        } else {
+            true
+        }
+    }
+
+    pub fn truncated(&mut self) {
+        if self.checked && self.error.is_none() {
+            self.error = Some("native sound layout would truncate nested timelines");
+        }
+    }
+}
+
+/// Bound the stored graph before building the sounding-symbol index. This is not
+/// document admission; the runtime separately validates references and geometry.
+pub(crate) fn preflight(doc: &crate::Document) -> Result<(), String> {
+    if !(1.0..=240.0).contains(&doc.stage.fps) || doc.scenes.len() > 64 || doc.library.len() > 512 {
+        return Err("sound layout exceeds its document budget".into());
+    }
+    let (mut layers, mut keys, mut elements) = (0usize, 0usize, 0usize);
+    for timeline in doc.timelines() {
+        layers = layers.saturating_add(timeline.layers.len());
+        if layers > 1024 {
+            return Err("sound layout exceeds 1024 stored layers".into());
+        }
+        for layer in &timeline.layers {
+            keys = keys.saturating_add(layer.keyframes.len());
+            if keys > 8192 {
+                return Err("sound layout exceeds 8192 stored keyframes".into());
+            }
+            for key in &layer.keyframes {
+                elements = elements.saturating_add(key.elements.len());
+                if elements > 32768 {
+                    return Err("sound layout exceeds 32768 stored elements".into());
+                }
+            }
+        }
+    }
+    Ok(())
+}
