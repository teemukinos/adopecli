+#[test]
+fn repeated_bitmap_use_does_not_reset_aggregate_pixel_accounting() {
+    let mut doc = bitmap_doc();
+    let mut second = (*doc.bitmaps[0]).clone();
+    second.id = BitmapId(21);
+    doc.bitmaps.push(Arc::new(second));
+    let state = Rc::new(RefCell::new(State { work: FrameWork { decoded_pixels: 63_999_997, ..Default::default() }, ..Default::default() }));
+    let restore = Scope(CURRENT.with(|slot| slot.replace(Some(state.clone()))));
+    let budget = budget::Budget::default();
+    budget
+        .run(|| {
+            let one = bitmap(&doc, BitmapId(20)).unwrap();
+            let two = bitmap(&doc, BitmapId(20)).unwrap();
+            assert!(Arc::ptr_eq(&one, &two));
+            assert_eq!(state.borrow().work.decoded_pixels, 63_999_999);
+            assert!(bitmap(&doc, BitmapId(21)).is_none());
+            assert!(state.borrow().error.unwrap().contains("pixel budget"));
+        })
+        .unwrap();
+    drop(restore);
+    assert!(!active());
+}
