+//! Opt-in work accounting around the native geometry algorithms.
+//!
+//! Legacy calls outside a scope keep their behavior. Inside a scope, exhausted
+//! primitives stop producing geometry and latch an error. Only the result of
+//! `Budget::run` may be consumed; intermediate fallback values are not valid
+//! output. A scope must contain computation, not file publication. Worker threads
+//! must explicitly enter a clone of the same budget; thread locals do not inherit.
+use crate::{Affine, Path, PathCmd, Vec2};
+use serde::Serialize;
+use std::cell::RefCell;
+use std::sync::{
+    Arc,
+    atomic::{AtomicU8, AtomicUsize, Ordering},
+};
+
+/// Deterministic work units, not CPU time or peak bytes.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct GeometryWork {
+    pub path_commands: usize,
+    pub flatten_points: usize,
+    pub morph_steps: usize,
+    pub sliced_commands: usize,
+    pub walk_steps: usize,
+}
+
+#[derive(Clone, Copy)]
+pub enum Work {
+    Path,
+    Flatten,
+    Morph,
+    Slice,
+    Walk,
+}
+
+#[derive(Clone, Copy)]
+pub enum Failure {
+    Coordinates = 6,
+    FlattenCap,
+    MorphCap,
+    SliceFallback,
+    WalkCap,
+}
+
+struct State {
+    used: [AtomicUsize; 5],
+    limits: [usize; 5],
+    failure: AtomicU8,
+    parent: Option<Budget>,
+}
+
+/// Share one instance across all geometry in a checked operation.
+#[derive(Clone)]
+pub struct Budget(Arc<State>);
+
+thread_local! { static CURRENT: RefCell<Option<Budget>> = const { RefCell::new(None) }; }
+
+#[cfg(test)]
+mod export_budget_tests {
+    use super::*;
+    #[test]
+    fn children_share_aggregate_geometry_and_keep_frame_caps() {
+        let export = Budget::with_limits([5; 5]);
+        let first = export.frame_child();
+        first.run_worker(|| assert!(charge(Work::Path, 3))).unwrap();
+        let second = export.frame_child();
+        assert!(second.run_worker(|| assert!(!charge(Work::Path, 3))).is_err());
+        assert!(first.check().is_err());
+        assert_eq!(export.report().path_commands, 6);
+        let export = Budget::export();
+        let child = export.frame_child();
+        assert!(child.run_worker(|| assert!(!charge(Work::Path, 2_000_001))).is_err());
+        assert!(export.check().is_ok());
+    }
+}
+
+impl Default for Budget {
+    fn default() -> Self {
+        Self::with_limits([2_000_000, 2_000_000, 20_000_000, 2_000_000, 10_000_000])
+    }
+}
+
+impl Budget {
+    fn with_limits(limits: [usize; 5]) -> Self {
+        Self(Arc::new(State { used: std::array::from_fn(|_| AtomicUsize::new(0)), limits, failure: AtomicU8::new(0), parent: None }))
+    }
+
+    /// Aggregate geometry limits for a bounded multi-frame export.
+    pub fn export() -> Self {
+        Self::with_limits([32_000_000, 32_000_000, 160_000_000, 32_000_000, 80_000_000])
+    }
+
+    /// A fresh frame retains its own limits and charges the export before work.
+    pub fn frame_child(&self) -> Self {
+        Self(Arc::new(State {
+            used: std::array::from_fn(|_| AtomicUsize::new(0)),
+            limits: [2_000_000, 2_000_000, 20_000_000, 2_000_000, 10_000_000],
+            failure: AtomicU8::new(0), parent: Some(self.clone()),
+        }))
+    }
+
+    /// Enter a shared scope. Nested calls reuse the existing scope: constructing
+    /// another Budget cannot reset an operation's counters or clear its failure.
+    /// The previous scope is restored even during unwinding.
+    pub fn run<T>(&self, compute: impl FnOnce() -> T) -> Result<T, String> {
+        let active = current().unwrap_or_else(|| self.clone());
+        let restore = Restore(CURRENT.with(|slot| slot.replace(Some(active.clone()))));
+        active.check()?;
+        let result = compute();
+        let checked = active.check().map(|()| result);
+        drop(restore);
+        checked
+    }
+
+    pub fn report(&self) -> GeometryWork {
+        let get = |kind: Work| self.0.used.get(kind as usize).map_or(0, |v| v.load(Ordering::Relaxed));
+        GeometryWork {
+            path_commands: get(Work::Path),
+            flatten_points: get(Work::Flatten),
+            morph_steps: get(Work::Morph),
+            sliced_commands: get(Work::Slice),
+            walk_steps: get(Work::Walk),
+        }
+    }
+
+    /// Enter the budget captured by a worker's dispatcher, restoring any scope
+    /// already on that thread. A work-stealing pool can execute another job while
+    /// a scoped parent waits; that unrelated thread-local budget must not win.
+    /// Only dispatchers should use this; nested computation uses `run`.
+    pub fn run_worker<T>(&self, compute: impl FnOnce() -> T) -> Result<T, String> {
+        let restore = Restore(CURRENT.with(|slot| slot.replace(Some(self.clone()))));
+        let result = self.run(compute);
+        drop(restore);
+        result
+    }
+
+    pub fn check(&self) -> Result<(), String> {
+        if let Some(parent) = &self.0.parent { parent.check()?; }
+        let message = match self.0.failure.load(Ordering::Relaxed) {
+            0 => return Ok(()),
+            1 => "geometry exceeds its path command budget",
+            2 => "geometry exceeds its flatten point budget",
+            3 => "geometry exceeds its morph work budget",
+            4 => "geometry exceeds its sliced command budget",
+            5 => "geometry exceeds its path walking budget",
+            6 => "geometry contains nonfinite or excessive composed coordinates",
+            7 => "native curve flattening would exceed its segment cap",
+            8 => "native morphing would exceed its segment cap",
+            9 => "native nine-slice would use its approximate fallback",
+            10 => "native curve walking would truncate its segments",
+            _ => "geometry budget failed",
+        };
+        Err(message.into())
+    }
+
+    fn fail(&self, code: u8) {
+        let _ = self.0.failure.compare_exchange(0, code, Ordering::Relaxed, Ordering::Relaxed);
+    }
+
+    fn charge(&self, kind: Work, count: usize) -> bool {
+        if self.0.failure.load(Ordering::Relaxed) != 0 {
+            return false;
+        }
+        if let Some(parent) = &self.0.parent && !parent.charge(kind, count) { return false; }
+        let index = kind as usize;
+        let (Some(used), Some(&limit)) = (self.0.used.get(index), self.0.limits.get(index)) else { return false };
+        let mut previous = used.load(Ordering::Relaxed);
+        loop {
+            match used.compare_exchange_weak(previous, previous.saturating_add(count), Ordering::Relaxed, Ordering::Relaxed) {
+                Ok(_) => break,
+                Err(actual) => previous = actual,
+            }
+        }
+        if count <= limit.saturating_sub(previous) && previous <= limit {
+            return true;
+        }
+        self.fail(index as u8 + 1);
+        false
+    }
+}
+
+struct Restore(Option<Budget>);
+impl Drop for Restore {
+    fn drop(&mut self) {
+        CURRENT.with(|slot| {
+            slot.replace(self.0.take());
+        });
+    }
+}
+
+/// Capture the active budget before dispatching workers; enter it in each worker.
+pub fn current() -> Option<Budget> {
+    CURRENT.with(|slot| slot.borrow().clone())
+}
+
+/// Dispatch an unscoped task without inheriting a waiting worker's unrelated
+/// scope. This is the unscoped counterpart of `Budget::run_worker`.
+pub fn unscoped_worker<T>(compute: impl FnOnce() -> T) -> T {
+    let restore = Restore(CURRENT.with(|slot| slot.replace(None)));
+    let result = compute();
+    drop(restore);
+    result
+}
+
+pub fn charge(kind: Work, count: usize) -> bool {
+    CURRENT.with(|slot| slot.borrow().as_ref().is_none_or(|b| b.charge(kind, count)))
+}
+
+/// True only in an active scope. Outside a scope the native fallback remains valid.
+pub fn fail(reason: Failure) -> bool {
+    CURRENT.with(|slot| {
+        if let Some(b) = slot.borrow().as_ref() {
+            b.fail(reason as u8);
+            true
+        } else {
+            false
+        }
+    })
+}
+
+pub fn healthy() -> bool {
+    CURRENT.with(|slot| slot.borrow().as_ref().is_none_or(|b| b.0.failure.load(Ordering::Relaxed) == 0))
+}
+
+pub fn point(p: Vec2) -> bool {
+    if p.is_finite() && p.x.abs() <= 1.0e9 && p.y.abs() <= 1.0e9 {
+        return healthy();
+    }
+    !fail(Failure::Coordinates)
+}
+
+/// Charge the scan before visiting controls. Check actual transformed points,
+/// not merely finite matrix coefficients (finite products can still overflow).
+pub fn path(path: &Path, transform: &Affine) -> bool {
+    if current().is_none() {
+        return true;
+    }
+    if !charge(Work::Path, path.cmds.len()) {
+        return false;
+    }
+    for command in &path.cmds {
+        let valid = match *command {
+            PathCmd::MoveTo(p) | PathCmd::LineTo(p) => point(transform.apply(p)),
+            PathCmd::QuadTo(a, p) => point(transform.apply(a)) && point(transform.apply(p)),
+            PathCmd::CubicTo(a, b, p) => point(transform.apply(a)) && point(transform.apply(b)) && point(transform.apply(p)),
+            PathCmd::Close => true,
+        };
+        if !valid {
+            return false;
+        }
+    }
+    true
+}
