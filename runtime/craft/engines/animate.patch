+        assert_eq!(report["render_budget_verified"], false);
+        assert_eq!(report["media_integrity_verified"], false);
+        assert_eq!(report["document_changed"], false);
+        for bad in [
+            json!({"frame":null}),
+            json!({"frame":true}),
+            json!({"frame":-1}),
+            json!({"frame":0.5}),
+            json!({"frame":"0"}),
+            json!({"frame":4294967296u64}),
+            json!({"other":0}),
+            json!([]),
