+//! Work bounds for native HTML baking. This qualifies construction, not browser
+//! raster fidelity, script semantics beyond the native player, or stored media
+//! integrity beyond the explicitly checked decoders.
+use super::{HtmlExport, HtmlOptions};
+use crate::{RenderError, budget};
+use anicraft_doc::actions::{Action, FrameRef};
+use anicraft_doc::{Document, FrameScript, Sound, SoundFormat, SymbolId, Timeline};
+use serde_json::Value;
+use std::{fmt, io, sync::Arc};
+
+pub const MAX_CHECKED_HTML_BYTES: usize = 64 << 20;
+pub const MAX_BAKED_FRAMES: usize = 6000;
+
+pub struct CheckedHtml {
+    pub output: HtmlExport,
+    pub work: Value,
+}
+
+pub fn checked_html(doc: &Document, opts: &HtmlOptions) -> Result<CheckedHtml, RenderError> {
+    let scope = budget::Budget::document_export();
+    let (output, evaluation) = scope
+        .run_worker(|| {
+            anicraft_doc::eval_budget::checked_operation(doc, || {
+                if !preflight(doc, opts) {
+                    return Err("HTML metadata exceeds checked bounds".into());
+                }
+                let fresh = fresh_scripts(doc);
+                super::to_html(&fresh, opts)
+            })
+            .map_err(RenderError::Budget)
+        })
+        .map_err(RenderError::Budget)??;
+    Ok(CheckedHtml { output, work: serde_json::json!({"evaluation": evaluation, "serialization": scope.report()}) })
+}
+
+pub(super) fn reserve(bytes: usize, helpers: usize) -> bool {
+    budget::reserve::<u8>(bytes) && budget::charge(budget::Work::Helper, helpers)
+}
+
+pub(super) fn text(value: &str) -> bool {
+    budget::require(value.len() <= 4096, "HTML metadata string exceeds 4096 UTF-8 bytes")
+        && reserve(value.len().saturating_mul(16).saturating_add(512), value.len().saturating_add(1))
+}
+
+pub(super) fn action(a: &Action) -> bool {
+    if !budget::active() {
+        return true;
+    }
+    if !reserve(4096, 64) || a.target().is_some_and(|t| !text(&t.0)) {
+        return false;
+    }
+    match a {
+        Action::Trace { message } => text(message),
+        Action::GotoAndPlay { frame, scene, .. } | Action::GotoAndStop { frame, scene, .. } => {
+            scene.as_ref().is_none_or(|s| text(s))
+                && match frame {
+                    FrameRef::Label(s) => text(s),
+                    FrameRef::Number(_) => true,
+                }
+        }
+        Action::SetProperty { value, .. } => budget::require(value.is_finite(), "HTML action has a nonfinite value"),
+        _ => true,
+    }
+}
+
+fn preflight(doc: &Document, opts: &HtmlOptions) -> bool {
+    if !text(&opts.title)
+        || !text(&doc.document_class)
+        || !budget::require(
+            (1.0..=240.0).contains(&doc.stage.fps) && (1..=16384).contains(&doc.stage.width) && (1..=16384).contains(&doc.stage.height),
+            "HTML stage exceeds checked bounds",
+        )
+        || !budget::require(doc.sounds.len() <= 256, "HTML exceeds 256 stored sounds")
+        || !reserve(65536, 1)
+    {
+        return false;
+    }
+    for scene in &doc.scenes {
+        if !text(&scene.name) {
+            return false;
+        }
+    }
+    for symbol in &doc.library {
+        if !text(&symbol.name) || symbol.linkage.as_ref().is_some_and(|l| !text(&l.class) || !text(&l.base)) {
+            return false;
+        }
+    }
+    let mut script_bytes = 0usize;
+    for tl in doc.timelines() {
+        if !reserve(tl.layers.len().saturating_mul(256), tl.layers.len().saturating_mul(tl.layers.len().saturating_add(1))) {
+            return false;
+        }
+        for layer in &tl.layers {
+            if !text(&layer.name) || !reserve(layer.keyframes.len().saturating_mul(2048), layer.keyframes.len()) {
+                return false;
+            }
+            for key in &layer.keyframes {
+                if !text(&key.label) || !reserve(key.elements.len().saturating_mul(128), key.elements.len()) {
+                    return false;
+                }
+                if let Some(motion) = &key.motion {
+                    let keys = motion.tracks.iter().map(|t| t.keys.len()).sum::<usize>();
+                    let path = motion.path.as_ref().map_or(0, |p| p.cmds.len());
+                    if !reserve(
+                        keys.saturating_mul(512).saturating_add(path.saturating_mul(128)).saturating_add(motion.pins.len().saturating_mul(128)),
+                        keys,
+                    ) {
+                        return false;
+                    }
+                }
+                match &key.script {
+                    Some(FrameScript::Actions(actions)) => {
+                        if !budget::require(actions.len() <= 256, "HTML frame exceeds 256 actions") || !actions.iter().all(action) {
+                            return false;
+                        }
+                    }
+                    Some(FrameScript::Plugin(p)) => {
+                        if !text(&p.id) || !text(&p.entry) {
+                            return false;
+                        }
+                    }
+                    Some(FrameScript::Source(src)) => {
+                        script_bytes = script_bytes.saturating_add(src.text.len());
+                        // The native AS3 compiler also bounds tokens and recursion.
+                        // Cover compilation, declarations, comparison and JSON copies
+                        // before invoking it, even when a source cache is already warm.
+                        if !budget::require(
+                            src.text.len() <= anicraft_doc::actions::MAX_SOURCE_BYTES && script_bytes <= 1 << 20,
+                            "HTML source scripts exceed their byte budget",
+                        ) || !reserve(
+                            src.text.len().saturating_mul(256).saturating_add(8192),
+                            src.text.len().saturating_mul(64).saturating_add(8192),
+                        ) {
+                            return false;
+                        }
+                    }
+                    None => {}
+                }
+                if let Some(sound) = &key.sound
+                    && let anicraft_doc::SoundEffect::Custom(points) = &sound.effect
+                    && (!budget::require(
+                        points.len() <= 16
+                            && points
+                                .iter()
+                                .all(|p| p.at.is_finite() && (0.0..=86400.0).contains(&p.at) && p.left.is_finite() && p.right.is_finite()),
+                        "HTML sound envelope would truncate or sanitize invalid points",
+                    ) || !reserve(points.len().saturating_mul(1024), points.len().saturating_mul(32)))
+                {
+                    return false;
+                }
+            }
+        }
+    }
+    true
+}
+
+/// SourceScript's legacy cache does not track in-place edits to public text.
+/// Refresh only the scripts in a private structural copy; input remains intact.
+fn fresh_scripts(doc: &Document) -> Document {
+    fn timeline(tl: &mut Timeline) {
+        for layer in &mut tl.layers {
+            if !layer.keyframes.iter().any(|k| matches!(k.script, Some(FrameScript::Source(_)))) {
+                continue;
+            }
+            for key in &mut Arc::make_mut(layer).keyframes {
+                if let Some(FrameScript::Source(src)) = &key.script {
+                    let fresh = FrameScript::Source(Arc::new((**src).clone()));
+                    Arc::make_mut(key).script = Some(fresh);
+                }
+            }
+        }
+    }
+    let mut fresh = doc.clone();
+    for scene in &mut fresh.scenes {
+        timeline(&mut Arc::make_mut(scene).timeline);
+    }
+    for symbol in &mut fresh.library {
+        timeline(&mut Arc::make_mut(symbol).timeline);
+    }
+    fresh
+}
+
+pub(super) fn timelines(doc: &Document, used: &[SymbolId]) -> bool {
+    if !budget::active() {
+        return true;
+    }
+    let mut frames = 0usize;
+    for tl in doc.scenes.iter().map(|s| &s.timeline).chain(used.iter().filter_map(|id| doc.symbol(*id).map(|s| &s.timeline))) {
+        frames = frames.saturating_add(tl.frame_count() as usize);
+        if !budget::require(frames <= MAX_BAKED_FRAMES, "HTML exceeds 6000 baked timeline frames") {
+            return false;
+        }
+    }
+    reserve(frames.saturating_mul(2048), frames)
+}
+
+pub(super) fn paint(paint: &anicraft_doc::Paint, transform: &anicraft_geom::Affine) -> bool {
+    if !budget::active() {
+        return true;
+    }
+    use anicraft_doc::Paint;
+    use anicraft_geom::{Vec2, budget as geometry};
+    let stops = match paint {
+        Paint::Linear { stops, .. } | Paint::Radial { stops, .. } => stops.as_slice(),
+        _ => &[],
+    };
+    if !reserve(0, stops.len().saturating_add(16))
+        || !budget::require(
+            stops.iter().all(|s| s.offset.is_finite() && [s.color.r, s.color.g, s.color.b, s.color.a].iter().all(|v| v.is_finite())),
+            "HTML gradient has nonfinite stops",
+        )
+    {
+        return false;
+    }
+    match paint {
+        Paint::Solid(c) => budget::require([c.r, c.g, c.b, c.a].iter().all(|v| v.is_finite()), "HTML paint has nonfinite color"),
+        Paint::Linear { start, end, .. } => geometry::point(transform.apply(*start)) && geometry::point(transform.apply(*end)),
+        Paint::Radial { center, radius, .. } => {
+            geometry::point(transform.apply(*center)) && geometry::point(Vec2::new(*radius, radius * transform.mean_scale()))
+        }
+        Paint::Bitmap { matrix, .. } => transform.mul(matrix).m.as_chunks::<2>().0.iter().all(|&[x, y]| geometry::point(Vec2::new(x, y))),
+    }
+}
+
+pub(super) fn image(doc: &Document, bitmap: &anicraft_doc::Bitmap) -> bool {
+    if !budget::active() {
+        return true;
+    }
+    let pixels = u64::from(bitmap.width) * u64::from(bitmap.height);
+    let header_matches = bitmap.png.get(..16) == Some(&[137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82])
+        && bitmap.png.get(16..20) == Some(&bitmap.width.to_be_bytes())
+        && bitmap.png.get(20..24) == Some(&bitmap.height.to_be_bytes());
+    if !budget::require(pixels > 0 && pixels <= 32_000_000 && header_matches, "HTML bitmap header disagrees with bounded dimensions")
+        || !reserve(bitmap.png.len().saturating_mul(8).saturating_add((pixels as usize).saturating_mul(8)), bitmap.png.len())
+    {
+        return false;
+    }
+    match anicraft_doc::eval_budget::checked_bitmap(doc, bitmap.id) {
+        Ok(_) => true,
+        Err(_) => {
+            budget::fail("HTML embedded bitmap failed checked decoding");
+            false
+        }
+    }
+}
+
+pub(super) fn sound(source: &Sound) -> bool {
+    if !budget::active() {
+        return true;
+    }
+    let samples = source.frames.saturating_mul(u64::from(source.channels));
+    if !text(&source.name)
+        || !budget::require(source.data.len() <= 32 << 20 && samples > 0 && samples <= 16_000_000, "HTML sound exceeds its bytes or sample budget")
+        || !reserve(source.data.len().saturating_mul(8).saturating_add((samples as usize).saturating_mul(8)), source.data.len())
+    {
+        return false;
+    }
+    let result = (|| {
+        let pcm = anicraft_doc::audio::decode_complete(&source.data, samples as usize).ok()?;
+        let format = anicraft_doc::audio::Format::sniff(&source.data)?;
+        let matches = matches!(
+            (source.format, format),
+            (SoundFormat::Wav, anicraft_doc::audio::Format::Wav)
+                | (SoundFormat::Ogg, anicraft_doc::audio::Format::Vorbis)
+                | (SoundFormat::Mp3, anicraft_doc::audio::Format::Mp3)
+        );
+        Some(matches && pcm.rate == source.rate && pcm.channels == source.channels && pcm.frames() as u64 == source.frames)
+    })();
+    budget::require(result == Some(true), "HTML embedded sound differs from complete native decoding")
+}
+
+/// Native JSON spelling, optionally escaping '<' while streaming into the cap.
+pub(super) fn serialized(value: &Value, escape: bool) -> String {
+    if !budget::active() {
+        let text = value.to_string();
+        return if escape { text.replace('<', "\\u003c") } else { text };
+    }
+    struct Output {
+        bytes: crate::sequence::LimitedBytes,
+        escape: bool,
+    }
+    impl io::Write for Output {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            let count = bytes.len().saturating_add(if self.escape { bytes.iter().filter(|&&b| b == b'<').count().saturating_mul(5) } else { 0 });
+            if !reserve(count.saturating_mul(2), bytes.len().saturating_add(1)) {
+                return Err(io::Error::other("HTML serialization work exhausted"));
+            }
+            if self.escape {
+                let mut start = 0;
+                for (i, &byte) in bytes.iter().enumerate() {
+                    if byte == b'<' {
+                        self.bytes.write_all(&bytes[start..i])?;
+                        self.bytes.write_all(b"\\u003c")?;
+                        start = i + 1;
+                    }
+                }
+                self.bytes.write_all(&bytes[start..])?;
+            } else {
+                self.bytes.write_all(bytes)?;
+            }
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut out = Output { bytes: crate::sequence::LimitedBytes::new(MAX_CHECKED_HTML_BYTES), escape };
+    if serde_json::to_writer(&mut out, value).is_err() {
+        budget::fail("HTML JSON exceeds serialization bounds");
+        return String::new();
+    }
+    match String::from_utf8(out.bytes.into_bytes()) {
+        Ok(text) => text,
+        Err(_) => {
+            budget::fail("HTML JSON is not UTF-8");
+            String::new()
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Text(String);
+impl Text {
+    pub(super) fn with_capacity(hint: usize) -> Self {
+        if budget::active() { Self::default() } else { Self(String::with_capacity(hint)) }
+    }
+    pub(super) fn push_str(&mut self, text: &str) {
+        let _ = fmt::Write::write_str(self, text);
+    }
+    pub(super) fn push(&mut self, c: char) {
+        let _ = fmt::Write::write_char(self, c);
+    }
+    pub(super) fn len(&self) -> usize {
+        self.0.len()
+    }
+    pub(super) fn into_string(self) -> String {
+        self.0
+    }
+}
+impl fmt::Write for Text {
+    fn write_str(&mut self, text: &str) -> fmt::Result {
+        if budget::active() {
+            if !budget::require(text.len() <= MAX_CHECKED_HTML_BYTES.saturating_sub(self.0.len()), "HTML text exceeds 64 MiB")
+                || !reserve(text.len().saturating_mul(2), text.len().saturating_add(1))
+            {
+                return Err(fmt::Error);
+            }
+            let needed = self.0.len() + text.len();
+            let target = needed.max(self.0.capacity().saturating_mul(2)).min(MAX_CHECKED_HTML_BYTES);
+            if self.0.capacity() < needed && self.0.try_reserve_exact(target - self.0.len()).is_err() {
+                budget::fail("HTML text allocation failed");
+                return Err(fmt::Error);
+            }
+        }
+        self.0.push_str(text);
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn serialized_escape_expansion_is_bounded_before_output_growth() {
+        let scope = budget::Budget::document_export();
+        let value = Value::String("<".repeat(MAX_CHECKED_HTML_BYTES / 6 + 1));
+        assert!(scope.run_worker(|| serialized(&value, true)).unwrap_err().contains("serialization bounds"));
+    }
+
+    #[test]
+    fn text_fragments_reuse_capacity_and_errors_latch() {
+        let scope = budget::Budget::document_export();
+        scope
+            .run_worker(|| {
+                let mut out = Text::with_capacity(usize::MAX);
+                let mut growths = 0;
+                for _ in 0..4096 {
+                    let previous = out.0.capacity();
+                    out.push('x');
+                    growths += usize::from(previous != out.0.capacity());
+                }
+                assert!(growths < 16);
+                assert_eq!(out.into_string(), "x".repeat(4096));
+            })
+            .unwrap();
+        let huge = "x".repeat(MAX_CHECKED_HTML_BYTES);
+        let scope = budget::Budget::document_export();
+        assert!(
+            scope
+                .run_worker(|| {
+                    let mut out = Text::with_capacity(0);
+                    out.push_str("kept");
+                    out.push_str(&huge);
+                    assert_eq!(out.into_string(), "kept");
+                })
+                .unwrap_err()
+                .contains("64 MiB")
+        );
+    }
+
+    #[test]
+    fn checked_entry_isolates_worker_state_and_refuses_bad_metadata() {
+        let unrelated = budget::Budget::new(Default::default());
+        assert!(
+            unrelated
+                .run_worker(|| {
+                    budget::fail("unrelated caller failed");
+                    assert!(checked_html(&Document::default(), &HtmlOptions::default()).is_ok());
+                    assert!(budget::check().is_err());
+                })
+                .is_err()
+        );
+        assert!(budget::current().is_none());
+        assert!(checked_html(&Document::default(), &HtmlOptions { title: "x".repeat(4097), ..Default::default() }).is_err());
+        let mut doc = Document::default();
+        doc.stage.fps = f32::NAN;
+        assert!(checked_html(&doc, &HtmlOptions::default()).is_err());
+    }
+
+    #[test]
+    fn paints_refuse_invalid_stops_and_composed_coordinates() {
+        use anicraft_doc::{BitmapId, GradientStop, Paint, Rgba};
+        use anicraft_geom::{Affine, Vec2};
+        let paints = [
+            Paint::Bitmap { bitmap: BitmapId(1), repeat: true, matrix: Affine::scale(1e9, 1e9) },
+            Paint::Linear { start: Vec2::ZERO, end: Vec2::new(1e9, 1.0), stops: Vec::new() },
+            Paint::Radial { center: Vec2::ZERO, radius: f32::NAN, stops: Vec::new() },
+            Paint::Linear { start: Vec2::ZERO, end: Vec2::new(1.0, 1.0), stops: vec![GradientStop { offset: f32::NAN, color: Rgba::BLACK }] },
+        ];
+        for value in paints {
+            let scope = budget::Budget::document_export();
+            assert!(scope.run_worker(|| assert!(!paint(&value, &Affine::scale(2.0, 2.0)))).is_err());
+        }
+    }
+}
