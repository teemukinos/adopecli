@@ -0,0 +1,237 @@
+//! Checked admission for the native SVG formatter. These bounds do not prove
+//! browser raster equivalence or complete document/media integrity.
+use crate::{RenderError, budget};
+use anicraft_doc::{BlendMode, DisplayList, Document, Filter, Paint};
+use std::collections::BTreeMap;
+use std::fmt::{Display, Formatter, Write};
+
+pub const MAX_SVG_BYTES: usize = 64 << 20;
+
+pub struct CheckedSvg {
+    pub svg: String,
+    pub notes: BTreeMap<String, usize>,
+    pub work: serde_json::Value,
+}
+
+pub fn checked_svg(doc: &Document, frame: u32) -> Result<CheckedSvg, RenderError> {
+    let scope = budget::Budget::new(Default::default());
+    let (svg, notes, evaluation) = scope
+        .run_worker(|| {
+            let checked = anicraft_doc::eval_budget::checked_evaluate(doc, frame).map_err(RenderError::Budget)?;
+            let dl = &checked.display;
+            // Variable-width outlining may copy every item twice. Reserve those
+            // copies before the native formatter materializes them.
+            if !budget::reserve::<u8>(checked.work.copy_bytes_reserved.saturating_mul(2))
+                || !budget::reserve::<anicraft_doc::DisplayItem>(dl.items.len().saturating_mul(2))
+                || !budget::reserve::<u32>(dl.clip_parents.len())
+                || !budget::reserve::<anicraft_doc::Group>(dl.groups.len())
+            {
+                budget::check()?;
+            }
+            let notes = known_differences(dl);
+            let svg = super::to_svg(dl, &doc.stage);
+            budget::check()?;
+            Ok::<_, RenderError>((svg, notes, checked.work))
+        })
+        .map_err(RenderError::Budget)??;
+    Ok(CheckedSvg { svg, notes, work: serde_json::json!({"evaluation":evaluation,"serialization":scope.report()}) })
+}
+
+/// Known native-format differences. Counts describe evaluated groups/items;
+/// this is not an exhaustive visual equivalence certificate.
+fn known_differences(dl: &DisplayList) -> BTreeMap<String, usize> {
+    let mut notes = BTreeMap::new();
+    let mut add = |message: &str| {
+        *notes.entry(message.to_string()).or_insert(0) += 1;
+    };
+    for group in &dl.groups {
+        match group.blend {
+            BlendMode::Subtract | BlendMode::Invert | BlendMode::Alpha | BlendMode::Erase => add("blend mode exported as normal compositing"),
+            BlendMode::Layer => add("layer isolation relies on SVG group behavior"),
+            _ => {}
+        }
+        for filter in group.filters.iter() {
+            match filter {
+                Filter::DropShadow { inner: true, .. }
+                | Filter::DropShadow { knockout: true, .. }
+                | Filter::DropShadow { hide_object: true, .. }
+                | Filter::Glow { inner: true, .. }
+                | Filter::Glow { knockout: true, .. } => add("inner, knockout or hidden-source shadow/glow omitted"),
+                Filter::AdjustColor { .. } => {}
+                _ => add("native box-blur effects approximated with SVG Gaussian primitives"),
+            }
+        }
+    }
+    for item in &dl.items {
+        if matches!(item.fill, Some(Paint::Bitmap { repeat: false, .. })) {
+            add("non-repeating bitmap fill exported as a repeating SVG pattern");
+        }
+    }
+    notes
+}
+
+/// The same formatting writes as String, with checked bounds when a render
+/// scope is active. Ignored formatting errors latch the enclosing scope.
+#[derive(Default)]
+pub(super) struct Text(String);
+impl Text {
+    pub(super) fn new() -> Self {
+        Self::default()
+    }
+    pub(super) fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+    pub(super) fn push(&mut self, c: char) {
+        let _ = self.write_char(c);
+    }
+    pub(super) fn push_str(&mut self, text: &str) {
+        let _ = self.write_str(text);
+    }
+    pub(super) fn into_string(self) -> String {
+        self.0
+    }
+}
+impl Display for Text {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+impl Write for Text {
+    fn write_str(&mut self, text: &str) -> std::fmt::Result {
+        if budget::active() {
+            if !budget::require(text.len() <= MAX_SVG_BYTES.saturating_sub(self.0.len()), "SVG text exceeds 64 MiB")
+                || !budget::reserve::<u8>(text.len())
+                || !budget::charge(budget::Work::Helper, 1)
+            {
+                return Err(std::fmt::Error);
+            }
+            let needed = self.0.len() + text.len();
+            let target = needed.max(self.0.capacity().saturating_mul(2)).min(MAX_SVG_BYTES);
+            if self.0.capacity() < needed && self.0.try_reserve_exact(target - self.0.len()).is_err() {
+                budget::fail("SVG text allocation failed");
+                return Err(std::fmt::Error);
+            }
+        }
+        self.0.push_str(text);
+        Ok(())
+    }
+}
+
+pub(super) fn bitmap_png(px: &anicraft_doc::Pixels) -> Option<Vec<u8>> {
+    if !budget::active() {
+        return crate::encode_png(px.width, px.height, &px.rgba).ok();
+    }
+    if !budget::reserve::<u8>(px.rgba.len().saturating_mul(2)) {
+        return None;
+    }
+    let mut output = crate::sequence::LimitedBytes::new(MAX_SVG_BYTES);
+    let result = (|| {
+        let mut encoder = png::Encoder::new(&mut output, px.width, px.height);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        let mut writer = encoder.write_header()?;
+        writer.write_image_data(&px.rgba)?;
+        writer.finish()
+    })();
+    if result.is_err() {
+        budget::fail("SVG bitmap encoding failed or exceeded its byte limit");
+        return None;
+    }
+    Some(output.into_bytes())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn text_fragments_reuse_capacity_instead_of_reallocating_each_write() {
+        let scope = budget::Budget::new(Default::default());
+        scope
+            .run_worker(|| {
+                let mut text = Text::new();
+                let mut growths = 0;
+                for _ in 0..4096 {
+                    let capacity = text.0.capacity();
+                    text.push_str("x");
+                    growths += usize::from(text.0.capacity() != capacity);
+                }
+                assert!(growths < 16);
+                assert_eq!(text.into_string(), "x".repeat(4096));
+            })
+            .unwrap();
+    }
+
+    #[test]
+    fn mask_scan_work_is_bounded_before_serialization() {
+        let doc = anicraft_doc::sample::demo();
+        let mut display = anicraft_doc::evaluate(&doc, 0);
+        let item = display.items[0].clone();
+        display.items = vec![item; 1000];
+        display.clip_parents = vec![None; 32768];
+        let scope = budget::Budget::new(Default::default());
+        let error = scope.run_worker(|| super::super::to_svg(&display, &doc.stage)).unwrap_err();
+        assert!(error.contains("helper work"));
+    }
+
+    #[test]
+    fn invalid_numeric_and_bitmap_values_cannot_silently_disappear() {
+        let scope = budget::Budget::new(Default::default());
+        assert!(scope.run_worker(|| super::super::num(f32::MAX)).is_err());
+        let pixels = anicraft_doc::Pixels { width: 1, height: 1, rgba: vec![0] };
+        let scope = budget::Budget::new(Default::default());
+        assert!(scope.run_worker(|| bitmap_png(&pixels)).unwrap_err().contains("SVG bitmap encoding"));
+    }
+    #[test]
+    fn checked_svg_preserves_native_formatter_and_document() {
+        for doc in [anicraft_doc::sample::demo(), anicraft_doc::sample::interactive()] {
+            let original = serde_json::to_value(&doc).unwrap();
+            for frame in [0, doc.frame_count() / 2, doc.frame_count() - 1] {
+                let expected = super::super::to_svg(&anicraft_doc::evaluate(&doc, frame), &doc.stage);
+                let actual = checked_svg(&doc, frame).unwrap();
+                assert_eq!(actual.svg, expected);
+                assert!(actual.work["serialization"]["bytes_reserved"].as_u64().unwrap() > 0);
+            }
+            assert_eq!(serde_json::to_value(&doc).unwrap(), original);
+            assert!(checked_svg(&doc, doc.frame_count()).is_err());
+        }
+    }
+
+    #[test]
+    fn ignored_formatting_failure_still_rejects_scope() {
+        let scope = budget::Budget::new(Default::default());
+        let mut text = Text(String::from("kept"));
+        let oversized = "x".repeat(MAX_SVG_BYTES);
+        let result = scope.run_worker(|| {
+            let _ = write!(text, "{oversized}");
+        });
+        assert!(result.unwrap_err().contains("SVG text"));
+        assert_eq!(text.into_string(), "kept");
+    }
+
+    #[test]
+    fn known_filter_and_blend_losses_are_reported() {
+        let doc = anicraft_doc::sample::demo();
+        let mut display = anicraft_doc::evaluate(&doc, 0);
+        display.groups = vec![anicraft_doc::Group {
+            parent: None,
+            alpha: 1.0,
+            blend: BlendMode::Erase,
+            clip: None,
+            filters: vec![Filter::Glow {
+                blur_x: 5.0,
+                blur_y: 5.0,
+                strength: 1.0,
+                quality: 1,
+                color: anicraft_doc::Rgba::BLACK,
+                inner: true,
+                knockout: false,
+            }]
+            .into(),
+        }];
+        let notes = known_differences(&display);
+        assert_eq!(notes["blend mode exported as normal compositing"], 1);
+        assert_eq!(notes["inner, knockout or hidden-source shadow/glow omitted"], 1);
+        assert_eq!(known_differences(&display), notes);
+    }
+}
