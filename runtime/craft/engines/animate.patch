+                assert_eq!(trace.notdef_glyphs, 0);
+                assert_eq!(trace.draw_failures, 0);
+                assert_eq!(trace.unavailable_outlines, 0);
+                let exact = trace.weight == if bold { 700 } else { 400 } && trace.italic == italic;
+                assert_eq!(exact, !(bold && italic && !family.starts_with("Liberation")), "{family} {bold} {italic}: {trace:?}");
+                assert_eq!(trace.drawn.iter().map(|g| g.commands).sum::<usize>(), inspected.outline.cmds.len());
+            }
+        }
+    }
+
+    #[test]
+    fn clusters_retain_source_bytes_and_missing_glyphs_are_reported() {
+        let fonts = Fonts::get();
+        let layout = fonts.layout_diagnostic("Å\r\noffice 🦖", &Style::default()).unwrap();
+        let trace = layout.trace.unwrap();
+        assert_eq!(trace.runs[1].byte_start, 4);
+        assert!(trace.runs[1].glyphs.iter().all(|g| g.1 >= 4));
+        assert!(trace.notdef_glyphs > 0);
+        assert!(trace.missing_characters.iter().any(|(_, c)| *c == '🦖'));
+        assert!(fonts.layout_diagnostic(&"x".repeat(8193), &Style::default()).is_err());
+    }
+
+    #[test]
+    fn native_outline_expansion_is_refused_before_unbounded_collection() {
+        assert_eq!(Fonts::get().layout(&"@".repeat(8192), &Style::default()), Err(TextError::Budget));
+    }
+}
