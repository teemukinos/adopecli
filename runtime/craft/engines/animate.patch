+fn stored_limits_and_frame_range_are_refusals_not_repairs() {
+    let mut doc = Document::default();
+    root(&mut doc, vec![shape(2)]);
+    let before = serde_json::to_value(&doc).unwrap();
+    assert!(refusal(&doc, 1).contains("outside"));
+    assert_eq!(serde_json::to_value(&doc).unwrap(), before);
+    let layer = doc.timeline(0).layers[0].clone();
+    doc.timeline_mut(0).layers = vec![layer; 1025];
+    assert!(refusal(&doc, 0).contains("1024 stored layers"));
+}
