+            assert_eq!(result["peak"], 0.25);
+            assert_eq!(result["rms"], 0.25);
+            assert_eq!(session.doc, before);
+            assert_eq!(session.revision, revision);
+            assert!(session.execute("file.inspect_sound", &json!({"path":input,"max_samples":199})).is_err());
+            assert!(session.execute("file.inspect_sound", &json!({"path":input,"max_samples":0})).is_err());
+            assert!(session.execute("file.inspect_sound", &json!({"path":input,"program":"anything"})).is_err());
+            assert!(session.execute("file.inspect_sound", &json!({"path":root})).is_err());
+            assert!(session.execute("file.inspect_sound", &json!({"path":root.join("../outside.wav")})).is_err());
+            assert_eq!(std::fs::read(&input).unwrap(), data);
+            std::fs::remove_dir_all(root).unwrap();
