diff --git a/crates/engine/src/cmds_dobe_text.rs b/crates/engine/src/cmds_dobe_text.rs
new file mode 100644
index 0000000..48a8930
--- /dev/null
+++ b/crates/engine/src/cmds_dobe_text.rs
@@ -0,0 +1,208 @@
+//! Actual native font selection, shaping and outline evidence for automation.
+use crate::params::{opt_u32, opt_u64, str_req};
+use crate::{CommandSpec, EngineError, Result, Session};
+use anicraft_text::{Align, Fonts, Style};
+use serde_json::{Value, json};
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        CommandSpec {
+            id: "text.inspect_layout",
+            label: "Inspect Text Layout",
+            menu: "",
+            shortcut: None,
+            params: "{text, font?, size?, bold?, italic?, align?, letter_spacing?, line_spacing?, width?}; actual bundled face, glyph clusters, drawing and metrics; read-only",
+            mutates: false,
+            run: inspect,
+        },
+        CommandSpec {
+            id: "text.inspect_stored",
+            label: "Inspect Stored Text",
+            menu: "",
+            shortcut: None,
+            params: "{scene? (0-based) | symbol?, layer, frame?, element}; actual native text shaping and exact stored outline/box comparison; read-only",
+            mutates: false,
+            run: inspect_stored,
+        },
+    ]
+}
+
+fn inspect(_session: &mut Session, p: &Value) -> Result<Value> {
+    if p.as_object().is_none_or(|p| {
+        p.keys().any(|k| !matches!(k.as_str(), "text" | "font" | "size" | "bold" | "italic" | "align" | "letter_spacing" | "line_spacing" | "width"))
+    }) {
+        return Err(EngineError::Param("text inspection received an unknown field".into()));
+    }
+    let text = str_req(p, "text")?;
+    if text.len() > 32768 || text.chars().count() > 8192 || p.get("font").and_then(Value::as_str).is_some_and(|f| f.len() > 256) {
+        return Err(EngineError::Param("text inspection exceeds its text or font-name budget".into()));
+    }
+    let requested = crate::cmds_text::style_param(p, &crate::cmds_text::TextStyle::default())?;
+    let width = crate::cmds_text::width_param(p, None)?;
+    let style = Style {
+        family: requested.font.clone(),
+        size: requested.size,
+        bold: requested.bold,
+        italic: requested.italic,
+        align: match requested.align {
+            anicraft_doc::TextAlign::Left => Align::Left,
+            anicraft_doc::TextAlign::Center => Align::Center,
+            anicraft_doc::TextAlign::Right => Align::Right,
+        },
+        letter_spacing: requested.letter_spacing,
+        line_spacing: requested.line_spacing,
+        width,
+    };
+    diagnose(text, &style).map(|(report, _)| report)
+}
+
+fn diagnose(text: &str, style: &Style) -> Result<(Value, anicraft_text::Layout)> {
+    if text.len() > 32768 || style.family.len() > 256 {
+        return Err(EngineError::Param("text inspection exceeds its text or font-name budget".into()));
+    }
+
+    let layout = Fonts::get().layout_diagnostic(text, style).map_err(|e| EngineError::State(e.to_string()))?;
+    let trace = layout.trace.as_ref().ok_or_else(|| EngineError::State("native text trace is unavailable".into()))?;
+    let runs: Vec<Value> = trace
+        .runs
+        .iter()
+        .map(|r| {
+            json!({"byte_start":r.byte_start,"byte_length":r.byte_length,
+        "direction":r.direction,"script":r.script,"glyphs":r.glyphs.iter().map(|g| json!({"glyph":g.0,"cluster":g.1,
+        "x_offset":g.2,"y_offset":g.3,"advance":g.4})).collect::<Vec<_>>() })
+        })
+        .collect();
+    let drawn: Vec<Value> = trace
+        .drawn
+        .iter()
+        .map(|g| {
+            json!({"glyph":g.glyph,"cluster":g.cluster,"line":g.line,
+        "x":g.x,"y":g.y,"advance":g.advance,"outline_commands":g.commands})
+        })
+        .collect();
+    let bounds = layout.outline.bounds();
+    let ink = if layout.outline.cmds.is_empty() { Value::Null } else { json!([bounds.min.x, bounds.min.y, bounds.max.x, bounds.max.y]) };
+    let report = json!({"family":layout.family,"requested_family":style.family,
+        "family_match":style.family.trim().is_empty() || layout.family.eq_ignore_ascii_case(style.family.trim()),
+        "style_match":trace.weight == if style.bold {700} else {400} && trace.italic == style.italic,
+        "face":{"file":trace.embedded_file,"index":trace.face_index,"bytes":trace.face_bytes,
+            "postscript":trace.postscript,"weight":trace.weight,"italic":trace.italic},
+        "missing_characters":trace.missing_characters.iter().map(|(at,c)|json!({"byte":at,"character":c.to_string()})).collect::<Vec<_>>(),
+        "notdef_glyphs":trace.notdef_glyphs,"draw_failures":trace.draw_failures,"unavailable_outlines":trace.unavailable_outlines,
+        "width":layout.width,"height":layout.height,"ascent":layout.ascent,"line_height":layout.line_height,
+        "lines":layout.lines,"outline_commands":layout.outline.cmds.len(),"ink_bounds":ink,
+        "runs":runs,"drawn":drawn,"document_changed":false,
+        "layout_model":"one shaping run per paragraph; space wrapping; no bidirectional itemization"});
+    Ok((report, layout))
+}
+
+fn inspect_stored(s: &mut Session, p: &Value) -> Result<Value> {
+    if p.as_object().is_none_or(|p| p.keys().any(|k| !matches!(k.as_str(), "scene" | "symbol" | "layer" | "frame" | "element"))) {
+        return Err(EngineError::Param("stored text inspection received an unknown field".into()));
+    }
+    let symbol = opt_u64(p, "symbol")?;
+    if symbol.is_some() && p.get("scene").is_some() {
+        return Err(EngineError::Param("choose a scene or a symbol, not both".into()));
+    }
+    let timeline = if let Some(id) = symbol {
+        &s.doc.symbol(anicraft_doc::SymbolId(id)).ok_or_else(|| EngineError::Param("unknown text symbol".into()))?.timeline
+    } else {
+        &s.doc.scenes.get(opt_u32(p, "scene")?.unwrap_or(0) as usize).ok_or_else(|| EngineError::Param("unknown text scene".into()))?.timeline
+    };
+    let layer = opt_u64(p, "layer")?.ok_or_else(|| EngineError::Param("stored text inspection needs layer".into()))?;
+    let element = opt_u64(p, "element")?.ok_or_else(|| EngineError::Param("stored text inspection needs element".into()))?;
+    let frame = opt_u32(p, "frame")?.unwrap_or(0);
+    let key = timeline
+        .layer(anicraft_doc::LayerId(layer))
+        .and_then(|l| l.keyframe_at(frame))
+        .ok_or_else(|| EngineError::Param("unknown stored text keyframe".into()))?;
+    let el = key.elements.iter().find(|e| e.id.0 == element).ok_or_else(|| EngineError::Param("unknown stored text element".into()))?;
+    let anicraft_doc::ElementKind::Text(text) = &el.kind else {
+        return Err(EngineError::Param("stored element is not text".into()));
+    };
+    let style = Style {
+        family: text.font.clone(),
+        size: text.size,
+        bold: text.bold,
+        italic: text.italic,
+        align: match text.align {
+            anicraft_doc::TextAlign::Left => Align::Left,
+            anicraft_doc::TextAlign::Center => Align::Center,
+            anicraft_doc::TextAlign::Right => Align::Right,
+        },
+        letter_spacing: text.letter_spacing,
+        line_spacing: text.line_spacing,
+        width: text.width,
+    };
+    let (mut report, layout) = diagnose(&text.text, &style)?;
+    report["stored_outline_matches"] = json!(layout.outline == *text.outline);
+    report["stored_metrics_match"] = json!(layout.width == text.box_width && layout.height == text.box_height);
+    report["stored_style_unchanged"] = json!(anicraft_text::sanitize(&style) == style);
+    report["element"] = json!(element);
+    report["layer"] = json!(layer);
+    report["keyframe"] = json!(key.start);
+    Ok(report)
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+    #[test]
+    fn report_observes_real_face_substitution_without_mutation() {
+        let mut s = Session::default();
+        let before = s.doc.clone();
+        let revision = s.revision;
+        let report = s.execute("text.inspect_layout", &json!({"text":"office Åä","font":"Liberation Serif","bold":true,"italic":true})).unwrap();
+        assert_eq!(report["face"]["file"], "liberation-serif/LiberationSerif-BoldItalic.ttf");
+        assert_eq!(report["style_match"], true);
+        assert_eq!(report["notdef_glyphs"], 0);
+        let fallback = s.execute("text.inspect_layout", &json!({"text":"Hello","font":"Unavailable family"})).unwrap();
+        assert_eq!(fallback["family_match"], false);
+        let missing_style = s.execute("text.inspect_layout", &json!({"text":"Hello","font":"Inter","bold":true,"italic":true})).unwrap();
+        assert_eq!(missing_style["style_match"], false);
+        assert_eq!(s.doc, before);
+        assert_eq!(s.revision, revision);
+        assert!(s.execute("text.inspect_layout", &json!({"text":"x".repeat(8193)})).is_err());
+        assert!(s.execute("text.inspect_layout", &json!({"text":"hello","path":"outside"})).is_err());
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::indexing_slicing)]
+mod stored_tests {
+    use super::*;
+    use std::sync::Arc;
+    #[test]
+    fn stored_text_compares_actual_outline_and_metrics_without_repair() {
+        let mut s = Session::default();
+        let created = s.execute("text.create", &json!({"text":"Precise office","font":"Inter","size":30})).unwrap();
+        let params = json!({"layer":s.layer.0,"element":created["element"],"frame":0});
+        let report = s.execute("text.inspect_stored", &params).unwrap();
+        assert_eq!(report["stored_outline_matches"], true);
+        assert_eq!(report["stored_metrics_match"], true);
+        assert_eq!(report["stored_style_unchanged"], true);
+        let layer = Arc::make_mut(&mut s.doc.timeline_mut(0).layers[0]);
+        let key = Arc::make_mut(&mut layer.keyframes[0]);
+        let el = Arc::make_mut(&mut key.elements[0]);
+        if let anicraft_doc::ElementKind::Text(block) = &mut el.kind {
+            let block = Arc::make_mut(block);
+            block.outline = Arc::new(anicraft_geom::Path::new());
+            block.box_width += 1.0;
+        }
+        let before = s.doc.clone();
+        let revision = s.revision;
+        let report = s.execute("text.inspect_stored", &params).unwrap();
+        assert_eq!(report["stored_outline_matches"], false);
+        assert_eq!(report["stored_metrics_match"], false);
+        assert_eq!(s.doc, before);
+        assert_eq!(s.revision, revision);
+        let mut invalid = params.clone();
+        invalid["frame"] = json!("invalid");
+        assert!(s.execute("text.inspect_stored", &invalid).is_err());
+        invalid = params;
+        invalid["scene"] = json!(0);
+        invalid["symbol"] = json!(1);
+        assert!(s.execute("text.inspect_stored", &invalid).is_err());
+    }
+}
