@@ -0,0 +1,53 @@
+//! The Dobe build embeds explicit font inputs instead of consulting host fonts.
+use std::path::PathBuf;
+fn main() {
+    println!("cargo:rerun-if-env-changed=CRAFT_FONTS_DIR");
+    if std::env::var_os("CARGO_FEATURE_DOBE").is_none() {
+        return;
+    }
+    let run = || -> Result<(), Box<dyn std::error::Error>> {
+        let root = PathBuf::from(std::env::var("CRAFT_FONTS_DIR")?);
+        if !root.is_absolute() {
+            return Err("Dobe font root must be absolute".into());
+        }
+        let files = [
+            "liberation-mono/LiberationMono-Regular.ttf",
+            "liberation-mono/LiberationMono-Bold.ttf",
+            "liberation-mono/LiberationMono-Italic.ttf",
+            "liberation-mono/LiberationMono-BoldItalic.ttf",
+            "liberation-serif/LiberationSerif-Regular.ttf",
+            "liberation-serif/LiberationSerif-Bold.ttf",
+            "liberation-serif/LiberationSerif-Italic.ttf",
+            "liberation-serif/LiberationSerif-BoldItalic.ttf",
+            "inter/Inter-Regular.ttf",
+            "inter/Inter-Bold.ttf",
+            "inter/Inter-Italic.ttf",
+            "inter/Inter-SemiBold.ttf",
+            "source-sans-3/SourceSans3-Regular.ttf",
+            "source-sans-3/SourceSans3-Bold.ttf",
+            "source-sans-3/SourceSans3-It.ttf",
+            "source-sans-3/SourceSans3-Semibold.ttf",
+            "source-serif-4/SourceSerif4-Regular.ttf",
+            "source-serif-4/SourceSerif4-Bold.ttf",
+            "source-serif-4/SourceSerif4-It.ttf",
+            "source-serif-4/SourceSerif4-Semibold.ttf",
+        ];
+        let mut code = format!("pub const DOBE_FONT_FILES: &[&str] = &{:?};\n", files);
+        code.push_str("pub const DOBE_FONTS: &[&[u8]] = &[\n");
+        for file in files {
+            let path = root.join("fonts").join(file).canonicalize()?;
+            if !path.starts_with(root.canonicalize()?) || !path.is_file() {
+                return Err("invalid Dobe font input".into());
+            }
+            println!("cargo:rerun-if-changed={}", path.display());
+            code.push_str(&format!("include_bytes!({:?}),\n", path.to_string_lossy()));
+        }
+        code.push_str("];\n");
+        std::fs::write(PathBuf::from(std::env::var("OUT_DIR")?).join("dobe_fonts.rs"), code)?;
+        Ok(())
+    };
+    if let Err(error) = run() {
+        eprintln!("Dobe Animate font build failed: {error}");
+        std::process::exit(1);
+    }
+}
