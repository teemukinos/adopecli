+//! Read-only native decoder evidence for Dobe's closed admission pipeline.
+use crate::params::{opt_u32, str_req};
+use crate::{CommandSpec, EngineError, Result, Session};
+use anicraft_doc::audio::{self, Format};
+use anicraft_doc::audio::{Voice, VoiceKind};
+use serde_json::{Value, json};
+use std::path::Path;
+
+pub fn specs() -> Vec<CommandSpec> {
+    let mut specs = vec![
+        CommandSpec {
+            id: "file.inspect_preservation",
+            label: "Inspect Native State Preservation",
+            menu: "",
+            shortcut: None,
+            params: "{path}; runtime-admitted format 3 input; compares entire native state before sanitization and after cold save/load; no file writes or session change",
+            mutates: false,
+            run: inspect_preservation,
+        },
+        CommandSpec {
+            id: "file.inspect_sound",
+            label: "Inspect Stored Sound",
+            menu: "",
+            shortcut: None,
+            params: "{path, max_samples? (1..67108864, all channels)}; complete bounded WAV, Ogg Vorbis or MPEG audio decode; does not change the document",
+            mutates: false,
+            run: inspect_sound,
+        },
+        CommandSpec {
+            id: "file.inspect_soundtrack",
+            label: "Inspect Soundtrack",
+            menu: "",
+            shortcut: None,
+            params: "{from?, to? (inclusive movie frames), rate? (8000..192000)}; complete bounded native layout and mix work estimate; no output file or document change",
+            mutates: false,
+            run: inspect_soundtrack,
+        },
+    ];
+    specs.push(CommandSpec {
+        id: "file.inspect_frame",
+        label: "Inspect Frame Evaluation",
+        menu: "",
+        shortcut: None,
+        params: "{frame? (0-based movie frame)}; bounded native evaluation and decoded bitmap accounting; no rasterization or output file",
+        mutates: false,
+        run: inspect_frame,
+    });
+    specs.extend(crate::cmds_dobe_text::specs());
+    specs
+}
+
+fn inspect_preservation(_session: &mut Session, params: &Value) -> Result<Value> {
+    if params.as_object().is_none_or(|p| p.len() != 1 || !p.contains_key("path")) {
+        return Err(EngineError::Param("preservation inspection accepts only path".into()));
+    }
+    let path = crate::automation::path(Path::new(str_req(params, "path")?), false)?;
+    let metadata = std::fs::metadata(&path)?;
+    if !metadata.is_file() || metadata.len() > 64 << 20 {
+        return Err(EngineError::Param("preservation inspection needs a regular file no larger than 64 MiB".into()));
+    }
+    let text = crate::vfs::read_to_string(&path)?;
+    let canonical_bytes = crate::format::inspect_preservation(&text)?;
+    Ok(json!({"format":"anicraft","version":3,"input_bytes":text.len(),"canonical_bytes":canonical_bytes,
+        "load_sanitization_preserved":true,"save_load_preserved":true,
+        "raw_json_preservation_verified":false,"document_changed":false}))
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::indexing_slicing)]
+mod preservation_tests {
+    use super::*;
+
+    #[test]
+    fn headless_open_and_replace_preserve_empty_scenes_and_ids() {
+        let mut doc = anicraft_doc::Document::default();
+        doc.timeline_mut(0).layers.clear();
+        doc.scenes.push(std::sync::Arc::new(anicraft_doc::Scene::new("Second")));
+        let before = crate::format::to_json(&doc).unwrap();
+        let mut session = Session::new(doc.clone());
+        assert_eq!(crate::format::to_json(&session.doc).unwrap(), before);
+        assert!(session.active_layer().is_none());
+        let report = session.execute("file.inspect_frame", &json!({"frame":0})).unwrap();
+        assert_eq!(report["items"], 0);
+        session.replace_document(doc, None);
+        assert_eq!(crate::format::to_json(&session.doc).unwrap(), before);
+        assert!(session.active_layer().is_none());
+    }
+
+    #[test]
+    fn empty_headless_scene_requires_explicit_layer_and_undo_restores_it() {
+        let mut doc = anicraft_doc::Document::default();
+        doc.timeline_mut(0).layers.clear();
+        let before = crate::format::to_json(&doc).unwrap();
+        let mut session = Session::new(doc);
+        let rectangle = json!({"x":0,"y":0,"w":10,"h":10,"object":true});
+        assert!(session.execute("draw.rect", &rectangle).is_err());
+        assert_eq!(crate::format::to_json(&session.doc).unwrap(), before);
+        session.execute("layer.new", &json!({"name":"Explicit artwork"})).unwrap();
+        session.execute("draw.rect", &rectangle).unwrap();
+        assert_eq!(session.doc.timeline(0).layers.len(), 1);
+        session.execute("edit.undo", &json!({})).unwrap();
+        session.execute("edit.undo", &json!({})).unwrap();
+        assert_eq!(crate::format::to_json(&session.doc).unwrap(), before);
+    }
+
+    #[test]
+    fn command_is_closed_readonly_and_confined_to_owned_input() {
+        std::thread::spawn(|| {
+            let root = std::env::temp_dir().join(format!("dobe-preservation-{}", std::process::id()));
+            std::fs::create_dir(&root).unwrap();
+            let root = root.canonicalize().unwrap();
+            crate::automation::configure(&root, &root).unwrap();
+            let input = root.join("input.anicraft");
+            let text = crate::format::to_json(&anicraft_doc::sample::demo()).unwrap();
+            std::fs::write(&input, &text).unwrap();
+            let mut session = Session::default();
+            let before = crate::format::to_json(&session.doc).unwrap();
+            let revision = session.revision;
+            let report = session.execute("file.inspect_preservation", &json!({"path":input})).unwrap();
+            assert_eq!(report["input_bytes"], text.len());
+            assert_eq!(report["load_sanitization_preserved"], true);
+            assert_eq!(report["save_load_preserved"], true);
+            assert_eq!(report["raw_json_preservation_verified"], false);
+            assert_eq!(report["document_changed"], false);
+            for params in [json!({}), json!({"path":input,"output":"bad"}), json!({"path":root}), json!({"path":root.join("../outside")})] {
+                assert!(session.execute("file.inspect_preservation", &params).is_err());
+            }
+            assert_eq!(crate::format::to_json(&session.doc).unwrap(), before);
+            assert_eq!(session.revision, revision);
+            assert_eq!(std::fs::read_to_string(&input).unwrap(), text);
+            assert_eq!(std::fs::read_dir(&root).unwrap().count(), 1);
+            std::fs::remove_dir_all(root).unwrap();
+        })
+        .join()
+        .unwrap();
+    }
+}
+
+fn inspect_sound(_session: &mut Session, params: &Value) -> Result<Value> {
+    if params.as_object().is_none_or(|p| p.keys().any(|k| k != "path" && k != "max_samples")) {
+        return Err(EngineError::Param("sound inspection accepts only path and max_samples".into()));
+    }
+    let maximum = opt_u32(params, "max_samples")?.unwrap_or(audio::MAX_SAMPLES as u32) as usize;
+    if maximum == 0 || maximum > audio::MAX_SAMPLES {
+        return Err(EngineError::Param("sound inspection sample budget must be 1..67108864".into()));
+    }
+    let path = crate::automation::path(Path::new(str_req(params, "path")?), false)?;
+    let metadata = std::fs::metadata(&path)?;
+    if !metadata.is_file() || metadata.len() > 32 << 20 {
+        return Err(EngineError::Param("sound inspection needs a regular file no larger than 32 MiB".into()));
+    }
+    let bytes = crate::vfs::read(&path)?;
+    let format = Format::sniff(&bytes).ok_or_else(|| EngineError::Format("not WAV, Ogg Vorbis or MPEG audio".into()))?;
+    let pcm = audio::decode_complete(&bytes, maximum).map_err(|e| EngineError::Format(e.to_string()))?;
+    let mut peak = 0.0f64;
+    let mut energy = 0.0f64;
+    for &sample in &pcm.samples {
+        let value = f64::from(sample);
+        peak = peak.max(value.abs());
+        energy += value * value;
+    }
+    Ok(json!({"format":format.key(), "rate":pcm.rate, "channels":pcm.channels,
+        "frames":pcm.frames(), "samples":pcm.samples.len(), "encoded_bytes":bytes.len(),
+        "peak":peak, "rms":(energy / pcm.samples.len().max(1) as f64).sqrt(),
+        "decode":"complete-native", "channel_policy":"first_two", "document_changed":false}))
+}
+
+/// Counts are deterministic work units, not elapsed time or a price estimate.
+pub(crate) fn checked_soundtrack(s: &Session, first: u32, last: u32, rate: u32) -> Result<(Vec<Voice>, u64, u64, Value)> {
+    let (a, b) = crate::cmds_sound::movie_span(s, first, last, rate);
+    if b.saturating_sub(a) > 32 * 1024 * 1024 {
+        return Err(EngineError::Param("soundtrack exceeds 33554432 output frames".into()));
+    }
+    let (mut voices, work) = anicraft_doc::sound::checked_voices(&s.doc, rate).map_err(EngineError::Param)?;
+    voices.retain(|v| (v.kind == VoiceKind::Stream || v.at >= a) && v.at < b && v.end > a);
+    let mut sample_work = 0u64;
+    for voice in &voices {
+        if voice.gain == 0.0 {
+            continue;
+        }
+        // Two channels, four source taps when resampling, plus two envelope gains.
+        let weight = if voice.pcm.rate == rate { 2 } else { 8 } + if voice.envelope.is_some() { 2 } else { 0 };
+        sample_work = sample_work.saturating_add(voice.end.min(b).saturating_sub(voice.at.max(a)).saturating_mul(weight));
+    }
+    if sample_work > 256 * 1024 * 1024 {
+        return Err(EngineError::Param("soundtrack exceeds 268435456 weighted sample operations".into()));
+    }
+    let report = json!({"rate":rate,"from":first,"to":last,"output_frames":b.saturating_sub(a),
+        "voices":voices.len(),"sample_work":sample_work,"layout":work,
+        "block_voice_checks":b.saturating_sub(a).div_ceil(65536) * voices.len() as u64,
+        "layout_complete":true,"document_changed":false});
+    Ok((voices, a, b, report))
+}
+
+fn inspect_soundtrack(s: &mut Session, params: &Value) -> Result<Value> {
+    if params.as_object().is_none_or(|p| p.keys().any(|k| !matches!(k.as_str(), "from" | "to" | "rate"))) {
+        return Err(EngineError::Param("soundtrack inspection accepts only from, to and rate".into()));
+    }
+    let rate = opt_u32(params, "rate")?.unwrap_or(44100);
+    if !(8000..=192000).contains(&rate) {
+        return Err(EngineError::Param("param 'rate' must be between 8000 and 192000".into()));
+    }
+    let last = s.doc.frame_count().saturating_sub(1);
+    let first = opt_u32(params, "from")?.unwrap_or(0).min(last);
+    let to = opt_u32(params, "to")?.unwrap_or(last).min(last);
+    if to < first {
+        return Err(EngineError::Param("'to' must not be before 'from'".into()));
+    }
+    checked_soundtrack(s, first, to, rate).map(|(_, _, _, report)| report)
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bounded_read_only_sound_diagnostic() {
+        std::thread::spawn(|| {
+            let root = std::env::temp_dir().join(format!("dobe-animate-inspect-sound-{}", std::process::id()));
+            std::fs::create_dir_all(&root).unwrap();
+            let root = root.canonicalize().unwrap();
