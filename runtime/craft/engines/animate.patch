+++ b/crates/render/src/budget.rs
@@ -0,0 +1,194 @@
+//! Shared opt-in CPU rendering work limits. Counters are cumulative reservations,
+//! not peak-memory or elapsed-time measurements. A failed scope's intermediate
+//! buffers are invalid; publish only after `Budget::run` succeeds.
+use anicraft_geom::{Vec2, budget as geometry};
+use std::cell::RefCell;
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+#[derive(Clone, Copy)]
+pub(crate) enum Work {
+    Bytes,
+    Stroke,
+    Raster,
+    Helper,
+}
+
+struct State {
+    used: [AtomicUsize; 4],
+    limits: [usize; 4],
+    error: std::sync::Mutex<Option<&'static str>>,
+}
+
+#[derive(Clone)]
+pub struct Budget {
+    state: Arc<State>,
+    geometry: geometry::Budget,
+    parent: Option<Arc<Budget>>,
+}
+
+thread_local! { static CURRENT: RefCell<Option<Budget>> = const { RefCell::new(None) }; }
+struct Restore(Option<Budget>);
+impl Drop for Restore {
+    fn drop(&mut self) {
+        CURRENT.with(|s| s.replace(self.0.take()));
+    }
+}
+
+impl Budget {
+    pub fn new(geometry: geometry::Budget) -> Self {
+        Self::with_limits(geometry, [512 << 20, 4_000_000, 1_000_000_000, 20_000_000])
+    }
+    fn with_limits(geometry: geometry::Budget, limits: [usize; 4]) -> Self {
+        Self {
+            state: Arc::new(State { used: std::array::from_fn(|_| AtomicUsize::new(0)), limits, error: Default::default() }),
+            geometry,
+            parent: None,
+        }
+    }
+    pub(crate) fn export() -> Self {
+        Self::with_limits(
+            geometry::Budget::export(),
+            [8u64 << 30, 32_000_000, 8_000_000_000, 160_000_000].map(|n| usize::try_from(n).unwrap_or(usize::MAX)),
+        )
+    }
+    /// Retained document exports count bytes scanned during interning and text
+    /// serialization as helper work. They keep the smaller buffer reservation.
+    pub(crate) fn document_export() -> Self {
+        Self::with_limits(geometry::Budget::export(), [512 << 20, 32_000_000, 1_000_000_000, 256_000_000])
+    }
+    pub(crate) fn frame_child(&self) -> Self {
+        let mut child = Self::new(self.geometry.frame_child());
+        child.parent = Some(Arc::new(self.clone()));
+        child
+    }
+    pub fn run<T>(&self, compute: impl FnOnce() -> T) -> Result<T, String> {
+        let active = current().unwrap_or_else(|| self.clone());
+        let restore = Restore(CURRENT.with(|s| s.replace(Some(active.clone()))));
+        active.check()?;
+        let result = active.geometry.run(compute);
+        let check = active.check();
+        drop(restore);
+        check?;
+        result
+    }
+    pub fn check(&self) -> Result<(), String> {
+        if let Some(parent) = &self.parent {
+            parent.check()?;
+        }
+        let error = self.state.error.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(message) = *error {
+            return Err(message.into());
+        }
+        self.geometry.check()
+    }
+    pub fn report(&self) -> serde_json::Value {
+        let get = |work: Work| self.state.used.get(work as usize).map_or(0, |v| v.load(Ordering::Relaxed));
+        serde_json::json!({"bytes_reserved":get(Work::Bytes), "stroke_steps":get(Work::Stroke),
+            "raster_steps":get(Work::Raster), "helper_steps":get(Work::Helper), "geometry":self.geometry.report()})
+    }
+    pub(crate) fn run_worker<T>(&self, compute: impl FnOnce() -> T) -> Result<T, String> {
+        let restore = Restore(CURRENT.with(|s| s.replace(Some(self.clone()))));
+        let result = self.geometry.run_worker(|| self.run(compute));
+        drop(restore);
+        result?
+    }
+    fn fail(&self, message: &'static str) {
+        self.state.error.lock().unwrap_or_else(std::sync::PoisonError::into_inner).get_or_insert(message);
+    }
+    fn charge(&self, work: Work, count: usize) -> bool {
+        if self.check().is_err() {
+            return false;
+        }
+        if let Some(parent) = &self.parent
+            && !parent.charge(work, count)
+        {
+            return false;
+        }
+        let index = work as usize;
+        let (Some(used), Some(&limit)) = (self.state.used.get(index), self.state.limits.get(index)) else { return false };
+        let mut previous = used.load(Ordering::Relaxed);
+        loop {
+            match used.compare_exchange_weak(previous, previous.saturating_add(count), Ordering::Relaxed, Ordering::Relaxed) {
+                Ok(_) => break,
+                Err(actual) => previous = actual,
+            }
+        }
+        if count <= limit.saturating_sub(previous) && previous <= limit {
+            return true;
+        }
+        self.fail(match work {
+            Work::Bytes => "render exceeds its cumulative buffer reservation",
+            Work::Stroke => "render exceeds its stroke expansion budget",
+            Work::Raster => "render exceeds its raster work budget",
+            Work::Helper => "render exceeds its helper work budget",
+        });
+        false
+    }
+}
+
+pub fn current() -> Option<Budget> {
+    CURRENT.with(|s| s.borrow().clone())
+}
+pub(crate) fn active() -> bool {
+    CURRENT.with(|s| s.borrow().is_some())
+}
+pub(crate) fn healthy() -> bool {
+    geometry::healthy() && CURRENT.with(|s| s.borrow().as_ref().is_none_or(|b| b.check().is_ok()))
+}
+pub(crate) fn check() -> Result<(), crate::RenderError> {
+    let result = match current() {
+        Some(b) => b.check(),
+        None => geometry::current().map_or(Ok(()), |b| b.check()),
+    };
+    result.map_err(crate::RenderError::Budget)
+}
+pub(crate) fn fail(message: &'static str) -> bool {
+    CURRENT.with(|s| match s.borrow().as_ref() {
+        Some(b) => {
+            b.fail(message);
+            true
+        }
+        None => false,
+    })
+}
+pub(crate) fn require(valid: bool, message: &'static str) -> bool {
+    valid || !fail(message)
+}
+pub(crate) fn charge(work: Work, count: usize) -> bool {
+    geometry::healthy() && CURRENT.with(|s| s.borrow().as_ref().is_none_or(|b| b.charge(work, count)))
+}
+pub(crate) fn reserve<T>(count: usize) -> bool {
+    charge(Work::Bytes, count.saturating_mul(std::mem::size_of::<T>()))
+}
+pub(crate) fn points(points: &[Vec2]) -> bool {
+    !active() || (charge(Work::Stroke, points.len()) && points.iter().all(|p| geometry::point(*p)))
+}
+
+/// Capture both scopes on the dispatching thread; each worker enters them
+/// explicitly. This also preserves callers using only the geometry scope.
+pub(crate) struct Capture {
+    render: Option<Budget>,
+    geometry: Option<geometry::Budget>,
+}
+pub(crate) fn capture() -> Capture {
+    Capture { render: current(), geometry: geometry::current() }
+}
+impl Capture {
+    pub(crate) fn run<T: Default>(&self, compute: impl FnOnce() -> T) -> T {
+        let restore = Restore(CURRENT.with(|s| s.replace(self.render.clone())));
+        let result = match (&self.render, &self.geometry) {
+            (Some(b), _) => b.run_worker(compute).unwrap_or_default(),
+            (None, Some(b)) => b.run_worker(compute).unwrap_or_default(),
+            (None, None) => geometry::unscoped_worker(compute),
+        };
+        drop(restore);
+        result
+    }
+}
+
+#[cfg(test)]
+#[path = "budget_tests.rs"]
+mod tests;
