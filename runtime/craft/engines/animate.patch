@@ -0,0 +1,295 @@
+use super::*;
+use crate::{DisplayItem, DisplayList, View, checked_render, render};
+use anicraft_doc::{BlendMode, ColorTransform, ElementId, Filter, Group, LayerId, Paint, Rgba};
+use anicraft_geom::{Affine, FillRule, Path, Polyline};
+use rayon::prelude::*;
+
+fn limited(work: Work, limit: usize) -> Budget {
+    let mut limits = [usize::MAX; 4];
+    limits[work as usize] = limit;
+    Budget::with_limits(Default::default(), limits)
+}
+
+#[test]
+fn frame_children_share_export_limits_without_resetting_local_limits() {
+    let export = limited(Work::Bytes, 5);
+    let first = export.frame_child();
+    first.run_worker(|| assert!(charge(Work::Bytes, 3))).unwrap();
+    let second = export.frame_child();
+    assert!(second.run_worker(|| assert!(!charge(Work::Bytes, 3))).is_err());
+    assert!(first.check().is_err());
+    assert_eq!(export.report()["bytes_reserved"], 6);
+    assert_eq!(first.report()["bytes_reserved"], 3);
+    let export = Budget::export();
+    let child = export.frame_child();
+    assert!(child.run_worker(|| assert!(!charge(Work::Bytes, (512 << 20) + 1))).is_err());
+    assert!(export.check().is_ok());
+}
+fn item() -> DisplayItem {
+    DisplayItem {
+        path: Arc::new(Path::rect(8.0, 8.0, 32.0, 32.0)),
+        transform: Affine::IDENTITY,
+        fill: Some(Paint::Solid(Rgba::new(0.2, 0.5, 0.8, 1.0))),
+        stroke: None,
+        fill_rule: FillRule::NonZero,
+        color: ColorTransform::IDENTITY,
+        layer: LayerId(1),
+        element: ElementId(2),
+        outline: None,
+        clip: None,
+        masks: None,
+        guide: false,
+        group: None,
+        image: None,
+        smooth: true,
+    }
+}
+fn view() -> View {
+    View { transform: Affine::IDENTITY, width: 64, height: 64, background: Some(Rgba::WHITE) }
+}
+fn group(parent: Option<u32>, filters: Vec<Filter>) -> Group {
+    Group { parent, alpha: 0.7, blend: BlendMode::Multiply, filters: filters.into(), clip: None }
+}
+fn drawing() -> DisplayList {
+    DisplayList { items: vec![item()], ..Default::default() }
+}
