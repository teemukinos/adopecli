+//! Private headless engine. Public operations belong to the durable Dobe runtime.
+#![forbid(unsafe_code)]
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+#[path = "main.rs"]
+mod cli;
+fn main() -> std::process::ExitCode {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    if args.first().is_some_and(|arg| matches!(arg.to_str(), Some("mcp" | "zotero" | "serve")))
+        || args
+            .iter()
+            .any(|arg| arg.to_str().is_some_and(|arg| matches!(arg.split('=').next(), Some("--connect" | "--port" | "--token" | "--bridge"))))
+    {
+        eprintln!("dobe-write: private engine has no editor connection or network server; use the product MCP");
+        return std::process::ExitCode::from(2);
+    }
+    cli::main()
+}
