diff --git a/crates/engine/src/io/dobe_glyphs.rs b/crates/engine/src/io/dobe_glyphs.rs
new file mode 100644
index 0000000..4bc2b14
--- /dev/null
+++ b/crates/engine/src/io/dobe_glyphs.rs
@@ -0,0 +1,127 @@
+//! Private diagnostic of the actual page-display glyphs and their exact font bytes.
+//! The caller must admit documents before opening them. This is not a sandbox.
+use std::collections::{BTreeSet, HashMap};
+
+use serde_json::{Value, json};
+use wordcraft_layout::display::{Draw, page_display};
+
+use crate::Session;
+
+#[derive(Default)]
+struct Trace {
+    faces: Vec<Value>,
+    face_ids: HashMap<u32, usize>,
+    bytes: Vec<u8>,
+    runs: Vec<Value>,
+    draws: usize,
+    glyphs: usize,
+    text_bytes: usize,
+}
+
+impl Trace {
+    fn visit(&mut self, items: &[Draw], page: usize, path: &mut Vec<usize>, frames: &mut Vec<Value>) -> Result<(), String> {
+        if path.len() > 16 {
+            return Err("glyph trace nesting exceeds budget".into());
+        }
+        for (index, item) in items.iter().enumerate() {
+            self.draws += 1;
+            if self.draws > 200_000 {
+                return Err("glyph trace draws exceed budget".into());
+            }
+            path.push(index);
+            match item {
+                Draw::Glyphs { face, size, glyphs, synth_bold, synth_italic, text, ranges, x_scale, .. } => {
+                    self.glyphs += glyphs.len();
+                    self.text_bytes += text.len();
+                    if self.glyphs > 200_000 || self.text_bytes > 4 << 20 || self.runs.len() >= 50_000 {
+                        return Err("glyph trace content exceeds budget".into());
+                    }
+                    if (!ranges.is_empty() && ranges.len() != glyphs.len())
+                        || ranges.iter().any(|r| r.start > r.end || !text.is_char_boundary(r.start) || !text.is_char_boundary(r.end))
+                    {
+                        return Err("glyph trace has invalid text ranges".into());
+                    }
+                    if !size.is_finite() || !x_scale.is_finite() || glyphs.iter().any(|(id, x, y)| *id == 0 || !x.is_finite() || !y.is_finite()) {
+                        return Err("glyph trace has missing glyphs or nonfinite geometry".into());
+                    }
+                    let font = if let Some(&id) = self.face_ids.get(&face.id()) {
+                        id
+                    } else {
+                        let data = face.data();
+                        if self.faces.len() >= 64 || data.is_empty() || data.len() > 32 << 20 || self.bytes.len() + data.len() > 64 << 20 {
+                            return Err("glyph trace font bytes exceed budget".into());
+                        }
+                        let id = self.faces.len();
+                        self.faces.push(json!({"family": face.family, "style": face.style, "index": face.index(),
+                            "weight": face.weight, "italic": face.italic, "unitsPerEm": face.upem,
+                            "coordinates": face.coords, "offset": self.bytes.len(), "bytes": data.len()}));
+                        self.bytes.extend_from_slice(data);
+                        self.face_ids.insert(face.id(), id);
+                        id
+                    };
+                    self.runs.push(json!({"page": page, "path": path, "frames": frames, "font": font,
+                        "size": size, "xScale": x_scale, "syntheticBold": synth_bold, "syntheticItalic": synth_italic,
+                        "text": text, "rangesKnown": ranges.len() == glyphs.len(),
+                        "ranges": ranges.iter().map(|r| [r.start, r.end]).collect::<Vec<_>>(), "glyphs": glyphs}));
+                }
+                Draw::Figure { draws, .. } => self.visit(draws, page, path, frames)?,
+                Draw::Turned { x, y, turn, items } => {
+                    frames.push(json!({"kind": "transform", "matrix": Draw::turn_matrix(*turn, *x, *y)}));
+                    self.visit(items, page, path, frames)?;
+                    frames.pop();
+                }
+                Draw::Rotated { cx, cy, spin, items } => {
+                    frames.push(json!({"kind": "transform", "matrix": spin.matrix(*cx, *cy)}));
+                    self.visit(items, page, path, frames)?;
+                    frames.pop();
+                }
+                Draw::Clip { rect, items } => {
+                    frames.push(json!({"kind": "clip", "rect": [rect.x, rect.y, rect.w, rect.h]}));
+                    self.visit(items, page, path, frames)?;
+                    frames.pop();
+                }
+                Draw::Art { .. } | Draw::Mark { .. } | Draw::MarkText { .. } => {
+                    return Err("glyph trace cannot identify outline-only or UI text".into());
+                }
+                Draw::Fill { .. } | Draw::Line { .. } | Draw::Image { .. } | Draw::Shape { .. } | Draw::Ink { .. } | Draw::Path { .. } => {}
+            }
+            path.pop();
+        }
+        Ok(())
+    }
+}
+
+pub fn inspect(s: &mut Session) -> Result<(Vec<u8>, Vec<u8>), String> {
+    if s.doc.settings.watermark.is_some() {
+        return Err("glyph trace watermark identity is not qualified".into());
+    }
+    // Match file.exportPng, including print view, output fields and markup choice.
+    // The interactive session layout can omit or dim a different set of content.
+    let layout = s.export_layout_with(false);
+    if layout.pages.is_empty() || layout.pages.len() > 256 {
+        return Err("glyph trace page count exceeds budget".into());
+    }
+    let display = crate::strict::png_display();
+    let report = crate::strict::strict_report(&s.doc, &layout, &display, None, wordcraft_layout::StrictOutput::Png);
+    if !report.passed() {
+        return Err(report.refusal());
+    }
+    let mut trace = Trace::default();
+    for (index, page) in layout.pages.iter().enumerate() {
+        trace.visit(&page_display(&s.doc, page, &display), index, &mut Vec::new(), &mut Vec::new())?;
+    }
+    let substitutions: BTreeSet<(String, String)> =
+        layout.substituted_fonts().into_iter().map(|(requested, face)| (requested, face.get().family.clone())).collect();
+    if substitutions.len() > 256 {
+        return Err("glyph trace font substitutions exceed budget".into());
+    }
+    let substitutions: Vec<Value> = substitutions.into_iter().map(|(requested, actual)| json!({"requested": requested, "actual": actual})).collect();
+    let header = serde_json::to_vec(&json!({"schemaVersion": 2, "display": "png", "faces": trace.faces, "substitutions": substitutions,
+        "runs": trace.runs, "glyphCount": trace.glyphs, "drawCount": trace.draws, "fontBytes": trace.bytes.len(),
+        "pages": layout.pages.iter().map(|p| [p.w, p.h]).collect::<Vec<_>>()}))
+    .map_err(|e| e.to_string())?;
+    if header.len() > 16 << 20 {
+        return Err("glyph trace header exceeds budget".into());
+    }
+    Ok((header, trace.bytes))
+}
