 use wordcraft_doc::Document;
 
+#[cfg(feature = "dobe")]
+pub mod dobe_glyphs;
+
+/// Decode one managed raster with the same decoder used by document rendering.
+/// The caller compares the returned pixels with an independent decoder before
+/// admitting a resource. This does not open a document or load embedded fonts.
+#[cfg(feature = "dobe")]
+pub fn dobe_picture(bytes: &[u8]) -> Result<(serde_json::Value, Vec<u8>), String> {
+    if bytes.is_empty() || bytes.len() > 32 << 20 {
+        return Err("picture bytes exceed the managed budget".into());
+    }
+    let probe = wordcraft_geom::picture::probe(bytes).map_err(|e| e.to_string())?;
+    let pixels = u64::from(probe.width) * u64::from(probe.height);
+    if probe.width > 8192 || probe.height > 8192 || pixels == 0 || pixels > 16_777_216 {
+        return Err("picture dimensions exceed the managed budget".into());
+    }
+    let decoded = probe.decode(128 << 20).map_err(|e| e.to_string())?;
+    let sample_type = format!("{:?}", decoded.color());
+    let rgba = decoded.to_rgba8().into_raw();
+    let info = serde_json::json!({
+        "schemaVersion": 1, "format": format!("{:?}", probe.format),
+        "width": probe.width, "height": probe.height, "sourceBytes": bytes.len(),
+        "nativePeakBytes": probe.peak_bytes(), "sampleType": sample_type,
+        "pixelFormat": "RGBA8", "pixelBytes": rgba.len()
+    });
+    Ok((info, rgba))
+}
+
 #[cfg(not(target_arch = "wasm32"))]
 mod safe_save;
 
