index 0000000..9083c39
--- /dev/null
+++ b/apps/cadcraft-cli/src/dobe_solve.rs
@@ -0,0 +1,101 @@
+//! Fixed private solver entrypoint. Expressions and geometry stay in the native
+//! CAD engine; no command interpreter, scripts or filesystem resolver is called.
+use cadcraft_engine::{dobe_constraints as cs, doc::Drawing};
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+
+use super::Result;
+
+const MAX_CONSTRAINTS: usize = 256;
+const MAX_PARAMETERS: usize = 256;
+const RESIDUAL_LIMIT: f64 = 1e-6;
+
+pub(super) fn preflight(d: &Drawing) -> Result<()> {
+    if d.constraints.is_empty() || d.constraints.len() > MAX_CONSTRAINTS || d.parametric.parameters.len() > MAX_PARAMETERS {
+        return Err("private solve requires 1..256 constraints and at most 256 user parameters".into());
+    }
+    let mut ids = BTreeSet::new();
+    let mut names = BTreeSet::new();
+    for p in &d.parametric.parameters {
+        if !cs::expr::valid_name(&p.name) || !names.insert(p.name.clone()) || p.expr.len() > cs::expr::MAX_LEN {
+            return Err("invalid, duplicate or oversized user parameter".into());
+        }
+    }
+    for c in &d.constraints {
+        if !ids.insert(c.id) || c.refs.is_empty() || c.refs.len() > 3 {
+            return Err("invalid or duplicate constraint identity/references".into());
+        }
+        if c.kind.is_dimensional() {
+            if !cs::expr::valid_name(&c.name) || !names.insert(c.name.clone()) || c.expr.len() > cs::expr::MAX_LEN {
+                return Err("invalid, duplicate or oversized dimensional parameter".into());
+            }
+        } else if !c.name.is_empty() || !c.expr.is_empty() {
+            return Err("geometric constraint carries unused parameter data".into());
+        }
+        cs::validate(d, c).map_err(std::io::Error::other)?;
+    }
+    // Validate every expression, including user parameters not referenced by a
+    // constraint. The native environment must not silently replace duplicates.
+    checked_parameters(d)?;
+    Ok(())
+}
+
+fn checked_parameters(d: &Drawing) -> Result<Value> {
+    let rows = cs::parameter_table(d);
+    if rows.iter().any(|row| row.error.is_some() || row.value.is_none_or(|v| !v.is_finite())) {
+        return Err("parameter expression failed or produced a non-finite value".into());
+    }
+    Ok(serde_json::to_value(rows)?)
+}
+
+pub fn run(input: &str, output: &str) -> Result<()> {
+    let before = super::model(input)?;
+    preflight(&before)?;
+    let mut drawing = before.clone();
+    let solved = cs::solve(&mut drawing, &cs::SolveOptions::default())?;
+    if !solved.skipped.is_empty() {
+        return Err("native solver skipped requested constraints".into());
+    }
+    let mut fixed = drawing.clone();
+    if cs::restore_fixed(&mut fixed, &before) {
+        return Err("native solve moved fixed geometry".into());
+    }
+    let residuals = cs::residuals(&drawing);
+    if residuals.len() != drawing.constraints.len()
+        || residuals.iter().any(|(_, value)| value.is_none_or(|v| !v.is_finite() || v.abs() > RESIDUAL_LIMIT))
+    {
+        return Err("native constraint residual exceeds private solve tolerance".into());
+    }
+    let mut env = cs::env(&drawing);
+    let mut dimensions = Vec::new();
+    for c in &drawing.constraints {
+        if c.kind.is_dimensional() {
+            let target = cs::constraint_value(&mut env, c)?;
+            let measured = cs::measure(&drawing, c.kind, &c.refs).map_err(std::io::Error::other)?;
+            if !target.is_finite() || !measured.is_finite() || (measured - target).abs() > RESIDUAL_LIMIT {
+                return Err("native dimension differs from its requested value".into());
+            }
+            dimensions.push(json!({"id":c.id,"name":c.name,"target":target,"measured":measured}));
+        }
+    }
+    super::validate(&drawing)?;
+    let document = serde_json::to_value(&drawing)?;
+    let cold: Drawing = serde_json::from_value(document.clone())?;
+    if cold != drawing || serde_json::to_value(&cold)? != document {
+        return Err("solved native drawing changed during serialization".into());
+    }
+    let report = json!({
+        "schema_version":1,
+        "document":document,
+        "parameters":checked_parameters(&drawing)?,
+        "dimensions":dimensions,
+        "residuals":residuals,
+        "residual_limit":RESIDUAL_LIMIT,
+        "moved":solved.moved,
+        "skipped":solved.skipped,
+        "fixed_geometry_unchanged":true,
+        "complete_native_cold_equal":true,
+        "general_manufacturing_qualified":false
+    });
+    super::write(output, &serde_json::to_vec(&report)?)
+}
