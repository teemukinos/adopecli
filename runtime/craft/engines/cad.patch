+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let entities = <Vec<Entity> as serde::Deserialize>::deserialize(deserializer)?;
+        if entities.len() > 100_000 {
+            return Err(serde::de::Error::custom("entity store exceeds private transport limit"));
+        }
+        let mut store = Self::new();
+        for entity in entities {
+            if store.contains(entity.handle) {
+                return Err(serde::de::Error::custom("duplicate entity handle"));
+            }
+            store.push(entity);
+        }
+        Ok(store)
+    }
+}
