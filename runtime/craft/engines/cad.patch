diff --git a/apps/cadcraft-cli/src/dobe_main.rs b/apps/cadcraft-cli/src/dobe_main.rs
new file mode 100644
index 0000000..5fceee9
--- /dev/null
+++ b/apps/cadcraft-cli/src/dobe_main.rs
@@ -0,0 +1,106 @@
+//! Private, file-oriented CAD transport. No editor, MCP server, startup scripts,
+//! path-resolving OPEN command or ambient font discovery is dispatched here.
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+#![forbid(unsafe_code)]
+use cadcraft_engine::doc::{Drawing, Space};
+use std::io::{Read, Write};
+use std::path::Path;
+
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const MAX_BYTES: usize = 128 * 1024 * 1024;
+
+mod dobe_solid;
+mod dobe_solve;
+
+fn read(path: &str) -> Result<Vec<u8>> {
+    let file = std::fs::File::open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err("private input must be a regular file".into());
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_BYTES as u64 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_BYTES {
+        return Err("private input exceeds 128 MiB".into());
+    }
+    Ok(bytes)
+}
+fn write(path: &str, bytes: &[u8]) -> Result<()> {
+    if bytes.len() > MAX_BYTES {
+        return Err("private output exceeds 128 MiB".into());
+    }
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    Ok(())
+}
+fn validate(d: &Drawing) -> Result<()> {
+    let count = std::iter::once(&d.model)
+        .chain(d.layouts.iter().map(|l| &l.entities))
+        .chain(d.blocks.values().map(|b| &b.entities))
+        .try_fold(0usize, |n, store| n.checked_add(store.len()));
+    if count.is_none_or(|n| n > 100_000) {
+        return Err("drawing exceeds private entity budget".into());
+    }
+    d.rasters.dobe_validate().map_err(std::io::Error::other)?;
+    Ok(())
+}
+fn model(path: &str) -> Result<Drawing> {
+    let raw: serde_json::Value = serde_json::from_slice(&read(path)?)?;
+    let d: Drawing = serde_json::from_value(raw.clone())?;
+    validate(&d)?;
+    // Unknown fields, omitted state and implicit defaults must never disappear
+    // silently. The private protocol takes the complete model emitted by snapshot.
+    if serde_json::to_value(&d)? != raw {
+        return Err("JSON is not the complete native drawing model".into());
+    }
+    Ok(d)
+}
+fn snapshot(d: &Drawing, path: &str) -> Result<()> {
+    validate(d)?;
+    let bytes = serde_json::to_vec(d)?;
+    let cold: Drawing = serde_json::from_slice(&bytes)?;
+    if &cold != d || serde_json::to_vec(&cold)? != bytes {
+        return Err("native model serialization changed drawing state".into());
+    }
+    write(path, &bytes)
+}
+fn run() -> Result<()> {
+    let args: Vec<String> =
+        std::env::args_os().skip(1).map(|a| a.into_string().map_err(|_| "arguments must be Unicode")).collect::<std::result::Result<_, _>>()?;
+    match args.iter().map(String::as_str).collect::<Vec<_>>().as_slice() {
+        ["--version"] => { println!("dobe-cad {}", env!("CARGO_PKG_VERSION")); Ok(()) }
+        ["new", "metric", output] => snapshot(&Drawing::new_metric(), output),
+        ["new", "imperial", output] => snapshot(&Drawing::new_imperial(), output),
+        ["snapshot", "dxf", input, output] => {
+            let bytes = read(input)?;
+            // Do not let content sniffing dispatch the DWG subprocess bridge.
+            if bytes.starts_with(b"AC10") { return Err("DWG input is not a DXF source".into()); }
+            let d = cadcraft_io::read_dxf(&bytes)?;
+            snapshot(&d, output)
+        }
+        ["encode", input, output] => snapshot(&model(input)?, output),
+        ["solve", input, output] => dobe_solve::run(input, output),
+        ["panel-solid", input, request, output] => dobe_solid::run(input, request, output),
+        ["panel-obj", input, handle, output] => dobe_solid::export(input, handle, output),
+        ["convert", format, input, output] if matches!(*format, "dxf" | "svg" | "pdf") => {
+            let d = model(input)?;
+            let bytes = cadcraft_io::write(&d, Path::new(&format!("output.{format}")))?;
+            write(output, &bytes)
+        }
+        ["render", input, output, width, height] => {
+            let (w, h) = (width.parse::<u32>()?, height.parse::<u32>()?);
+            if w == 0 || h == 0 || w > 8192 || h > 8192 || u64::from(w)*u64::from(h) > 16_777_216 {
+                return Err("raster dimensions exceed private pixel budget".into());
+            }
+            let d = model(input)?;
+            write(output, &cadcraft_io::png(&d, &Space::Model, w, h)?)
+        }
+        _ => Err("usage: dobe-cad --version | new metric|imperial OUTPUT | snapshot dxf INPUT OUTPUT | encode INPUT OUTPUT | solve INPUT OUTPUT | panel-solid INPUT REQUEST OUTPUT | panel-obj INPUT HANDLE OUTPUT | convert dxf|svg|pdf INPUT OUTPUT | render INPUT OUTPUT WIDTH HEIGHT".into()),
+    }
+}
+fn main() {
+    if let Err(error) = run() {
+        eprintln!("dobe-cad: {error}");
+        std::process::exit(2);
+    }
+}
diff --git a/apps/cadcraft-cli/src/dobe_solid.rs b/apps/cadcraft-cli/src/dobe_solid.rs
new file mode 100644
index 0000000..76b76b8
--- /dev/null
+++ b/apps/cadcraft-cli/src/dobe_solid.rs
@@ -0,0 +1,180 @@
+//! Bounded native panel extrusion and geometry-only OBJ delivery.
+//! This produces a closed polyface solid, not an ACIS/B-rep or manufacturing claim.
+use cadcraft_engine::{
+    dobe_constraints as cs,
+    doc::{Drawing, Entity, EntityKind, HVal, Handle, Parameter, PolyfaceMesh, geom::Vec3},
+};
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+use std::fmt::Write as _;
+
+use super::Result;
+
+const FACES: [[i32; 4]; 6] = [[1, 4, 3, 2], [5, 6, 7, 8], [1, 2, 6, 5], [2, 3, 7, 6], [3, 4, 8, 7], [4, 1, 5, 8]];
+const TOLERANCE: f64 = 1e-6;
+
+fn dimension(value: f64) -> Result<f64> {
+    if !value.is_finite() || !(0.1..=10_000.0).contains(&value) {
+        return Err("panel dimensions require 0.1..10000 finite millimetres".into());
+    }
+    Ok(value)
+}
+fn vertices(w: f64, h: f64, d: f64) -> Vec<Vec3> {
+    [(0., 0., 0.), (w, 0., 0.), (w, h, 0.), (0., h, 0.), (0., 0., d), (w, 0., d), (w, h, d), (0., h, d)]
+        .into_iter()
+        .map(|(x, y, z)| Vec3::new(x, y, z))
+        .collect()
+}
+fn near(a: Vec3, b: Vec3) -> bool {
+    [a.x - b.x, a.y - b.y, a.z - b.z].into_iter().all(|v| v.is_finite() && v.abs() <= TOLERANCE)
+}
+fn handles(d: &Drawing) -> Result<BTreeSet<Handle>> {
+    let mut handles = BTreeSet::new();
+    for store in std::iter::once(&d.model).chain(d.layouts.iter().map(|l| &l.entities)).chain(d.blocks.values().map(|b| &b.entities)) {
+        for entity in store.iter() {
+            if entity.handle.0 == 0 || entity.handle.0 >= d.handseed || !handles.insert(entity.handle) {
+                return Err("panel source has duplicate handles or an invalid next handle".into());
+            }
+        }
+    }
+    Ok(handles)
+}
+
+pub fn run(input: &str, request_path: &str, output: &str) -> Result<()> {
+    let before = super::model(input)?;
+    let request_bytes = super::read(request_path)?;
+    if request_bytes.len() > 4096 {
+        return Err("panel request exceeds byte budget".into());
+    }
+    let request: Value = serde_json::from_slice(&request_bytes)?;
+    let object = request.as_object().ok_or("panel request must be an object")?;
+    let expected: BTreeSet<&str> = ["width", "height", "depth", "sketch_handles", "mesh_handle"].into_iter().collect();
+    if object.keys().map(String::as_str).collect::<BTreeSet<_>>() != expected {
+        return Err("panel request fields differ".into());
+    }
+    let number = |name: &str| -> Result<f64> { dimension(request.get(name).and_then(Value::as_f64).ok_or("panel dimension must be numeric")?) };
+    let (w, h, depth) = (number("width")?, number("height")?, number("depth")?);
+    let selected = request.get("sketch_handles").and_then(Value::as_array).ok_or("panel needs four sketch handles")?;
+    if selected.len() != 4 {
+        return Err("panel needs four sketch handles".into());
+    }
+    let selected: Vec<Handle> =
+        selected.iter().map(|v| v.as_u64().filter(|h| *h > 0).map(Handle).ok_or("invalid sketch handle")).collect::<std::result::Result<_, _>>()?;
+    if selected.iter().copied().collect::<BTreeSet<_>>().len() != 4 {
+        return Err("panel sketch handles must be distinct".into());
+    }
+    let old_mesh = match request.get("mesh_handle") {
+        Some(Value::Null) => None,
+        Some(value) => Some(Handle(value.as_u64().filter(|h| *h > 0).ok_or("invalid mesh handle")?)),
+        None => return Err("mesh selector is missing".into()),
+    };
+    if !matches!(before.header.get("INSUNITS"), Some(HVal::Int(4))) {
+        return Err("panel source must use millimetres".into());
+    }
+    handles(&before)?;
+    super::dobe_solve::preflight(&before)?;
+    let rows = cs::parameter_table(&before);
+    for (name, target) in [("width", w), ("height", h)] {
+        let matching: Vec<_> = rows.iter().filter(|r| r.kind == "user" && r.name == name).collect();
+        if matching.len() != 1 || matching.first().and_then(|r| r.value).is_none_or(|v| (v - target).abs() > TOLERANCE) {
+            return Err("panel dimensions differ from source parameters".into());
+        }
+    }
+    if cs::residuals(&before).iter().any(|(_, value)| value.is_none_or(|v| !v.is_finite() || v.abs() > TOLERANCE)) {
+        return Err("panel sketch must be solved before extrusion".into());
+    }
+    let corners = vertices(w, h, 0.0);
+    for (index, handle) in selected.iter().enumerate() {
+        let entity = before.model.get(*handle).ok_or("sketch handle must name a model-space line")?;
+        let EntityKind::Line(line) = &entity.kind else {
+            return Err("panel sketch must contain lines".into());
+        };
+        let a = *corners.get(index).ok_or("missing panel corner")?;
+        let b = *corners.get((index + 1) % 4).ok_or("missing panel corner")?;
+        if !near(line.a, a) || !near(line.b, b) {
+            return Err("panel sketch geometry differs from requested closed rectangle".into());
+        }
+    }
+    let mut drawing = before.clone();
+    let depth_parameters: Vec<_> = drawing.parametric.parameters.iter().enumerate().filter(|(_, p)| p.name == "depth").map(|(i, _)| i).collect();
+    let (handle, common) = if let Some(handle) = old_mesh {
+        if selected.contains(&handle) || depth_parameters.len() != 1 {
+            return Err("panel revision needs one depth parameter and a separate mesh".into());
+        }
+        let entity = drawing.model.get(handle).ok_or("panel mesh handle is absent")?;
+        let EntityKind::PolyfaceMesh(mesh) = &entity.kind else {
+            return Err("panel revision target is not a polyface mesh".into());
+        };
+        panel_dimensions(mesh)?;
+        (handle, entity.common.clone())
+    } else {
+        if cs::name_in_use(&drawing, "depth") {
+            return Err("panel creation cannot overwrite an existing depth parameter".into());
+        }
+        let handle = Handle(drawing.handseed);
+        if handle.0 == 0 {
+            return Err("panel next handle is invalid".into());
+        }
+        drawing.handseed = drawing.handseed.checked_add(1).ok_or("panel handle range exhausted")?;
+        let first = selected.first().and_then(|h| drawing.model.get(*h)).ok_or("panel sketch is missing")?;
+        (handle, first.common.clone())
+    };
+    if let Some(index) = depth_parameters.first() {
+        drawing.parametric.parameters.get_mut(*index).ok_or("depth parameter disappeared")?.expr = depth.to_string();
+    } else {
+        drawing.parametric.parameters.push(Parameter {
+            name: "depth".into(),
+            expr: depth.to_string(),
+            description: "Panel depth in millimetres".into(),
+        });
+    }
+    let mesh = PolyfaceMesh { vertices: vertices(w, h, depth), faces: FACES.to_vec() };
+    drawing.model.push(Entity { handle, common, kind: EntityKind::PolyfaceMesh(mesh) });
+    super::validate(&drawing)?;
+    let document = serde_json::to_value(&drawing)?;
+    let cold: Drawing = serde_json::from_value(document.clone())?;
+    if cold != drawing || serde_json::to_value(&cold)? != document {
+        return Err("native solid changed during cold serialization".into());
+    }
+    let report = json!({"schema_version":1,"document":document,"mesh_handle":handle,
+        "dimensions_mm":[w,h,depth],"volume_mm3":w*h*depth,"surface_area_mm2":2.0*(w*h+w*depth+h*depth),
+        "vertices":8,"faces":6,"representation":"closed-polyface-panel","complete_native_cold_equal":true,
+        "brep_qualified":false,"general_manufacturing_qualified":false});
+    super::write(output, &serde_json::to_vec(&report)?)
+}
+
+fn panel_dimensions(mesh: &PolyfaceMesh) -> Result<[f64; 3]> {
+    if mesh.vertices.len() != 8 || mesh.faces != FACES {
+        return Err("mesh is not the closed panel topology".into());
+    }
+    let corner = mesh.vertices.get(6).ok_or("panel opposite corner missing")?;
+    let [w, h, d] = [dimension(corner.x)?, dimension(corner.y)?, dimension(corner.z)?];
+    // Geometry must match the exact authored panel; do not silently normalize it.
+    if mesh.vertices != vertices(w, h, d) {
+        return Err("panel mesh coordinates differ from its closed rectangular geometry".into());
+    }
+    Ok([w, h, d])
+}
+
+pub fn export(input: &str, selector: &str, output: &str) -> Result<()> {
+    let drawing = super::model(input)?;
+    if !matches!(drawing.header.get("INSUNITS"), Some(HVal::Int(4))) {
+        return Err("panel mesh export requires millimetres".into());
+    }
+    handles(&drawing)?;
+    let handle = Handle(selector.parse::<u64>()?);
+    let entity = drawing.model.get(handle).ok_or("mesh export handle is absent")?;
+    let EntityKind::PolyfaceMesh(mesh) = &entity.kind else {
+        return Err("mesh export requires a polyface panel".into());
+    };
+    panel_dimensions(mesh)?;
+    let mut text = format!("# Dobe panel mesh; coordinates in millimetres\no panel_{}\n", handle.0);
+    for vertex in &mesh.vertices {
+        writeln!(text, "v {} {} {}", vertex.x, vertex.y, vertex.z)?;
+    }
+    for face in &mesh.faces {
+        let [a, b, c, d] = face;
+        writeln!(text, "f {a} {b} {c} {d}")?;
+    }
+    super::write(output, text.as_bytes())
+}
diff --git a/apps/cadcraft-cli/src/dobe_solve.rs b/apps/cadcraft-cli/src/dobe_solve.rs
