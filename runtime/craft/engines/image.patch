diff --git a/crates/engine/src/cmd/type_cmds/font_diagnostics.rs b/crates/engine/src/cmd/type_cmds/font_diagnostics.rs
new file mode 100644
index 000000000..bf77c5f77
--- /dev/null
+++ b/crates/engine/src/cmd/type_cmds/font_diagnostics.rs
@@ -0,0 +1,91 @@
+//! Opt-in evidence of the font instances actually used by the shaper.
+//! A family existing in the font list does not prove it supplies every shaped glyph.
+//! These records identify font bytes, collection index and variation coordinates. They
+//! do not assert that every source character paints a glyph (controls need not do so).
+
+use photocraft_text::layout::TextLayout;
+use serde_json::{Value, json};
+use std::sync::LazyLock;
+
+use super::{Result, bad};
+
+const MAX_GLYPHS: usize = 65_536;
+const MAX_FACES: usize = 256;
+const MAX_STYLES: usize = 4_096;
+const MAX_TEXT_BYTES: usize = 1_048_576;
+const MAX_FONT_BYTES: usize = 256 * 1_048_576;
+
+static BUNDLED_FONTS: LazyLock<Value> = LazyLock::new(|| {
+    json!(photocraft_text::fonts::BUNDLED.iter().map(|(name, bytes)| {
+        json!({"name": name, "fontBlake3": blake3::hash(bytes).to_hex().as_str(), "collectionIndex": 0})
+    }).collect::<Vec<_>>())
+});
+
+pub(super) fn describe(text: &str, layout: &TextLayout) -> Result<Value> {
+    // Refuse incomplete diagnostics rather than silently truncating evidence used to
+    // decide whether an editable project can reopen with the same typography.
+    if text.len() > MAX_TEXT_BYTES || layout.glyphs.len() > MAX_GLYPHS || layout.faces.len() > MAX_FACES || layout.styles.len() > MAX_STYLES {
+        return Err(bad("type.info", "font diagnostics exceed bounded output limits"));
+    }
+    if layout.glyph_ranges.len() != layout.glyphs.len() {
+        return Err(bad("type.info", "font diagnostics have inconsistent glyph ranges"));
+    }
+    let mut byte_budget = MAX_FONT_BYTES;
+    let mut faces = Vec::with_capacity(layout.faces.len());
+    for (index, face) in layout.faces.iter().enumerate() {
+        let data: &[u8] = face.font.data.as_ref();
+        byte_budget = byte_budget.checked_sub(data.len()).ok_or_else(|| bad("type.info", "font diagnostics exceed font byte budget"))?;
+        if face.coords.len() > 64 || !face.size_px.is_finite() || !face.skew_deg.is_finite() {
+            return Err(bad("type.info", "font diagnostics have invalid face parameters"));
+        }
+        faces.push(json!({
+            "face": index,
+            "fontBlake3": blake3::hash(data).to_hex().as_str(),
+            "fontBytes": data.len(),
+            "collectionIndex": face.font.index,
+            "variationCoordsF2Dot14": face.coords,
+            "sizePx": face.size_px,
+            "syntheticBold": face.embolden,
+            "syntheticSkewDegrees": face.skew_deg,
+        }));
+    }
+    let mut glyphs = Vec::with_capacity(layout.glyphs.len());
+    let mut missing = 0;
+    for (glyph, range) in layout.glyphs.iter().zip(&layout.glyph_ranges) {
+        if layout.faces.get(glyph.face as usize).is_none()
+            || layout.styles.get(glyph.style as usize).is_none()
+            || text.get(range.clone()).is_none()
+            || !glyph.x.is_finite()
+            || !glyph.y.is_finite()
+        {
+            return Err(bad("type.info", "font diagnostics have invalid glyph references"));
+        }
+        if glyph.id == 0 {
+            missing += 1;
+        }
+        glyphs.push(json!({
+            "face": glyph.face, "glyphId": glyph.id, "style": glyph.style,
+            "sourceByteStart": range.start, "sourceByteEnd": range.end,
+            "x": glyph.x, "y": glyph.y,
+        }));
+    }
+    Ok(json!({
+        "schema": 1, "scope": "shaped-glyphs", "rangeUnit": "utf8-bytes",
+        "sourceBytes": text.len(), "faces": faces, "glyphs": glyphs,
+        "resolvedStyles": layout.styles, "missingGlyphCount": missing,
+        "bundledFonts": &*BUNDLED_FONTS,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bounded_output_rejects_incomplete_evidence() {
+        let mut layout = TextLayout::default();
+        assert!(describe(&"a".repeat(MAX_TEXT_BYTES + 1), &layout).is_err());
+        layout.glyph_ranges.push(0..0);
+        assert!(describe("", &layout).is_err());
+    }
+}
