+#[test]
+fn font_diagnostics_are_opt_in_and_identify_actual_shaped_faces() {
+    let mut s = session();
+    let text = "Office café e\u{301}";
+    let id = s.execute("type.create", json!({"text": text, "font": "Inter", "size": 12})).unwrap()["layer"].as_u64().unwrap();
+    let before = text_layer(&s, id);
+    let plain = s.execute("type.info", json!({"layer": id})).unwrap();
+    assert!(plain.get("fontDiagnostics").is_none());
+    assert!(s.execute("type.info", json!({"layer": id, "fontDiagnostics": "true"})).is_err());
+    let mut inspected = s.execute("type.info", json!({"layer": id, "fontDiagnostics": true})).unwrap();
+    let diagnostics = inspected.as_object_mut().unwrap().remove("fontDiagnostics").unwrap();
+    assert_eq!(plain, inspected, "inspection preserves the existing response");
+    assert_eq!(text_layer(&s, id).text, before.text);
+    assert_eq!(text_layer(&s, id).runs, before.runs);
+    assert_eq!(diagnostics["missingGlyphCount"], 0);
+    let expected = blake3::hash(&photocraft_text::fonts::INTER_REGULAR).to_hex().to_string();
+    let faces = diagnostics["faces"].as_array().unwrap();
+    assert!(!faces.is_empty());
+    assert!(faces.iter().all(|face| face["fontBlake3"] == expected));
+    let glyphs = diagnostics["glyphs"].as_array().unwrap();
+    assert!(!glyphs.is_empty());
+    for glyph in glyphs {
+        let start = glyph["sourceByteStart"].as_u64().unwrap() as usize;
+        let end = glyph["sourceByteEnd"].as_u64().unwrap() as usize;
+        assert!(text.get(start..end).is_some(), "source ranges use UTF-8 bytes");
+        assert!(faces.get(glyph["face"].as_u64().unwrap() as usize).is_some());
+        assert!(diagnostics["resolvedStyles"].as_array().unwrap().get(glyph["style"].as_u64().unwrap() as usize).is_some());
+    }
+}
