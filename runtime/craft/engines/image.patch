+#[test]
+fn font_diagnostics_report_missing_glyphs_and_reject_invalid_ranges() {
+    let t = TextLayer { text: "\u{10ffff}".into(), ..Default::default() };
+    let mut layout = photocraft_text::shared().lock().unwrap_or_else(|e| e.into_inner()).layout(&t, 72.0);
+    let diagnostics = font_diagnostics::describe(&t.text, &layout).unwrap();
+    assert!(diagnostics["missingGlyphCount"].as_u64().unwrap() > 0);
+    layout.glyph_ranges[0] = 1..2;
+    assert!(font_diagnostics::describe(&t.text, &layout).is_err());
+    layout.glyph_ranges[0] = 0..t.text.len();
+    layout.glyphs[0].face = u32::MAX;
+    assert!(font_diagnostics::describe(&t.text, &layout).is_err());
+}
